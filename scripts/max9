#!/usr/bin/env bash
# Max 9 launcher for the patched Wine stack: same runtime and prefix as
# ableton-live, so standalone Max, Max for Live editing and PipeASIO all
# share one wineserver. Args: Max documents as unix paths, or c74max: URLs.
# Overrides: ABLETON_WINE_ROOT, ABLETON_WINEPREFIX, ABLETON_RT=off,
#            ABLETON_POWER=off (skip the session performance power-profile hold),
#            ABLETON_LINKD=/path/to/ableton-linkd (Ableton Link session anchor).
set -u
# Runtime and prefix paths resolve in one place; see scripts/runtime-env.sh.
for _l in "$(dirname "$0")/runtime-env.sh" "$HOME/.local/share/ableton-wine/runtime-env.sh"; do
    [ -r "$_l" ] && . "$_l" && break
done
command -v ableton_wine_root >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found next to $0 or in ~/.local/share/ableton-wine" >&2; exit 1; }
ableton_bind_runtime
# Disable Wine debug logging; fixme spam from the D3D poll loop stalls Live's UI thread.
# Keep the winediag channel on: it carries only rare one-line notices that a
# person should read, such as the present-fallback warning from patch 0071.
export WINEDEBUG="${WINEDEBUG:--all,+winediag}"
export WINE_D3D_CONFIG="${WINE_D3D_CONFIG:-csmt=0x1}"
export WINE_DISABLE_UNIX_MOUNT_REPARSE="${WINE_DISABLE_UNIX_MOUNT_REPARSE:-1}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}mscoree,mshtml="

MAX_EXE="C:\\Program Files\\Cycling '74\\Max 9\\Max.exe"
MAX_UNIX="$WINEPREFIX/drive_c/Program Files/Cycling '74/Max 9/Max.exe"
if [ ! -f "$MAX_UNIX" ]; then
    echo "max9: no Max 9 installation in $WINEPREFIX" >&2
    exit 1
fi

run=(wine)
# Same realtime probe as the ableton-live launcher.
if [ "${ABLETON_RT:-on}" != off ] && command -v chrt >/dev/null 2>&1 \
    && chrt -r 10 true >/dev/null 2>&1; then
    run=(chrt -r 10 wine)
fi

# Same session-scoped performance power-profile hold as the ableton-live
# launcher; released when Max exits. The timeout bounds a wedged daemon:
# powerprofilesctl waits on GLib's 25 s D-Bus default per call, and the hold
# call would wait a second time.
if [ "${ABLETON_POWER:-on}" != off ] && command -v powerprofilesctl >/dev/null 2>&1 \
    && timeout 10 powerprofilesctl launch -p performance -r "Max session" -i max9 -- true >/dev/null 2>&1; then
    run=(powerprofilesctl launch -p performance -r "Max session" -i max9 -- "${run[@]}")
fi

# Unix file paths become Windows paths; URLs and anything else pass through.
args=()
for a in "$@"; do
    if [ -f "$a" ]; then
        w="$(winepath -w "$a" 2>/dev/null || true)"
        [ -n "$w" ] && a="$w"
    fi
    args+=("$a")
done

# Ableton Link session anchor (optional): same auto-start as the ableton-live
# launcher. Start ableton-linkd if installed but not running, so the Link
# session is anchored before Max launches. ABLETON_LINKD overrides the path.
LINKD="${ABLETON_LINKD:-$HOME/.local/share/ableton-wine/ableton-linkd}"
if [ -x "$LINKD" ] && ! pgrep -x ableton-linkd >/dev/null 2>&1; then
    "$LINKD" --daemon || echo "max9: ableton-linkd failed to start" >&2
fi

exec "${run[@]}" "$MAX_EXE" ${args[@]+"${args[@]}"}
