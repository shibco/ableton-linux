#!/usr/bin/env bash
# Ableton Live launcher for the patched Wine stack. Runs whichever Live edition
# (Intro/Lite/Standard/Suite/Trial, any major version) is installed in the prefix.
ENV_VAR_HELP=$(
cat <<'END_HEREDOC'
ableton-linux reads these environment variables at launch

ABLETON-LIVE VARIABLES:
    ABLETON_WINE_ROOT=/usr
        run Live under the Wine installed at this root; /usr selects
        the distribution's stock Wine; the default is the patched
        runtime under ~/.local/opt

    ABLETON_WINEPREFIX=/path
        run Live from this Wine prefix; default ~/.wine-ableton

    ABLETON_VDESK=2560x1600
        run Live inside a Wine virtual desktop of this size; unset by
        default, so Live gets a native window

    ABLETON_LIVE_EXE=/path/into/prefix/.../Ableton Live NN Edition.exe
        launch exactly this Live executable; required when more than
        one edition is installed in the prefix

    ABLETON_LIVE_VERSION=11|12
        only look for installs of this major version

    ABLETON_RT=off
        skip the realtime probe and run Live under normal scheduling;
        by default the launcher runs Live under SCHED_RR wherever
        realtime rights exist

    ABLETON_MAX_AUDIO_THREADS=auto|off|<number>
        Choose how many audio workers Live 12 uses. Audio workers divide
        Set processing among CPU cores. The default, auto, chooses the
        greater of the physical core count and half of Live's own count.
        Live's own count remains the upper limit. The launcher saves the
        count before Live starts. A user edit takes priority.
        Set auto explicitly to calculate a launcher count again.
        Use off to remove the launcher's saved count. Live then chooses.
        A user edit keeps priority. Fewer workers reduce wake-ups.
        A demanding Set can work better with a higher count or off.
        Check auto after you move the prefix to another computer.

    ABLETON_POWER=off
        skip the performance power-profile hold for this launch; by
        default the launcher holds the "performance" profile while
        Live runs and releases it on exit

    ABLETON_SHORTCUTS=take|preserve
        GNOME only: hold the desktop shortcuts that shadow Live
        bindings (Ctrl+Alt+Up/Down, and Ctrl+Alt+Delete on Live 11)
        while Live runs; they restore when Live exits; default take;
        preserve leaves the desktop shortcuts unchanged

    ABLETON_LAUNCH_TIMEOUT=90
        seconds the launcher waits for Live to appear in the prefix
        before it reports a failed launch; 5 to 600

    ABLETON_WINEBOOT_TIMEOUT=60
        seconds allowed for the prefix cold boot before launch

    ABLETON_DPI_MODE=100|fractional|dpi<N>|preserve
        override the per-launch DPI recalibration; the default, auto,
        matches the detected desktop scale; preserve keeps the
        prefix's current values

    ABLETON_THEME_MODE=auto|dark|light|preserve
        pin the light or dark scheme Live's "Follow system" theme
        sees; the default, auto, mirrors the desktop scheme; preserve
        touches nothing

    ABLETON_TOPBAR_MODE=live|system|preserve|'#RRGGBB #RRGGBB'
        colour Live's window chrome; the default, live, follows
        Live's active theme, system follows the desktop, a hex pair
        sets bar and text colours, preserve touches nothing

    ABLETON_TEXT_SMOOTHING=subpixel|grayscale|preserve
        text antialiasing written into the prefix before launch;
        default subpixel

    ABLETON_UI_FONT=auto|preserve|off|<family>
        the font Live's dialogs and window chrome use; preserve
        touches nothing, off restores Wine's stock font; default auto

    ABLETON_DCOMP=off
        disable DirectComposition for one launch; exists for A/B runs
        against the Learn View flicker fix

    ABLETON_LINK_MODE=off|session|always
        whether the launcher starts the Ableton Link session anchor;
        new installations save session; otherwise the launcher follows
        the saved policy, with off as the unconfigured compatibility fallback

    ABLETON_LINKD=/path/to/ableton-linkd
        start this binary as the Ableton Link session anchor instead
        of the installed one

    ABLETON_LINKD_LINGER=900
        seconds the Link anchor stays alive with no peers before it
        exits; 0 keeps it running

AUDIO VARIABLES:
    PIPEASIO_PREFERRED_BUFFERSIZE=512
        audio buffer size for one launch; raise it if audio crackles;
        ~/.config/pipeasio/config.ini holds the persistent settings

RUNTIME VARIABLES:
    WINE_X11_FORCE_OFFSCREEN_CLASS=off
        disable the Max for Live selection-flicker fix

    WINE_WIN32_FULLSCREEN_CLASS=off
        disable Live fullscreen normalisation

    WINE_WIN32_RESIZABLE_CLASS=off
        disable the monitor-sized resizability fix

    WINE_D3D_FORCE_GPU_RENDERING=1
        offer Live's GPU renderer on Intel models its list refuses;
        the device name Live shows discloses the substitution

    The pointer variables below override the saved pointer setting
    for one launch; the launcher exports none of them, and registry
    values hold the persistent settings. Values ignore letter case;
    off and 0 mean disabled. Details:
    notes/ABLETON-WINE-POINTER-GESTURES.md.

    WINE_X11_SMOOTH_SCROLLING=disabled|precise|notched
        fine scrolling; precise keeps fractional wheel motion, notched
        rounds it to whole steps, disabled restores stock scrolling;
        default precise

    WINE_X11_PINCH_ZOOM=disabled|legacy-wheel
        pinch zoom; legacy-wheel turns a touchpad pinch into zoom,
        disabled ignores pinches; default legacy-wheel

    WINE_X11_MIDDLE_DRAG=disabled|navigate|navigate-notched
        middle-button drag navigation that moves content with the
        pointer; default navigate

    WINE_X11_TOUCHPAD_INERTIA=disabled|auto|enabled
        scrolling keeps moving after a quick release; disabled stops
        scrolling with the input; auto currently behaves like
        disabled on X11; default enabled

    WINE_X11_MIDDLE_DRAG_THROW=disabled|enabled
        content keeps moving after you release a moving middle-button
        drag; disabled stops it at release; default enabled

    WINE_X11_WHEEL_WHILE_BUTTON_HELD=disabled|enabled
        the mouse wheel keeps working while another button is held,
        except during middle-button navigation; default enabled

    WINE_X11_INERTIA_CURVE=exponential|linear
        how continued movement slows down; default exponential

    WINE_X11_INERTIA_RATE=0.5..16.0
        how quickly continued movement stops; lower values keep it
        going longer; default 4.0

    WINE_X11_WARP_EMULATION=disabled|auto|enabled
        XWayland correction for fader and knob drags; auto engages
        only after Wine sees failed pointer warps; default auto

    WINE_X11_POINTER_FEATURES=disabled
        master switch: turns every pointer feature above off and
        restores stock pointer behaviour
END_HEREDOC
)
set -u

version() {
    versionfile="${XDG_DATA_HOME:-$HOME/.local/share}/ableton-wine/VERSION"
    # Packaged installs (nix) stage it under the runtime root instead of $HOME.
    # This runs before the configuration helper loads, so it reads the variable
    # the launch shim exports rather than the resolved $WINE_ROOT.
    [ -f "$versionfile" ] \
        || versionfile="${ABLETON_WINE_ROOT:-}/share/ableton-wine/VERSION"
    if [ -f "$versionfile" ]; then
        cat "$versionfile"
    else
        echo "version file \"$versionfile\" not found" >&2
        exit 1
    fi
}

env_var_help() {
    echo "$ENV_VAR_HELP"
}

usage() {
    cat <<EOF
ableton-linux $(version)

USAGE: $0 [options] [SET]

OPTIONS:
-h  --help       show help
-c  --config     show config environment variable help
-V  --version    print ableton-linux version
EOF
}

end_of_args_reached=false
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    if [[ $end_of_args_reached == true ]]; then
        POSITIONAL+=("$1")
        shift
        continue
    fi
    case $key in
        -h|--help)
            usage
            exit 0
            ;;
        -c|--config)
            env_var_help
            exit 0
            ;;
        -V|--version)
            version
            exit 0
            ;;
        --)
            end_of_args_reached=true
            shift
            ;;
        *)
            if [[ $1 =~ ^-.* ]]; then
                echo "unknown flag: $1" >&2
                usage
                exit 1
            else
                POSITIONAL+=("$1")
            fi
            shift
            ;;
    esac
done
# set $@ back to what it was so launch code works as it did before
set -- "${POSITIONAL[@]}"

# Immutable preflight.  Nothing above the success boundary below creates a
# directory, boots Wine, writes registry state, repairs MIME handlers, or starts
# a helper.  A runtime-only installation therefore fails cleanly when Live is
# absent.
launcher_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for config_lib in "$launcher_here/lib/config.sh" \
                  "${XDG_DATA_HOME:-$HOME/.local/share}/ableton-wine/lib/config.sh"; do
    if [ -r "$config_lib" ]; then . "$config_lib"; break; fi
done
declare -F ableton_config_init >/dev/null 2>&1 || { echo "ableton-live: configuration helper is missing" >&2; exit 1; }
ableton_config_init
for lifecycle_lib in "$launcher_here/lib/lifecycle.sh" "$ABLETON_DATA_HOME/lib/lifecycle.sh"; do
    if [ -r "$lifecycle_lib" ]; then . "$lifecycle_lib"; break; fi
done
declare -F ableton_live_running >/dev/null 2>&1 || { echo "ableton-live: lifecycle helper is missing" >&2; exit 1; }
for live_options_lib in "$launcher_here/lib/live-options.sh" "$ABLETON_DATA_HOME/lib/live-options.sh"; do
    if [ -r "$live_options_lib" ]; then . "$live_options_lib"; break; fi
done
for live_options_function in ableton_available_physical_cores \
                             ableton_live_product_version \
                             ableton_seed_max_audio_threads; do
    declare -F "$live_options_function" >/dev/null 2>&1 || {
        echo "ableton-live: live-options.sh helper is missing or incomplete" >&2
        exit 1
    }
done

# Live exits cleanly; WebView2's updater does not, and one wedged agent keeps the
# wineserver alive for the whole login session.
# The trap sits below the guards, and the gate is what makes that sufficient: the
# refusals are spread through the launcher rather than gathered above one line,
# and the one that matters most - the bring-up lock held by a sibling launcher -
# is among the last of them.  A refusal must not reach into a prefix another
# session is already using.
session_started=""
session_teardown()
{
    local rc=$?
    [ -n "$session_started" ] || return "$rc"
    ABLETON_SESSION_LABEL="Ableton Live" ableton_session_teardown || true
    return "$rc"
}

WINE_ROOT="$ABLETON_WINE_ROOT"
export WINEPREFIX="$ABLETON_WINEPREFIX"
[ -x "$WINE_ROOT/bin/wine" ] || { echo "ableton-live: Wine runtime is missing at $WINE_ROOT" >&2; exit 1; }
[ -x "$WINE_ROOT/bin/wineserver" ] || { echo "ableton-live: wineserver is missing at $WINE_ROOT" >&2; exit 1; }
[ -f "$WINEPREFIX/system.reg" ] || { echo "ableton-live: Wine prefix is missing or incomplete at $WINEPREFIX" >&2; exit 1; }
case "${ABLETON_LIVE_VERSION:-}" in ''|11|12) ;;
    *) echo "ableton-live: ABLETON_LIVE_VERSION must be 11 or 12" >&2; exit 2 ;;
esac
max_audio_threads_request="${ABLETON_MAX_AUDIO_THREADS:-auto}"
max_audio_threads_replace_seeded=1
[ -n "${ABLETON_MAX_AUDIO_THREADS+x}" ] || max_audio_threads_replace_seeded=0
max_audio_threads_restore_at_default=0
max_audio_threads_action=1
case "$max_audio_threads_request" in
    auto)
        [ "$max_audio_threads_replace_seeded" -eq 0 ] \
            || max_audio_threads_restore_at_default=1
        if declare -F ableton_available_physical_cores >/dev/null 2>&1 \
           && declare -F ableton_reliable_audio_threads >/dev/null 2>&1 \
           && physical_audio_cores="$(ableton_available_physical_cores)" \
           && max_audio_threads="$(ableton_reliable_audio_threads "$physical_audio_cores")"; then
            :
        else
            audio_report="$launcher_here/audio-report.sh"
            [ -x "$audio_report" ] || audio_report="$ABLETON_DATA_HOME/audio-report.sh"
            printf 'ableton-live: Live will select its audio thread count. Run %q to review the CPU details.\n' "$audio_report" >&2
            max_audio_threads=off
            max_audio_threads_action=0
        fi ;;
    off|[1-9]|[1-5][0-9]|6[0-3]) max_audio_threads="$max_audio_threads_request" ;;
    *) echo "ableton-live: Set ABLETON_MAX_AUDIO_THREADS to auto, off, or a number from one to 63." >&2; exit 2 ;;
esac
shortcuts_mode="${ABLETON_SHORTCUTS:-take}"
case "$shortcuts_mode" in
    take|preserve) ;;
    *) echo "ableton-live: Set ABLETON_SHORTCUTS to take or preserve." >&2; exit 2 ;;
esac
ABLETON_SHORTCUTS="$shortcuts_mode"

# Armed after the guards: teardown ends this prefix's agents, and a launch that
# refused to start has no session to end - the prefix may hold someone else's.
trap session_teardown EXIT

find_live_exe()
{
    local major="${1:-}" f
    if [ -n "${ABLETON_LIVE_EXE:-}" ]; then
        [ -f "$ABLETON_LIVE_EXE" ] || {
            echo "ableton-live: ABLETON_LIVE_EXE does not name a file: $ABLETON_LIVE_EXE" >&2
            return 2
        }
        readlink -f -- "$ABLETON_LIVE_EXE"
        return
    fi
    if [ -n "$major" ]; then
        for f in "$WINEPREFIX"/drive_c/ProgramData/Ableton/*/Program/"Ableton Live $major "*.exe; do
            [ -f "$f" ] && printf '%s\n' "$f"
        done | sort -V
    else
        for f in "$WINEPREFIX"/drive_c/ProgramData/Ableton/*/Program/"Ableton Live"*.exe; do
            [ -f "$f" ] && printf '%s\n' "$f"
        done | sort -V
    fi
}
# Protocol and licence callbacks belong to the prefix registry.  They do not
# need launcher-side Live discovery, and discovery must not block them when a
# prefix contains more than one edition of the same major version.
callback_kind=""
if [ "$#" -eq 1 ]; then
    case "$1" in
        [aA][bB][lL][eE][tT][oO][nN]:*) callback_kind=protocol ;;
        *.[aA][uU][zZ]) [ -f "$1" ] && callback_kind=auz ;;
    esac
fi

live_candidates=()
live_exe_unix=""
live_count=0
exe_base=""
EXE=""
if [ -z "$callback_kind" ]; then
    mapfile -t live_candidates < <(find_live_exe "${ABLETON_LIVE_VERSION:-}") || exit $?
    [ "${#live_candidates[@]}" -gt 0 ] || {
        echo "ableton-live: no Ableton Live installation found in $WINEPREFIX" >&2
        exit 1
    }
    live_exe_unix="${live_candidates[-1]}"
    live_count="${#live_candidates[@]}"
    exe_base="$(basename "$live_exe_unix")"
    if [ "$live_count" -gt 1 ] && [ -z "${ABLETON_LIVE_EXE:-}" ]; then
        live_majors="$(printf '%s\n' "${live_candidates[@]}" | while IFS= read -r f; do basename "$f"; done | awk '{print $3}' | sort -u | paste -sd' ' -)"
        if [ "$(printf '%s' "$live_majors" | wc -w)" -eq 1 ]; then
            echo "ableton-live: multiple Live $live_majors editions are installed; set ABLETON_LIVE_EXE explicitly:" >&2
            printf 'ableton-live:   %s\n' "${live_candidates[@]}" >&2
            exit 1
        fi
    fi
    rel="${live_exe_unix#"$WINEPREFIX/drive_c/"}"
    if [ "$rel" != "$live_exe_unix" ]; then EXE="C:\\${rel//\//\\}"; else EXE="$live_exe_unix"; fi
fi

caller_winedlloverrides="${WINEDLLOVERRIDES:-}"

# Keep diagnostics from the current launch at one stable path. Tee preserves
# terminal output while also covering desktop launchers whose stderr is
# otherwise inherited from the desktop environment (and may be /dev/null).
# ">>" creates the file and proves it writable without discarding anything.
diagnostic_dir="$ABLETON_STATE_HOME/logs"
if ableton_mark_state_home && mkdir -p -- "$diagnostic_dir" && : >> "$diagnostic_dir/live.log"; then
    # Rotate to a fresh log only when this launcher is the one bringing Live up. Every
    # Live desktop entry - .als, .auz, ableton:// - runs this same script to hand
    # its argument to the running instance, so truncating unconditionally would
    # wipe the running session's diagnostics, including the patch 0071 present
    # fallback warning that lands about two seconds into a faulted session. Same
    # already-running test as the single-instance guard below. Rotation preserves
    # the previous session when a later guard refuses this launch.
    ableton_live_running || mv -f -- "$diagnostic_dir/live.log" "$diagnostic_dir/live.log.1"
    exec 2> >(tee -a "$diagnostic_dir/live.log" >&2)
else
    echo "ableton-live: cannot write diagnostics to $diagnostic_dir/live.log" >&2
fi

# Clear inherited Wine variables so this launch uses only the patched build.
unset WINELOADER WINEDLLPATH WINEDLLOVERRIDES WINEARCH
export PATH="$WINE_ROOT/bin:$PATH"
# Disable Wine debug logging; fixme spam from the D3D poll loop stalls Live's UI thread.
# Keep the winediag channel on: it carries only rare one-line notices that a
# person should read, such as the present-fallback warning from patch 0071.
export WINEDEBUG="${WINEDEBUG:--all,+winediag}"
export WINE_D3D_CONFIG="${WINE_D3D_CONFIG:-csmt=0x1}"
export WINED3D_DCOMP_FORCE_FULL_REDRAW="${WINED3D_DCOMP_FORCE_FULL_REDRAW:-1}"
# M4L child visibility otherwise makes winex11 detach and reattach Live's whole
# client surface. Keep Live on the offscreen path; "off" is a non-matching class
# value and therefore provides a one-launch A/B override.
export WINE_X11_FORCE_OFFSCREEN_CLASS="${WINE_X11_FORCE_OFFSCREEN_CLASS:-Ableton Live Window Class}"
# Live leaves its native menu attached in fullscreen, and a redundant X11
# configure can otherwise delay fullscreen removal on exit. Select only Live's
# exact top-level class; "off" is a non-matching one-launch A/B override.
export WINE_WIN32_FULLSCREEN_CLASS="${WINE_WIN32_FULLSCREEN_CLASS:-Ableton Live Window Class}"
# A captioned Live window may legitimately cover its monitor. Keep that window
# resizable independently of the fullscreen normalization selector above;
# "off" is a non-matching one-launch A/B override.
export WINE_WIN32_RESIZABLE_CLASS="${WINE_WIN32_RESIZABLE_CLASS:-Ableton Live Window Class}"
# Report host mount points as plain dirs (patch 0033); Live's browser treats
# junctions without reparse data as unresolvable and skips them.
export WINE_DISABLE_UNIX_MOUNT_REPARSE="${WINE_DISABLE_UNIX_MOUNT_REPARSE:-1}"
export WINESERVER="$WINE_ROOT/bin/wineserver"

# Keep Wine's Mono/.NET and HTML-help hooks out of Live: nothing in the
# stack loads them. winemenubuilder.exe is deliberately absent here: setup-prefix.sh
# already disables it registry-side, and that form stays canonical.
export WINEDLLOVERRIDES="${caller_winedlloverrides:+$caller_winedlloverrides;}mscoree,mshtml="
# Opt-in A/B against the Learn View flicker fix:
# ABLETON_DCOMP=off disables DirectComposition outright. Off contradicts the d2d1-dcomp
# stack this runtime ships (WINED3D_DCOMP_FORCE_FULL_REDRAW above), so it is no default.
if [ "${ABLETON_DCOMP:-on}" = "off" ]; then
    export WINEDLLOVERRIDES="$WINEDLLOVERRIDES;dcomp="
fi
# Live 12's Learn View is a WebView2 (Chromium) embed; force the SwiftShader software
# path, which renders where GPU compositing under Wine does not. --no-sandbox is
# mandatory: nothing under Wine can sandbox the renderer. User-supplied flags come first.
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="${WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS:+$WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS }--use-gl=angle --use-angle=swiftshader --disable-gpu-compositing --disable-gpu-rasterization --disable-direct-composition --disable-features=ForceSWDCompWhenDCompFallbackRequired --edge-webview-foreground-boost-opt-out --no-sandbox"

# The runtime link: any path this launcher writes into user configuration has to
# be stable and user-owned, never $WINE_ROOT itself, which on a Nix install is a
# store path that a garbage collection can delete and that every upgrade
# renames. Resolved (and on Nix registered as a GC root) on every launch, so an
# upgrade re-points it without the user re-running a setup step. Only the Nix
# package ships the library, so on a .run install it is absent, the value stays
# empty, and the repair below copies the staged entry verbatim as it always
# has.
RUNTIME_LINK=""
runtime_lib="$WINE_ROOT/share/ableton-wine/scripts/runtime-link.sh"
if [ -r "$runtime_lib" ]; then
    . "$runtime_lib"
    RUNTIME_LINK="$(ableton_runtime_link "$WINE_ROOT")" || RUNTIME_LINK=""
fi

# Reinstate the project-owned authorisation handlers and pin their defaults on
# every launch.  The reverse-DNS desktop IDs cannot collide with Wine's global
# wine-protocol-*.desktop exports.  install.sh stages authoritative copies so a
# missing or changed entry can be repaired before the next browser round trip.
repair_handler_entries() {
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local staged id type current want tmp rewrite wrote i repaired=0
    local -a ids=("$ABLETON_PROTOCOL_DESKTOP_ID" "$ABLETON_AUZ_DESKTOP_ID")
    local -a types=(x-scheme-handler/ableton application/x-wine-extension-auz)
    for id in "${ids[@]}"; do
        staged="$ABLETON_DATA_HOME/$id"
        # Packaged installs (nix) stage them under the runtime root instead of $HOME.
        [ -f "$staged" ] || staged="$WINE_ROOT/share/ableton-wine/$id"
        if [ ! -f "$staged" ]; then
            echo "ableton-live: cannot repair $id: staged handler is missing at $staged" >&2
            continue
        fi
        # An entry that is a symlink into the store is owned by nix or
        # home-manager: it is read-only, rewriting it fails, and the declaration
        # that produced it would put it back anyway. Repairing it every launch
        # would only print two failures each time.
        case "$(readlink -- "$apps/$id" 2>/dev/null)" in
            /nix/store/*) continue ;;
        esac
        # A packaged install's staged copy names the runtime root, which on Nix
        # is a store path; record the stable link instead, so neither an upgrade
        # nor a garbage collection can strand the entry. A tarball entry routes
        # through $ABLETON_BIN_HOME and contains no runtime root at all, so
        # there is nothing to rewrite and the file is copied verbatim, as
        # before - which keeps it byte-identical to the digest install.sh
        # recorded for it.
        want="$(cat -- "$staged")"
        rewrite=0
        if [ -n "$RUNTIME_LINK" ] && [ "${want#*"$WINE_ROOT"/}" != "$want" ]; then
            want="${want//"$WINE_ROOT"\//$RUNTIME_LINK/}"
            rewrite=1
        fi
        if [ "$rewrite" -eq 1 ]; then
            [ "$want" = "$(cat -- "$apps/$id" 2>/dev/null)" ] && continue
        else
            cmp -s -- "$staged" "$apps/$id" && continue
        fi
        echo "ableton-live: reinstating project handler $id" >&2
        tmp="$apps/.$id.$$"
        if ! mkdir -p -- "$apps"; then
            echo "ableton-live: failed to install $apps/$id" >&2
            continue
        fi
        # wrote, not an emptied $tmp: clearing the variable loses the path and
        # leaves the partial file in place, once per launch with a new pid.
        wrote=1
        if [ "$rewrite" -eq 1 ]; then
            printf '%s\n' "$want" > "$tmp" || wrote=0
        else
            cp -- "$staged" "$tmp" || wrote=0
        fi
        if [ "$wrote" -eq 0 ] || ! mv -f -- "$tmp" "$apps/$id"; then
            rm -f -- "$tmp"
            echo "ableton-live: failed to install $apps/$id" >&2
            continue
        fi
        repaired=1
    done
    if [ "$repaired" -eq 1 ]; then
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database "$apps" || \
                echo "ableton-live: failed to refresh the desktop application database at $apps" >&2
        else
            echo "ableton-live: update-desktop-database is unavailable; repaired handlers may not be visible yet" >&2
        fi
    fi
    if ! command -v xdg-mime >/dev/null 2>&1; then
        echo "ableton-live: xdg-mime is unavailable; cannot verify the Ableton callback defaults" >&2
        return 0
    fi
    for ((i=0; i<${#ids[@]}; i++)); do
        id="${ids[i]}"; type="${types[i]}"
        if ! xdg-mime default "$id" "$type"; then
            echo "ableton-live: failed to set $type to $id" >&2
            continue
        fi
        current="$(xdg-mime query default "$type" 2>/dev/null || true)"
        if [ "$current" != "$id" ]; then
            echo "ableton-live: $type still resolves to '${current:-no handler}', expected $id" >&2
        fi
    done
}
repair_handler_entries

# Live and Max share this coordinator.  It is acquired only for a cold Live
# start and remains held until the selected prefix exposes the Live process.
cold_launch=0
launch_lock_held=0
if ! ableton_live_running; then
    cold_launch=1
    coordinator_dir="$(ableton_lifecycle_runtime_dir)"
    mkdir -p -- "$coordinator_dir"
    launch_lock="$coordinator_dir/bring-up.lock"
    exec 9>"$launch_lock"
    if ! flock -n 9; then
        echo "ableton-live: another Live/Max launcher is bringing this prefix up" >&2
        exit 1
    fi
    launch_lock_held=1
    printf 'live %s\n' "$$" >&9
    # This launcher owns the session from here: every wine invocation is below.
    # launch_lock_held cannot serve as the gate - it is cleared once Live appears.
    session_started=1
fi

callback_live_exe_for_audio_settings()
{
    local candidate version selected="" selected_version=""
    local -a candidates

    # A callback belongs to the prefix registry, so ABLETON_LIVE_EXE does not
    # select what Wine starts.  A shared point version is still unambiguous:
    # every candidate uses the same Live preferences directory.
    mapfile -t candidates < <(ABLETON_LIVE_EXE='' find_live_exe "${ABLETON_LIVE_VERSION:-}")
    [ "${#candidates[@]}" -gt 0 ] || return 1
    for candidate in "${candidates[@]}"; do
        version="$(ableton_live_product_version "$candidate" 2>/dev/null)" || return 1
        case "$version" in 12.*) ;; *) return 1 ;; esac
        if [ -n "$selected_version" ] && [ "$version" != "$selected_version" ]; then
            return 1
        fi
        selected="$candidate"
        selected_version="$version"
    done
    printf '%s\n' "$selected"
}

apply_max_audio_threads_setting()
{
    local selected_exe="$live_exe_unix"
    if [ -z "$selected_exe" ]; then
        if ! selected_exe="$(callback_live_exe_for_audio_settings)"; then
            echo "ableton-live: The callback does not identify one Live 12 version for audio thread settings." >&2
            echo "ableton-live: Start the intended edition directly with ABLETON_LIVE_EXE to apply the requested setting." >&2
            return 0
        fi
    fi
    ableton_seed_max_audio_threads "$WINEPREFIX" "$max_audio_threads" \
        "$selected_exe" "${USER:-}" "$max_audio_threads_replace_seeded" \
        "$max_audio_threads_restore_at_default"
}
if [ "$max_audio_threads_action" -eq 1 ]; then
    if [ "$cold_launch" -eq 1 ]; then
        if ! apply_max_audio_threads_setting; then
            echo "ableton-live: Live will use the current count for audio threads during this launch." >&2
        fi
    elif [ "$max_audio_threads_replace_seeded" -eq 1 ]; then
        echo "ableton-live: Exit Live. Run the command again to apply the audio thread setting." >&2
    fi
fi

# Keep the menu entry tracking the installed edition: install.sh renders it
# before Live exists in the prefix, so name, icon and window class heal here
# on each start. An entry that does not route through this launcher is
# hand-made and stays untouched.
if [ -n "$exe_base" ]; then
    apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    live_entry="$apps_dir/ableton-live.desktop"
    if [ -f "$live_entry" ] && grep -qF "$ABLETON_BIN_HOME/ableton-live" "$live_entry"; then
        entry_name="${exe_base%.exe}"
        entry_wmclass="$(printf '%s' "$exe_base" | tr '[:upper:]' '[:lower:]')"
        entry_edition="$(printf '%s' "$entry_name" | awk '{print tolower($NF)}')"
        entry_icon="live-suite"
        [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps/live-$entry_edition.svg" ] \
            && entry_icon="live-$entry_edition"
        if ! grep -qxF "Name=$entry_name" "$live_entry" \
            || ! grep -qxF "Icon=$entry_icon" "$live_entry" \
            || ! grep -qxF "StartupWMClass=$entry_wmclass" "$live_entry"; then
            awk -v name="$entry_name" -v icon="$entry_icon" -v wmclass="$entry_wmclass" '
                /^Name=/           { print "Name=" name; next }
                /^Icon=/           { print "Icon=" icon; next }
                /^StartupWMClass=/ { print "StartupWMClass=" wmclass; seen = 1; next }
                { print }
                END { if (!seen) print "StartupWMClass=" wmclass }
            ' "$live_entry" > "$live_entry.tmp" && mv "$live_entry.tmp" "$live_entry"
            update-desktop-database "$apps_dir" 2>/dev/null || true
        fi
    fi
fi

# Never kill a prefix merely because Live is absent: standalone Max and other
# clients intentionally share it.  Boot only an entirely idle prefix, under the
# shared bring-up lock, and supervise the cold boot.
if [ "$cold_launch" -eq 1 ] && ! ableton_prefix_busy; then
    if ! ableton_run_bounded "${ABLETON_WINEBOOT_TIMEOUT:-60}" \
        env WINEPREFIX="$WINEPREFIX" "$WINE_ROOT/bin/wineboot" -u >/dev/null 2>&1 9>&-; then
        echo "ableton-live: bounded wineboot failed; refusing to launch into a partial boot" >&2
        exit 1
    fi
fi

# Recalibrate prefix DPI to the detected scale before each launch. The block comes from
# detect-scale.sh: GNOME (upscaled framebuffer) -> LogPixels = 96 x ceil(scale) + IFEO=2;
# other compositors -> LogPixels = round(96 x scale), no IFEO. Scales outside 100-250%
# keep current values. ABLETON_DPI_MODE=100|fractional|dpi<N>|preserve overrides.
if ! ableton_live_running; then
    dpi_mode="${ABLETON_DPI_MODE:-auto}"
    dpi_family=""; dpi_scale=""
    dpi_lib="$ABLETON_DATA_HOME/detect-scale.sh"
    # Packaged installs (nix) ship the libs under the runtime root instead of $HOME.
    [ -r "$dpi_lib" ] || dpi_lib="$WINE_ROOT/share/ableton-wine/scripts/detect-scale.sh"
    [ -r "$dpi_lib" ] && . "$dpi_lib"
    if ! declare -F ableton_dpi_block_values >/dev/null 2>&1; then
        # no (or an older) detect-scale.sh: the two legacy blocks still resolve inline
        ableton_dpi_block_values() {
            case "$1" in
                100)        printf '96 -\n' ;;
                fractional) printf '192 2\n' ;;
                *) return 1 ;;
            esac
        }
    fi
    if [ "$dpi_mode" = auto ]; then
        dpi_mode=preserve
        if declare -F ableton_detect_scale_ex >/dev/null 2>&1; then
            detected="$(ableton_detect_scale_ex)" || detected=""
            if [ -n "$detected" ]; then
                dpi_scale="${detected% *}"
                dpi_family="${detected#* }"
                if ! dpi_mode="$(ableton_dpi_block_for_scale "$dpi_scale" "$dpi_family")"; then
                    dpi_mode=preserve
                    echo "ableton-live: scale $dpi_scale is outside the calibrated 100-250% range: keeping current DPI values (set ABLETON_DPI_MODE to force)" >&2
                fi
            fi
        elif declare -F ableton_detect_scale >/dev/null 2>&1; then
            # older detect-scale.sh without the family/mapping helpers: the two legacy blocks
            dpi_scale="$(ableton_detect_scale)" || dpi_scale=""
            case "$dpi_scale" in
                1)    dpi_mode=100 ;;
                1.25) dpi_mode=fractional ;;
                "")   ;;
                *)    echo "ableton-live: scale $dpi_scale detected, but only 100%/125% are calibrated: keeping current DPI values (set ABLETON_DPI_MODE to force)" >&2 ;;
            esac
        fi
    fi
    # The dpiAwareness IFEO is keyed on the exe name, so it follows the discovered install.
    dpi_ifeo=""; cur_ifeo=""
    if [ -n "$exe_base" ]; then
        dpi_ifeo="HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\$exe_base"
        cur_ifeo="$(awk '/^\[Software\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Image File Execution Options\\\\'"$exe_base"'\]/{f=1;next} /^\[/{f=0} f&&/"dpiAwareness"=dword:/{gsub(/.*dword:/,""); gsub(/\r/,""); print; exit}' "$WINEPREFIX/system.reg" 2>/dev/null || true)"
    fi
    # Read current values from the registry files directly (no wineserver spin-up).
    cur_lp="$(awk '/^\[Control Panel\\\\Desktop\]/{f=1;next} /^\[/{f=0} f&&/"LogPixels"=dword:/{gsub(/.*dword:/,""); gsub(/\r/,""); print; exit}' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
    case "$dpi_mode" in
        preserve) ;;
        *)
            lp_ifeo="$(ableton_dpi_block_values "$dpi_mode" 2>/dev/null)" || lp_ifeo=""
            if [ -z "$lp_ifeo" ]; then
                echo "ableton-live: unknown ABLETON_DPI_MODE '$dpi_mode': keeping current DPI values" >&2
            else
                want_lp="${lp_ifeo% *}"
                want_ifeo="${lp_ifeo#* }"
                want_lp_hex="$(printf '%08x' "$want_lp")"
                if [ "$want_ifeo" = 2 ]; then
                    if [ "${cur_lp:-}" != "$want_lp_hex" ] || { [ -n "$dpi_ifeo" ] && [ "${cur_ifeo:-}" != 00000002 ]; }; then
                        echo "ableton-live: recalibrating prefix DPI to the '$dpi_mode' set (LogPixels $want_lp, IFEO=2)" >&2
                        ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$want_lp" /f >/dev/null 2>&1 9>&-
                        [ -z "$dpi_ifeo" ] || ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add "$dpi_ifeo" /v dpiAwareness /t REG_DWORD /d 2 /f >/dev/null 2>&1 9>&-
                    fi
                else
                    if [ "${cur_lp:-00000060}" != "$want_lp_hex" ] || [ -n "$cur_ifeo" ]; then
                        echo "ableton-live: recalibrating prefix DPI to the '$dpi_mode' set (LogPixels $want_lp, no IFEO)" >&2
                        ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$want_lp" /f >/dev/null 2>&1 9>&-
                        [ -z "$dpi_ifeo" ] || ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg delete "$dpi_ifeo" /v dpiAwareness /f >/dev/null 2>&1 9>&- || true
                    fi
                fi
            fi ;;
    esac
    # Warn if mutter's xwayland-native-scaling disagrees with the DPI set; never change it.
    # The knob only exists under mutter: skip when another compositor family was detected.
    if [ -z "$dpi_family" ] || [ "$dpi_family" = gnome ]; then
        if command -v gsettings >/dev/null 2>&1; then
            mutter_feats="$(gsettings get org.gnome.mutter experimental-features 2>/dev/null || true)"
            case "$dpi_mode" in
                fractional*)   # upscaled-framebuffer sets expect the knob ON
                    case "$mutter_feats" in *xwayland-native-scaling*) ;; *)
                        [ -n "$mutter_feats" ] && echo "ableton-live: warn: mutter xwayland-native-scaling is OFF; the '$dpi_mode' set expects it ON" >&2 ;; esac ;;
                100|dpi*)
                    case "$mutter_feats" in *xwayland-native-scaling*)
                        echo "ableton-live: warn: mutter xwayland-native-scaling is ON; the '$dpi_mode' set expects it OFF" >&2 ;; esac ;;
            esac
        fi
    fi
fi

# GrayText (disabled menu items, e.g. Options when no track is selected) has no
# per-theme source: Live's own TextDisabled token is calibrated for its layered
# Skia surfaces (borders, icons, spacing), and copying it verbatim onto a flat
# win32u menu fill tests worse than doing nothing (checked against the active
# theme: TextDisabled sits closer to Menu than even wine's compiled-in default
# does). Derive it instead: blend 45% of the way from Menu towards MenuText, per
# channel. That tracks whatever Menu/MenuText resolve to (theme, dark/light,
# live-follow) with no extra parsing, and lands near Windows' own classic
# GrayText (128,128,128) on the hardcoded dark/light fallbacks. Shared by
# sync_win32_colors and theme_watch_loop below.
blend_gray_text() {   # <menu "R G B"> <menutext "R G B"> -> "R G B"
    local mr mg mb tr tg tb
    read -r mr mg mb <<< "$1"
    read -r tr tg tb <<< "$2"
    printf '%d %d %d' $(( mr + (tr - mr) * 45 / 100 )) $(( mg + (tg - mg) * 45 / 100 )) $(( mb + (tb - mb) * 45 / 100 ))
}

# win32u-drawn menu bar/dropdowns take their colours from [Control Panel\Colors],
# which nothing else ever writes, so they'd otherwise stay stock light in dark
# mode. When the host titlebar colours are known (issue #32), the bar/text take
# those too, unifying the WM titlebar with Live's menu bar. Do NOT add "Window"
# here: a dark Window colour blacks out comdlg32 dialog lists.
sync_win32_colors() {   # dark|light [bar-bg bar-fg [menu-bg sel-bg sel-fg]]  ("R G B")
    local scheme="$1" bar_bg="${2:-}" bar_fg="${3:-}" menu_bg="${4:-}" sel_bg="${5:-}" sel_fg="${6:-}"
    local pair name want cur changed=0 menubar menutext menu
    local -a pairs
    case "$scheme" in
        dark)   menubar="43 43 43";    menutext="232 232 232"; menu="43 43 43"
                pairs=("ButtonFace=64 64 64" "ButtonText=232 232 232") ;;
        light)  menubar="240 240 240"; menutext="0 0 0";       menu="255 255 255"
                pairs=("ButtonFace=240 240 240" "ButtonText=0 0 0") ;;
        *)      return 0 ;;
    esac
    if [ -n "$bar_bg" ] && [ -n "$bar_fg" ]; then
        menubar="$bar_bg"; menutext="$bar_fg"
        pairs+=("ActiveTitle=$bar_bg" "GradientActiveTitle=$bar_bg" "TitleText=$bar_fg")
    fi
    [ -n "$menu_bg" ] && menu="$menu_bg"
    pairs+=("GrayText=$(blend_gray_text "$menu" "$menutext")")
    # Selected-item colours only ever move as a set: the menu highlight fill
    # (MenuHilight), the general selection fill (Hilight) and the selection text
    # (HilightText): win32u draws selected menu text with HilightText, so a themed
    # fill under the stock white text would be unreadable.
    if [ -n "$sel_bg" ] && [ -n "$sel_fg" ]; then
        pairs+=("MenuHilight=$sel_bg" "Hilight=$sel_bg" "HilightText=$sel_fg")
    fi
    pairs+=("Menu=$menu" "MenuBar=$menubar" "MenuText=$menutext")
    for pair in "${pairs[@]}"; do
        name="${pair%%=*}"
        want="${pair#*=}"
        cur="$(awk -v n="\"$name\"=" '
            /^\[Control Panel\\\\Colors\]/ { f=1; next }
            /^\[/ { f=0 }
            f && index($0, n) == 1 {
                v = substr($0, length(n) + 1)
                sub(/^"/, "", v); sub(/"\r?$/, "", v)
                print v; exit
            }' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
        if [ "$cur" != "$want" ]; then
            [ "$changed" -eq 0 ] && echo "ableton-live: syncing the win32 menu colours to the $scheme scheme" >&2
            changed=1
            ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Colors' /v "$name" /t REG_SZ /d "$want" /f >/dev/null 2>&1 9>&-
        fi
    done
}

# The bar only paints with the MenuBar colour when the flat-menu preference is on
# (win32u picks COLOR_MENUBAR over COLOR_MENU off SPI_GETFLATMENU); flat is also how
# Windows 10/11 draw menus. The preference is bit 0x02 of byte 2 in the
# UserPreferencesMask blob: set that one bit, keep every other preference.
ensure_flat_menu() {
    local cur b2 hex
    local -a bytes
    cur="$(awk '/^\[Control Panel\\\\Desktop\]/{f=1;next} /^\[/{f=0} f&&/"UserPreferencesMask"=hex:/{gsub(/.*hex:/,""); gsub(/\r/,""); print; exit}' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
    [ -n "$cur" ] || cur="10,00,00,80,12,00,00,00"    # win32u's built-in default
    IFS=, read -ra bytes <<< "$cur"
    [ "${#bytes[@]}" -ge 8 ] || return 0
    b2=$(( 16#${bytes[2]} )) 2>/dev/null || return 0
    [ $(( b2 & 0x02 )) -ne 0 ] && return 0
    printf -v 'bytes[2]' '%02x' $(( b2 | 0x02 ))
    hex="$(IFS=''; printf '%s' "${bytes[*]}")"
    echo "ableton-live: enabling flat menus so the bar can take the titlebar colour" >&2
    ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v UserPreferencesMask /t REG_BINARY /d "$hex" /f >/dev/null 2>&1 9>&-
}

# "#RRGGBB #RRGGBB" (ABLETON_TOPBAR_MODE override) -> "R G B|R G B" (bg|text)
parse_topbar_override() {
    local bg fg rest c
    read -r bg fg rest <<< "$1"
    [ -z "$rest" ] || return 1
    for c in "$bg" "$fg"; do
        case "$c" in
            \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
            *) return 1 ;;
        esac
    done
    printf '%d %d %d|%d %d %d\n' \
        $(( 16#${bg:1:2} )) $(( 16#${bg:3:2} )) $(( 16#${bg:5:2} )) \
        $(( 16#${fg:1:2} )) $(( 16#${fg:3:2} )) $(( 16#${fg:5:2} ))
}

# ABLETON_TOPBAR_MODE=live: colour the chrome with Live's active theme (the
# Push 3 standalone look). Bar takes Desktop, dropdowns take ControlBackground;
# selection set from SelectionBackground/SelectionForeground (see
# detect-theme.sh for resolution). Swapped from the first cut (bar<-
# ControlBackground) after a light-mode screenshot showed the always-visible
# bar lighter than its own dropdowns - backwards from every reference (a
# darker chrome strip framing lighter content).
resolve_live_topbar() {   # sets topbar/menu_bg/sel_bg/sel_fg; fails when unresolvable
    local themes major theme_file bg fg
    [ -n "$live_exe_unix" ] || return 1
    declare -F ableton_live_theme_file >/dev/null 2>&1 || return 1
    themes="${live_exe_unix%/Program/*}/Resources/Themes"
    major="$(printf '%s\n' "$exe_base" | awk '{print $3}')"
    theme_file="$(ableton_live_theme_file "$WINEPREFIX" "$themes" "$major" "$theme_mode")" || return 1
    bg="$(ableton_ask_color "$theme_file" Desktop)" || return 1
    fg="$(ableton_ask_color "$theme_file" ControlForeground)" || return 1
    topbar="$bg|$fg"
    menu_bg="$(ableton_ask_color "$theme_file" ControlBackground)" || menu_bg="$bg"
    sel_bg="$(ableton_ask_color "$theme_file" SelectionBackground)" || sel_bg=""
    sel_fg="$(ableton_ask_color "$theme_file" SelectionForeground)" || sel_fg=""
    return 0
}

detect_system_topbar() {   # sets topbar from the host titlebar colors
    declare -F ableton_detect_topbar_colors >/dev/null 2>&1 || return 0
    topbar="$(ableton_detect_topbar_colors "$theme_mode")" || topbar=""
}

# With ABLETON_TOPBAR_MODE=live the bar keeps following while Live runs: Live
# flushes Preferences.cfg when its settings dialog closes (and on exit), so a
# theme picked there lands on disk moments later. Watch the newest cfg and
# re-apply through setsyscolors.exe: SetSysColors updates the running session
# (volatile color entries plus a WM_SYSCOLORCHANGE broadcast and redraw), so the
# bar and menus repaint without a restart; the per-launch sync persists the
# colors for the next session. One watcher per prefix (own lock, fd 8); exits
# when Live does.
theme_watch_prefs_cfg() {
    # Newest Preferences.cfg across installed "Live <major>.*" editions: see
    # ableton_newest_prefs_dir in detect-theme.sh (sourced above) for why this
    # isn't sort -V on the path.
    local major dir
    major="$(printf '%s\n' "$exe_base" | awk '{print $3}')"
    dir="$(ableton_newest_prefs_dir "$WINEPREFIX" "$major")"
    [ -n "$dir" ] && printf '%s\n' "$dir/Preferences.cfg"
}
theme_watch_loop() {
    local apply="$ABLETON_DATA_HOME/setsyscolors.exe"
    [ -f "$apply" ] || apply="$WINE_ROOT/share/ableton-wine/scripts/setsyscolors.exe"
    local lock="$WINEPREFIX/.ableton-theme-watch.lock" cfg last="" cur bar_bg bar_fg
    local applied=""    # last color set actually broadcast; skip re-firing when unchanged
    local major have_inotify=0 f
    local -a watch_files
    [ -f "$apply" ] || return 0
    command -v flock >/dev/null 2>&1 || return 0
    # inotifywait (inotify-tools) turns this into an event-driven wait instead
    # of a fixed poll: wakes up on the write itself rather than up to 2s later.
    # Optional - falls back to the plain sleep-poll below when not installed,
    # same as the flock check above already does for its own dependency.
    command -v inotifywait >/dev/null 2>&1 && have_inotify=1
    major="$(printf '%s\n' "$exe_base" | awk '{print $3}')"
    exec 8>"$lock" || return 0
    # the previous session's watcher exits within seconds of Live going down;
    # wait it out rather than losing the handover race
    for _ in 1 2 3 4 5 6 7 8; do
        flock -n 8 && break
        sleep 2
    done
    flock -n 8 || return 0
    for _ in {1..30}; do
        ableton_live_running && break
        sleep 2
    done
    cfg="$(theme_watch_prefs_cfg)"
    [ -n "$cfg" ] && last="$(stat -c %Y "$cfg" 2>/dev/null)"
    while ableton_live_running; do
        if [ "$have_inotify" -eq 1 ]; then
            watch_files=()
            for f in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/Ableton/"Live ${major:-}"*/Preferences/Preferences.cfg; do
                [ -f "$f" ] && watch_files+=("$f")
            done
            if [ "${#watch_files[@]}" -gt 0 ]; then
                # timeout keeps the process liveness check above from stalling
                # indefinitely if Live exits without ever touching the file again
                inotifywait -q -e close_write,modify -t 30 "${watch_files[@]}" >/dev/null 2>&1
                # exit 2 is a plain timeout and exit 0 is a real event - both
                # already waited. exit 1 means inotifywait itself failed (bad
                # path, inotify watch limit, ...); without a fallback sleep
                # here the loop would spin with no delay at all until Live exits.
                [ $? -eq 1 ] && sleep 2
            else
                sleep 2
            fi
        else
            sleep 2
        fi
        cfg="$(theme_watch_prefs_cfg)"
        [ -n "$cfg" ] || continue
        cur="$(stat -c %Y "$cfg" 2>/dev/null)" || continue
        [ "$cur" = "$last" ] && continue
        last="$cur"
        topbar=""; menu_bg=""; sel_bg=""; sel_fg=""
        resolve_live_topbar || continue
        local gray
        gray="$(blend_gray_text "$menu_bg" "${topbar##*|}")"; gray="${gray// /,}"
        bar_bg="${topbar%%|*}"; bar_bg="${bar_bg// /,}"
        bar_fg="${topbar##*|}"; bar_fg="${bar_fg// /,}"
        set -- "MenuBar=$bar_bg" "MenuText=$bar_fg" "ActiveTitle=$bar_bg" \
               "GradientActiveTitle=$bar_bg" "TitleText=$bar_fg" "GrayText=$gray"
        [ -n "$menu_bg" ] && set -- "$@" "Menu=${menu_bg// /,}"
        if [ -n "$sel_bg" ] && [ -n "$sel_fg" ]; then
            set -- "$@" "MenuHilight=${sel_bg// /,}" "Hilight=${sel_bg// /,}" "HilightText=${sel_fg// /,}"
        fi
        # Preferences.cfg is touched for plenty of reasons beyond a theme pick (window
        # layout, focus state, ...), and this poll can't tell those apart from a real
        # theme change — only whether the file moved. Re-deriving is cheap; broadcasting
        # a live SetSysColors + WM_SYSCOLORCHANGE repaint is not, so only actually fire
        # it when the resolved colors differ from what's already applied.
        if [ "$*" = "$applied" ]; then
            continue
        fi
        applied="$*"
        ableton_run_bounded 30 "$WINE_ROOT/bin/wine" "$apply" "$@" >/dev/null 2>&1
    done
}

# Chrome typeface (issue #32): Live ships its own UI faces (Ableton Sans, plus the
# small-size cut Ableton Sans Small) in the install's Resources/Fonts, but the win32
# chrome around it: menu bar, context menus, message boxes: still renders Tahoma.
# Symlink the faces into the prefix's Fonts dir (win32u rescans it on every process
# start) and point both the shell-dialog substitutes and the WindowMetrics non-client
# fonts at them. The WindowMetrics LOGFONTs are patched in place: only the 64
# face-name bytes at offset 28 change, so the DPI-scaled heights and per-entry weights
# survive. ABLETON_UI_FONT=preserve touches nothing, =off restores wine's stock
# Tahoma, any other value is used verbatim as the family name.

reg_windowmetrics_hex() {   # value name -> "aa,bb,..." with continuation lines joined
    awk -v n="\"$1\"=hex:" '
        /^\[Control Panel\\\\Desktop\\\\WindowMetrics\]/ { f=1; next }
        /^\[/ { f=0 }
        f && index($0, n) == 1 {
            v = substr($0, length(n) + 1)
            while (v ~ /\\$/) {
                sub(/\\$/, "", v)
                if ((getline nl) <= 0) break
                gsub(/^[ \t]+/, "", nl)
                v = v nl
            }
            gsub(/\r/, "", v)
            print v; exit
        }' "$WINEPREFIX/user.reg" 2>/dev/null
}

logfont_face_hex() {   # family -> UTF-16LE face-name bytes, zero-padded to LF_FACESIZE
    local s="$1" out="" i ch
    [ "${#s}" -le 31 ] || return 1
    case "$s" in *[![:ascii:]]*) return 1 ;; esac   # blob is built bytewise from ASCII
    for (( i = 0; i < 32; i++ )); do
        if [ "$i" -lt "${#s}" ]; then
            printf -v ch '%02x' "'${s:$i:1}"
            out+="$ch,00,"
        else
            out+="00,00,"
        fi
    done
    printf '%s\n' "${out%,}"
}

sync_metric_fonts() {   # family -> repoint the non-client LOGFONTs, heights preserved
    local fam="$1" face_hex name cur head cur_face changed=0
    face_hex="$(logfont_face_hex "$fam")" || return 0
    for name in MenuFont MessageFont StatusFont CaptionFont SmCaptionFont; do
        cur="$(reg_windowmetrics_hex "$name")"
        # absent: win32u falls back to "MS Shell Dlg", which the substitutes cover
        [ -n "$cur" ] || continue
        head="$(printf '%s' "$cur" | cut -d, -f1-28)"
        [ "$(printf '%s' "$head" | awk -F, '{print NF}')" -eq 28 ] || continue
        cur_face="$(printf '%s' "$cur" | cut -d, -f29-92)"
        [ "$cur_face" = "$face_hex" ] && continue
        [ "$changed" -eq 0 ] && echo "ableton-live: pointing the win32 chrome fonts at '$fam'" >&2
        changed=1
        ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop\WindowMetrics' /v "$name" \
            /t REG_BINARY /d "$(printf '%s,%s' "$head" "$face_hex" | tr -d ,)" /f >/dev/null 2>&1 9>&-
    done
}

sync_font_substitutes() {   # family -> route the shell-dialog faces to it
    local fam="$1" name cur changed=0
    for name in "MS Shell Dlg" "MS Shell Dlg 2"; do
        cur="$(awk -v n="\"$name\"=" '
            /^\[Software\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\FontSubstitutes\]/ { f=1; next }
            /^\[/ { f=0 }
            f && index($0, n) == 1 {
                v = substr($0, length(n) + 1)
                sub(/^"/, "", v); sub(/"\r?$/, "", v)
                print v; exit
            }' "$WINEPREFIX/system.reg" 2>/dev/null || true)"
        if [ "$cur" != "$fam" ]; then
            [ "$changed" -eq 0 ] && echo "ableton-live: substituting the shell dialog faces with '$fam'" >&2
            changed=1
            ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' \
                /v "$name" /t REG_SZ /d "$fam" /f >/dev/null 2>&1 9>&-
        fi
    done
}

# Ableton Sans/Ableton Sans Small are Latin-only, so register a SystemLink
# chain for the substituted family: Tahoma, then the Noto Sans CJK cuts Live
# bundles in Resources/Fonts, then Unifont as a full-Unicode last resort.
# Patch 0054's get_fallback_font_for_text walks it; the registry data alone
# does nothing, since win32u consults SystemLink only when selecting a whole
# font by charset, never when rendering a glyph.
#
# Taken from Live's install, read directly with fc-scan, rather than asking
# the host's fontconfig for "some" CJK font: Live ships these because its own
# UI is localized into Japanese and Chinese, so they are present whenever Live
# is, and the chain is then identical on every distro.
sync_font_fallback() {   # family -> register its SystemLink chain from what sync_ui_font linked into winfonts
    local fam="$1" want="tahoma.ttf,Tahoma" cur pat f base fc_fam pair
    local winfonts="$WINEPREFIX/drive_c/windows/Fonts"
    local -a pairs=()
    if command -v fc-scan >/dev/null 2>&1; then
        for pat in "$winfonts"/NotoSansCJKjp-Regular.otf "$winfonts"/NotoSansCJKsc-Regular.otf \
                   "$winfonts"/NotoSansCJKkr-Regular.otf "$winfonts"/unifont_jp-*.ttf "$winfonts"/unifont_upper-*.ttf; do
            for f in $pat; do
                [ -e "$f" ] || continue
                base="${f##*/}"
                # %{fullname}, not %{family}: win32u matches a SystemLink entry
                # on filename plus the name-ID-1 family, and %{family} reports
                # ID 16 first. Live's NotoSansCJKjp-Regular.otf is
                # "Noto Sans CJK JP Regular" in ID 1, so the ID 16 name matched
                # nothing and the entry was dropped at load with a silent
                # "Unable to find file", dumping CJK text onto Unifont.
                fc_fam="$(fc-scan -f '%{fullname}\n' "$f" 2>/dev/null | head -1)"
                [ -n "$fc_fam" ] && pairs+=("$base,$fc_fam")
            done
        done
    fi
    for pair in "${pairs[@]}"; do
        want="${want}\\0${pair}"
    done
    cur="$(awk -v n="\"$fam\"=" '
        /^\[Software\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\FontLink\\\\SystemLink\]/ { f=1; next }
        /^\[/ { f=0 }
        f && index($0, n) == 1 {
            v = substr($0, length(n) + 1)
            sub(/^str\(7\):"/, "", v); sub(/\\0"\r?$/, "", v)
            print v; exit
        }' "$WINEPREFIX/system.reg" 2>/dev/null || true)"
    [ "$cur" = "$want" ] && return 0
    echo "ableton-live: linking Tahoma + bundled CJK/Unicode fallback fonts for '$fam'" >&2
    ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink' \
        /v "$fam" /t REG_MULTI_SZ /d "${want}\0" /f >/dev/null 2>&1 9>&-
}

# Wine takes the antialiasing mode for GDI text from the host's Xft resources,
# so a desktop set to grayscale renders Live's menus and dialogs grayscale
# whatever the prefix asks for. An explicit prefix policy outranks that
# (patch 0087), and this is what keeps it set: setup-prefix.sh
# seeds it, and a prefix made by an older release has nothing.
# ABLETON_TEXT_SMOOTHING=grayscale writes a deliberate grayscale marker,
# preserve leaves whatever the prefix already carries.
sync_text_smoothing() {
    local want_enabled want_type order cur_enabled cur_type
    case "${ABLETON_TEXT_SMOOTHING:-subpixel}" in
        preserve) return 0 ;;
        grayscale) want_enabled=1; want_type=1 ;;
        subpixel)  want_enabled=2; want_type=2 ;;
        *)
            echo "ableton-live: ABLETON_TEXT_SMOOTHING must be subpixel, grayscale, or preserve: using subpixel" >&2
            want_enabled=2; want_type=2 ;;
    esac
    cur_enabled="$(awk '/^\[Control Panel\\\\Desktop\]/{f=1;next} /^\[/{f=0} f&&/"FontSmoothing"=/{gsub(/.*="?/,""); gsub(/"\r?$/,""); print; exit}' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
    cur_type="$(awk '/^\[Control Panel\\\\Desktop\]/{f=1;next} /^\[/{f=0} f&&/"FontSmoothingType"=dword:/{gsub(/.*dword:/,""); gsub(/\r/,""); print; exit}' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
    # Smoothing off is itself an explicit prefix policy. Never turn it back on
    # merely because the launcher defaults to subpixel rendering.
    [ "$cur_enabled" = 0 ] && return 0
    [ "$cur_enabled" = "$want_enabled" ] && [ "$((16#${cur_type:-0}))" = "$want_type" ] && return 0

    # A BGR panel rendered as RGB fringes the wrong way, so follow the host
    # where it states an order.
    order=1
    if command -v gsettings >/dev/null 2>&1; then
        case "$(gsettings get org.gnome.desktop.interface font-rgba-order 2>/dev/null | tr -d "'")" in
            bgr) order=0 ;;
        esac
    fi
    echo "ableton-live: setting text antialiasing to ${ABLETON_TEXT_SMOOTHING:-subpixel}" >&2
    ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v FontSmoothing /t REG_SZ /d "$want_enabled" /f >/dev/null 2>&1 9>&-
    ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v FontSmoothingType /t REG_DWORD /d "$want_type" /f >/dev/null 2>&1 9>&-
    ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Control Panel\Desktop' /v FontSmoothingOrientation /t REG_DWORD /d "$order" /f >/dev/null 2>&1 9>&-
}

sync_ui_font() {
    local mode="${ABLETON_UI_FONT:-auto}" winfonts="$WINEPREFIX/drive_c/windows/Fonts"
    local fonts_dir="" family="" f linked=0
    [ "$mode" = preserve ] && return 0
    [ -d "$winfonts" ] || return 0
    # Links from an install that was since removed or upgraded must not linger.
    for f in "$winfonts"/AbletonSans* "$winfonts"/NotoSansCJK* "$winfonts"/unifont_*; do
        [ -L "$f" ] && [ ! -e "$f" ] && rm -f "$f"
    done
    if [ "$mode" = off ]; then
        for f in "$winfonts"/AbletonSans* "$winfonts"/NotoSansCJK* "$winfonts"/unifont_*; do
            [ -L "$f" ] && rm -f "$f"
        done
        sync_font_substitutes Tahoma
        sync_metric_fonts Tahoma
        # Tahoma gets its chain from win32u's hardcoded substitute list, so
        # it needs no entry here. Clear any a previous auto/named run left for
        # the Ableton families, which are no longer selected anywhere.
        local fam
        for fam in "Ableton Sans" "Ableton Sans Small"; do
            ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg delete 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink' \
                /v "$fam" /f >/dev/null 2>&1 9>&- || true
        done
        return 0
    fi
    [ -n "$live_exe_unix" ] && fonts_dir="${live_exe_unix%/Program/*}/Resources/Fonts"
    if [ "$mode" = auto ]; then
        [ -d "$fonts_dir" ] || return 0
        for f in "$fonts_dir"/AbletonSans*.ttf; do
            [ -e "$f" ] || continue
            ln -sf "$f" "$winfonts/${f##*/}"
            linked=1
        done
        [ "$linked" -eq 1 ] || return 0
        # Ableton Sans Small is the complete family (Regular/Bold/Italic) cut for UI
        # sizes; plain Ableton Sans ships as Light only in current Live 12.
        if [ -e "$winfonts/AbletonSansSmall-Regular.ttf" ]; then
            family="Ableton Sans Small"
        else
            family="Ableton Sans"
        fi
    else
        family="$mode"
    fi
    # Fallback faces for the chain sync_font_fallback registers below. Linked
    # for every mode that reaches here, not just auto: a named family is as
    # Latin-limited as Ableton Sans, so keeping these under auto left
    # ABLETON_UI_FONT=<name> with a Tahoma-only chain and CJK back to tofu.
    # Both weights, so bold menu items get a real bold face. The auto path has
    # already returned by now if nothing was substituted, so this cannot leave
    # unreferenced symlinks behind.
    if [ -d "$fonts_dir" ]; then
        for f in "$fonts_dir"/NotoSansCJK*.otf "$fonts_dir"/unifont_*.ttf; do
            [ -e "$f" ] || continue
            ln -sf "$f" "$winfonts/${f##*/}"
        done
    fi
    sync_font_substitutes "$family"
    sync_metric_fonts "$family"
    sync_font_fallback "$family"
}

# Mirror the host light/dark scheme into the prefix before each launch: Live's "Follow system"
# theme reads AppsUseLightTheme, which a scripted prefix never carries (the early snapshot-based
# installs inherited it). ABLETON_THEME_MODE=auto|dark|light|preserve overrides detection.
if ! ableton_live_running; then
    # Sourced outside the auto branch: the topbar color detection below wants the lib
    # even when ABLETON_THEME_MODE pins the scheme.
    theme_lib="$ABLETON_DATA_HOME/detect-theme.sh"
    [ -r "$theme_lib" ] || theme_lib="$WINE_ROOT/share/ableton-wine/scripts/detect-theme.sh"
    [ -r "$theme_lib" ] && . "$theme_lib"
    theme_mode="${ABLETON_THEME_MODE:-auto}"
    if [ "$theme_mode" = auto ]; then
        theme_mode=preserve
        if declare -F ableton_detect_theme >/dev/null 2>&1; then
            host_scheme="$(ableton_detect_theme)" || host_scheme=""
            case "$host_scheme" in dark|light) theme_mode="$host_scheme" ;; esac
        fi
    fi
    case "$theme_mode" in dark) want_light=0 ;; light) want_light=1 ;; *) want_light="" ;; esac
    if [ -n "$want_light" ]; then
        # Current value straight from the registry file (no wineserver spin-up when unchanged).
        cur_light="$(awk '/^\[Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Themes\\\\Personalize\]/{f=1;next} /^\[/{f=0} f&&/"AppsUseLightTheme"=dword:/{gsub(/.*dword:/,""); gsub(/\r/,""); print; exit}' "$WINEPREFIX/user.reg" 2>/dev/null || true)"
        if [ "${cur_light:-absent}" != "0000000$want_light" ]; then
            echo "ableton-live: host scheme is $theme_mode: setting the prefix theme to match" >&2
            ableton_run_bounded 60 "$WINE_ROOT/bin/wine" reg add 'HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' /v AppsUseLightTheme /t REG_DWORD /d "$want_light" /f >/dev/null 2>&1 9>&-
        fi
        # Unified top bar (issue #32): live (the default) colors the bar and menus
        # with Live's active theme so the chrome continues Live's own surface;
        # system inherits the host titlebar colors instead (KDE header colors, or
        # the GNOME header-bar constants for the scheme); "#RRGGBB #RRGGBB" forces
        # bar and text; preserve keeps the plain scheme colors of old.
        topbar=""; menu_bg=""; sel_bg=""; sel_fg=""
        case "${ABLETON_TOPBAR_MODE:-live}" in
            preserve) ;;
            live)   resolve_live_topbar || detect_system_topbar ;;
            system) detect_system_topbar ;;
            \#*)
                if ! topbar="$(parse_topbar_override "$ABLETON_TOPBAR_MODE")"; then
                    echo "ableton-live: cannot parse ABLETON_TOPBAR_MODE '$ABLETON_TOPBAR_MODE' (want '#RRGGBB #RRGGBB'): following the Live theme instead" >&2
                    resolve_live_topbar || detect_system_topbar
                fi ;;
            *)
                echo "ableton-live: ABLETON_TOPBAR_MODE must be live, system, preserve, or '#RRGGBB #RRGGBB': following the Live theme instead" >&2
                resolve_live_topbar || detect_system_topbar ;;
        esac
        if [ -n "$topbar" ]; then
            sync_win32_colors "$theme_mode" "${topbar%%|*}" "${topbar##*|}" "$menu_bg" "$sel_bg" "$sel_fg"
            ensure_flat_menu
        else
            sync_win32_colors "$theme_mode"
        fi
    fi
    sync_ui_font
    sync_text_smoothing
fi

# GNOME consumes Live's Ctrl+Alt+Up/Down shortcuts (and Live 11's
# Ctrl+Alt+Delete) before Wine sees them. The launcher temporarily removes only
# those entries by default on GNOME. ABLETON_SHORTCUTS=preserve opts out. The
# helper uses session-global, crash-recoverable state because GSettings itself
# is session-global; it also preserves any user edit made while Live runs. The
# held keys are unavailable to every other window until the last Live exits.
# See the shortcut support note.
shortcut_lib=""
for f in "$ABLETON_DATA_HOME/shortcut-hold.sh" \
         "${BASH_SOURCE[0]%/*}/shortcut-hold.sh"; do
    if [ -r "$f" ]; then shortcut_lib="$f"; break; fi
done
ableton_shortcuts_active=0
if [ -n "$shortcut_lib" ]; then
    . "$shortcut_lib"
    shortcut_allow_hold=0
    [ -n "$EXE" ] && shortcut_allow_hold=1
    # Always run recovery, even if Live was uninstalled after an interrupted
    # hold.  A new hold is allowed only after discovery confirmed an executable.
    ableton_shortcuts_prepare "$exe_base" "$WINEPREFIX/.ableton-shortcut-hold" "$shortcut_allow_hold"
    if [ "$ableton_shortcuts_active" -eq 1 ]; then
        # The watcher can outlive a failed launch.  Do not let it keep the
        # single-launch guard open while it waits to restore the desktop.
        ( exec 9>&-; ableton_shortcuts_watch_loop ) </dev/null >/dev/null 2>&1 &
        disown
    fi
elif [ "$shortcuts_mode" = take ] && [ -n "$EXE" ]; then
    echo "ableton-live: shortcut hold helper is missing; leaving desktop shortcuts unchanged" >&2
fi

# Audio: PipeASIO -> PipeWire (native client, no JACK layer). Defaults live in
# ~/.config/pipeasio/config.ini (seeded by setup-prefix.sh); PIPEASIO_* variables
# override per launch: raise PIPEASIO_PREFERRED_BUFFERSIZE to 512 if crackles.

require_live() {
    [ -n "$EXE" ] && return 0
    echo "ableton-live: no Ableton Live installation found in $WINEPREFIX" >&2
    echo "ableton-live: run the ableton-wine-setup .run with the install command and your Ableton download next to it - on a packaged install, put the zip in ~/Proprietary and rerun setup-prefix with ABLETON_LIVE_AUTOINSTALL=1 - or install Live manually: see the README" >&2
    exit 1
}

run=("$WINE_ROOT/bin/wine")
# The probe fires wherever rtprio rights exist: setup-realtime.sh grants them,
# but some distributions (CachyOS among them) grant them out of the box, so RR
# can be active without any opt-in here. SCHED_RR covers the whole process, GUI
# threads included; ABLETON_RT=off exists for A/B runs and low-core machines
# where that is a net loss.
if [ "${ABLETON_RT:-on}" != off ] && command -v chrt >/dev/null 2>&1 \
    && chrt -r 10 true >/dev/null 2>&1; then
    run=(chrt -r 10 "$WINE_ROOT/bin/wine")
fi

# CPU speed for the session: hold the "performance" power profile while Live
# runs, through power-profiles-daemon (tuned-ppd answers the same CLI). The
# hold needs no root, shows up in the desktop's power menu, and is released
# when Live exits or crashes. This replaces the boot-time governor unit that
# setup-realtime.sh installed before 2026-08; ABLETON_POWER=off skips it for
# one launch. The probe runs the exact call with `true`, so a missing daemon,
# a host without a performance profile, or an old powerprofilesctl all fall
# back to launching without the hold. The timeout bounds a wedged daemon:
# powerprofilesctl waits on GLib's 25 s D-Bus default per call, and the hold
# call would wait a second time. The start.exe paths below pass /w so
# start.exe waits on the process it spawns; without it start.exe exits right
# after the handoff and the hold dies with it, leaving cold starts through
# ableton:// URLs and .auz files uncovered. The chrt wrapper is unaffected
# either way: scheduling policy is inherited across fork/exec. One side
# effect: with /w the spawned process sits in a kill-on-close job object, so
# killing the launcher chain now takes Live down with it.
if [ "${ABLETON_POWER:-on}" != off ] && command -v powerprofilesctl >/dev/null 2>&1 \
    && ableton_run_bounded 10 powerprofilesctl launch -p performance -r "Ableton Live session" -i ableton-live -- true >/dev/null 2>&1; then
    run=(powerprofilesctl launch -p performance -r "Ableton Live session" -i ableton-live -- "${run[@]}")
fi

# Ableton Link session anchor (optional): if ableton-linkd is installed but
# not running, start it so the Link session is anchored before Live launches.
# The daemon is session-scoped: it exits on its own after 15 minutes with no
# peers (ABLETON_LINKD_LINGER overrides; the user unit runs --linger 0 for an
# always-on anchor). Daemon mode logs under XDG_STATE_HOME/ableton-wine/logs/.
# ABLETON_LINKD overrides the binary path.
linkctl="$ABLETON_DATA_HOME/ableton-linkctl"
# Packaged installs (nix) stage it under the runtime root instead of $HOME.
[ -x "$linkctl" ] || linkctl="$WINE_ROOT/share/ableton-wine/scripts/ableton-linkctl"
if [ "$ABLETON_LINK_MODE" != off ] && [ -x "$linkctl" ]; then
    "$linkctl" start || echo "ableton-live: configured Link anchor failed to start" >&2
fi

# Follow Live-theme changes while it runs (see theme_watch_loop above). Spawned
# after the launch lock is closed, fully detached; a no-op when the helper exe
# is not installed or another watcher already holds the prefix's watch lock.
if [ "${ABLETON_TOPBAR_MODE:-live}" = live ] && [ -n "$EXE" ] && [ -n "${want_light:-}" ]; then
    ( exec 9>&-; theme_watch_loop ) </dev/null >/dev/null 2>&1 &
    disown
fi

# Auto-heal the Learn View / doc sidebar WebView2 fossil-on-open: a resident
# helper nudges each
# settled lesson pane once, replacing the manual splitter nudge. It waits for
# a pane to hold a stable rect before poking (bind-time pokes leave Chromium
# resize-deaf) and exits on its own after Live is gone. No-op when the helper
# is not installed.
learnheal="$ABLETON_DATA_HOME/learnheal.exe"
[ -f "$learnheal" ] || learnheal="$WINE_ROOT/share/ableton-wine/learnheal.exe"
if [ -n "$EXE" ] && [ -f "$learnheal" ]; then
    ( exec 9>&-; ableton_run_bounded 90 env WINEPREFIX="$WINEPREFIX" "$WINE_ROOT/bin/wine" "$learnheal" ) </dev/null >/dev/null 2>&1 &
    disown
fi

launch_command()
{
    if [ "$launch_lock_held" -ne 1 ]; then
        exec "$@"
    fi
    local child rc=0 timeout_secs i ready=0 process_group=0
    timeout_secs="$(ableton_timeout_value "${ABLETON_LAUNCH_TIMEOUT:-90}" ABLETON_LAUNCH_TIMEOUT 5 600)" || return 2
    if command -v setsid >/dev/null 2>&1; then
        setsid -- "$@" 9>&- &
        process_group=1
    else
        "$@" 9>&- &
    fi
    child=$!
    for ((i=0; i<timeout_secs*10; i++)); do
        if ableton_live_running; then ready=1; break; fi
        if ! kill -0 "$child" 2>/dev/null; then break; fi
        sleep 0.1
    done
    flock -u 9 2>/dev/null || true
    exec 9>&-
    launch_lock_held=0
    if [ "$ready" -ne 1 ]; then
        if [ "$process_group" -eq 1 ] && kill -0 -- "-$child" 2>/dev/null; then
            kill -TERM -- "-$child" 2>/dev/null || true
            for _ in {1..50}; do kill -0 -- "-$child" 2>/dev/null || break; sleep 0.1; done
            kill -0 -- "-$child" 2>/dev/null && kill -KILL -- "-$child" 2>/dev/null || true
        elif kill -0 "$child" 2>/dev/null; then
            kill -TERM "$child" 2>/dev/null || true
            for _ in {1..50}; do kill -0 "$child" 2>/dev/null || break; sleep 0.1; done
            kill -0 "$child" 2>/dev/null && kill -KILL "$child" 2>/dev/null || true
        fi
        wait "$child" || rc=$?
        echo "ableton-live: Live did not become observable in the selected prefix within ${timeout_secs}s (launcher exit $rc)" >&2
        return 1
    fi
    wait "$child"
}

if [ "$callback_kind" = protocol ]; then
    launch_command "${run[@]}" start /w "$1"
elif [ "$callback_kind" = auz ]; then
    launch_command "${run[@]}" start /w /unix "$1"
elif [ -n "${ABLETON_VDESK:-}" ]; then
    require_live
    launch_command "${run[@]}" explorer "/desktop=AbletonLive,${ABLETON_VDESK}" "$EXE"
elif [ "$#" -gt 0 ]; then
    # ableton:// URLs, .auz license files, Live documents from the file
    # manager or command line. A single existing file arrives as a unix path
    # (%f in the desktop entry). Live documents go straight to the Live exe:
    # sets, clips and packs have no association inside the prefix, and
    # start.exe reads a bare unix path as a switch (issue #38). Other files
    # keep the start.exe path, which resolves unix paths behind /unix.
    if [ "$#" -eq 1 ] && [ -f "$1" ]; then
        case "$1" in
            *.[aA][lL][sS]|*.[aA][lL][cC]|*.[aA][lL][pP])
                require_live
                doc="$(ableton_run_bounded 30 "$WINE_ROOT/bin/winepath" -w "$1" 9>&- 2>/dev/null || true)"
                if [ -n "$doc" ]; then
                    launch_command "${run[@]}" "$EXE" "$doc"
                    exit $?
                fi
                ;;
        esac
        case "$1" in /*) launch_command "${run[@]}" start /w /unix "$1"; exit $? ;; esac
    fi
    launch_command "${run[@]}" start /w "$@"
else
    require_live
    launch_command "${run[@]}" "$EXE"
fi
