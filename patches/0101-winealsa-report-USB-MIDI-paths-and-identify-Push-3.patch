-/* Build the display name winmm exposes for a seq port: "client - port",
- * falling back to the port name alone if that would overflow.  Must stay
- * stable across replug so hotplug re-matching by name works. */
+/* Windows gives each USB MIDI port a KS device interface path. This path
+ * contains the USB ids of the device:
+ *
+ *   \\?\usb#vid_2982&pid_1969&mi_05#7&1e0d0a41&0&0005#{6994ad04-...}
+ *
+ * Applications use the path to find their hardware. Ableton Live looks for
+ * vid_xxxx&pid_xxxx in each MIDI path and starts its Push helper when it finds
+ * the corresponding ids.
+ *
+ * ALSA gives no path. Make one from the USB device behind the sound card. The
+ * instance portion names the ALSA card and port because Linux has no Windows
+ * device-instance id. A port without a USB card keeps reporting no path.
+ *
+ * Push3.exe also expects the first Push 3 port to have the Windows device name.
+ * Scope that name to the Push 3 Live port so every other MIDI name stays stable.
+ */
+static const char midi_ks_category[] = "{6994ad04-93ef-11d0-a3cc-00a0c9223196}";
+
+static BOOL sysfs_read_hex(const char *dir, const char *file, unsigned int *value)
+{
+    char path[512];
+    FILE *f;
+    int ret;
+
+    snprintf(path, sizeof(path), "%s/%s", dir, file);
+    if (!(f = fopen(path, "r"))) return FALSE;
+    ret = fscanf(f, "%x", value);
+    fclose(f);
+    return ret == 1;
+}
+
+/* Find the USB device of an ALSA card. The device link of the card points to one
+ * interface of the USB device. Go up in the tree until a directory has the ids. */
+static BOOL card_usb_ids(int card, unsigned int *vid, unsigned int *pid)
+{
+    char link[64], *dir, *slash;
+
+    *vid = *pid = 0;
+    if (card < 0) return FALSE;
+    snprintf(link, sizeof(link), "/sys/class/sound/card%d/device", card);
+    if (!(dir = realpath(link, NULL))) return FALSE;
+
+    for (;;)
+    {
+        if (sysfs_read_hex(dir, "idVendor", vid) && sysfs_read_hex(dir, "idProduct", pid))
+        {
+            free(dir);
+            return TRUE;
+        }
+        if (!(slash = strrchr(dir, '/')) || slash == dir) break;
+        *slash = 0;
+    }
+    free(dir);
+    return FALSE;
+}
+
+/* Build the name winmm exposes for a seq port. Push3.exe needs the first Push 3
