 #define PIPEASIO_TELEMETRY_CAPACITY 8192u
+#define PIPEASIO_TELEMETRY_OUTPUT_FLAGS (O_WRONLY | O_NONBLOCK | O_CLOEXEC | O_APPEND)
 
