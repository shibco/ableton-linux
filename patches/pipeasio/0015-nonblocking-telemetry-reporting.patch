     if (!state)
         return;
     count   = pipeasio_telemetry_ring_snapshot(&state->ring, &first);
     dropped = atomic_exchange_explicit(&state->ring.dropped, 0, memory_order_relaxed);
+    muted   = atomic_exchange_explicit(&state->muted_cycles, 0, memory_order_relaxed);
     if (!count)
