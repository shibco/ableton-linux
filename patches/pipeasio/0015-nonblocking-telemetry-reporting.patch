 #ifndef PIPEASIO_WOW64_PE
+/* A regular file shares stderr's offset so ordinary logs and telemetry remain
+ * ordered. Pipes and terminals use a separate nonblocking description. */
+static int
+telemetry_open_report_fd(void)
+{
+    struct stat st;
+    if (fstat(STDERR_FILENO, &st) != 0)
+        return -1;
+    if (S_ISFIFO(st.st_mode) || S_ISCHR(st.st_mode))
+        return open("/proc/self/fd/2", PIPEASIO_TELEMETRY_OUTPUT_FLAGS);
+    return dup(STDERR_FILENO);
+}
+
+/* A separate stderr output keeps the lifecycle worker responsive.
+ * A full output drops the current report. Stop and Destroy
+ * continue. */
+static void
+telemetry_log(pipeasio_telemetry_state *state, const char *format, ...)
+{
+    static const char prefix[] = "[pipeasio telemetry] ";
+    char              buffer[1024];
+    va_list           args;
+    int               length;
+    size_t            used = sizeof(prefix) - 1;
+
+    memcpy(buffer, prefix, used);
+    va_start(args, format);
+    length = vsnprintf(buffer + used, sizeof(buffer) - used, format, args);
+    va_end(args);
+    if (length <= 0)
+        return;
+    used += (size_t)length < sizeof(buffer) - used ? (size_t)length : sizeof(buffer) - used - 1;
+    (void)write(state->output_fd, buffer, used);
+}
+
 /* Monotonic time records the full deadline. Thread CPU time records work on
  * the callback thread. Wall time also includes sleep in Live. These clock
  * reads occur while PIPEASIO_TELEMETRY is on. */
