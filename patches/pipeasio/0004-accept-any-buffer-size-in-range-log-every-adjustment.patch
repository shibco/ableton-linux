diff --git a/src/config.c b/src/config.c
--- a/src/config.c
+++ b/src/config.c
@@ -127,10 +127,25 @@
     if (c->outputs < 0 || c->outputs > PIPEASIO_MAX_CHANNELS)
         c->outputs = PIPEASIO_DEFAULT_OUTPUTS;
 
+    /* Any size inside the range passes through as-is: Live accepts sizes
+     * that are not powers of two, and rejecting them here replaced the
+     * user's value in silence (issue #49). Every adjustment is logged. */
     const int b = c->buffer_size;
-    if (!(b > 0 && (b & (b - 1)) == 0 && b >= PIPEASIO_MIN_BUFFER_SIZE
-          && b <= PIPEASIO_MAX_BUFFER_SIZE))
+    if (b <= 0)
+    {
         c->buffer_size = PIPEASIO_DEFAULT_BUFFER_SIZE;
+        fprintf(stderr, "pipeasio: config buffer_size missing or unreadable; "
+                "using %d\n", PIPEASIO_DEFAULT_BUFFER_SIZE);
+    }
+    else if (b < PIPEASIO_MIN_BUFFER_SIZE || b > PIPEASIO_MAX_BUFFER_SIZE)
+    {
+        c->buffer_size = b < PIPEASIO_MIN_BUFFER_SIZE ? PIPEASIO_MIN_BUFFER_SIZE
+                                                      : PIPEASIO_MAX_BUFFER_SIZE;
+        fprintf(stderr, "pipeasio: config buffer_size %d out of range [%d, %d]; "
+                "clamped to %d (pipeasio-any-buffer-size)\n", b,
+                PIPEASIO_MIN_BUFFER_SIZE, PIPEASIO_MAX_BUFFER_SIZE,
+                c->buffer_size);
+    }
 
     if (c->sample_rate < 0)
         c->sample_rate = 0;
diff --git a/src/asio.c b/src/asio.c
--- a/src/asio.c
+++ b/src/asio.c
@@ -1977,13 +1977,27 @@
     if (n > 0 && n < sizeof name_env)
         lstrcpynA(This->client_name, name_env, PIPEASIO_MAX_NAME_LENGTH);
 
-    /* if pipeasio_preferred_buffersize is not a power of two or out of range,
-     * fall back to PIPEASIO_PREFERRED_BUFFERSIZE */
-    if (!(This->pipeasio_preferred_buffersize > 0
-          && !(This->pipeasio_preferred_buffersize & (This->pipeasio_preferred_buffersize - 1))
-          && This->pipeasio_preferred_buffersize >= PIPEASIO_MINIMUM_BUFFERSIZE
-          && This->pipeasio_preferred_buffersize <= PIPEASIO_MAXIMUM_BUFFERSIZE))
+    /* Any size inside the range passes through as-is: Live accepts sizes
+     * that are not powers of two, and substituting the compile-time default
+     * here replaced the user's request in silence (issue #49). */
+    if (This->pipeasio_preferred_buffersize <= 0)
+    {
+        if (This->pipeasio_preferred_buffersize < 0)
+            WARN("preferred buffersize %d unusable; using default %d\n",
+                 (int)This->pipeasio_preferred_buffersize, PIPEASIO_PREFERRED_BUFFERSIZE);
         This->pipeasio_preferred_buffersize = PIPEASIO_PREFERRED_BUFFERSIZE;
+    }
+    else if (This->pipeasio_preferred_buffersize < PIPEASIO_MINIMUM_BUFFERSIZE
+             || This->pipeasio_preferred_buffersize > PIPEASIO_MAXIMUM_BUFFERSIZE)
+    {
+        LONG requested = This->pipeasio_preferred_buffersize;
+        This->pipeasio_preferred_buffersize =
+            requested < PIPEASIO_MINIMUM_BUFFERSIZE ? PIPEASIO_MINIMUM_BUFFERSIZE
+                                                    : PIPEASIO_MAXIMUM_BUFFERSIZE;
+        WARN("preferred buffersize %d out of range [%d, %d]; clamped to %d\n",
+             (int)requested, PIPEASIO_MINIMUM_BUFFERSIZE, PIPEASIO_MAXIMUM_BUFFERSIZE,
+             (int)This->pipeasio_preferred_buffersize);
+    }
 
     return;
 }
