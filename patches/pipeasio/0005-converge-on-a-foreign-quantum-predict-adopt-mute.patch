+/* Non-zero when the settings metadata carries a global clock.force-quantum;
+ * that value outranks every node request (issue #49). */
+audio_nframes_t audio_global_force_quantum(audio_client_t *client);
+
+/* True while the graph quantum disagrees with the host buffer size and the
+ * mismatch fail-safe is armed: the ASIO side swaps silence both ways until
+ * the sizes converge (issue #49). */
+bool audio_quantum_muted(audio_client_t *client);
+
+/* Withdraw this node's forced-quantum request (write node.force-quantum 0)
+ * so the graph keeps the foreign quantum being adopted. */
+void audio_drop_force_quantum(audio_client_t *client);
+
 /* Nanosecond timestamp (PipeWire graph clock) of the most recent process cycle,
  * 0 before the first cycle. Feeds the ASIO host's systemTime. */
 uint64_t audio_get_time_nsec(audio_client_t *client);
