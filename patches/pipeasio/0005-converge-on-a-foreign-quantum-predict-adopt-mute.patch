+static NTSTATUS
+wow64_global_force_quantum(void *args)
+{
+    pa_simple_params *p = args;
+    client_ctx       *cc;
+
+    PAU_CHECK(p);
+    cc = cc_get(p->client);
+    if (!cc)
+        return STATUS_INVALID_HANDLE;
+    p->result = audio_global_force_quantum(cc->client);
+    return STATUS_SUCCESS;
+}
