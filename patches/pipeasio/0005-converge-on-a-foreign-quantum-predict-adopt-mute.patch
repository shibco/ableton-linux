+
+void
+audio_drop_force_quantum(audio_client_t *c)
+{
+    if (!c || !c->filter)
+        return;
+    pw_thread_loop_lock(c->loop);
+    struct spa_dict_item item = SPA_DICT_ITEM_INIT(PW_KEY_NODE_FORCE_QUANTUM, "0");
+    struct spa_dict      dict = SPA_DICT_INIT(&item, 1);
+    pw_filter_update_properties(c->filter, NULL, &dict);
+    pw_thread_loop_unlock(c->loop);
+    /* NODE_LOCK_QUANTUM stays: the graph holds the adopted quantum even if
+     * the foreign forcer leaves, which matches the buffer size the host is
+     * being rebuilt to. */
+    TRACE("dropped node.force-quantum: adopting the graph quantum\n");
+}
