+/* The settings metadata carries the global clock.force-quantum, which
+ * outranks every node's own forced quantum (issue #49).  The ASIO side
+ * offers a non-zero value from GetBufferSize so the host builds matching
+ * buffers from the start. */
+static int
+audio_on_settings_property(void *userdata, uint32_t subject, const char *key, const char *type,
+                           const char *value)
+{
+    audio_client_t *c = userdata;
+    (void)type;
+
+    if (subject != 0)
+        return 0;
+    if (!key) /* all properties cleared */
+    {
+        atomic_store(&c->global_force_quantum, 0u);
+        return 0;
+    }
+    if (strcmp(key, "clock.force-quantum"))
+        return 0;
+
+    uint32_t v = value ? (uint32_t)strtoul(value, NULL, 10) : 0u;
+    atomic_store(&c->global_force_quantum, v);
+    TRACE("settings metadata: clock.force-quantum=%u\n", v);
+    return 0;
+}
