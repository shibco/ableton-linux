+static void
+audio_route_link_info(void *userdata, const struct pw_link_info *info)
+{
+    struct audio_route *route = userdata;
+    if (!info)
+        return;
+    if (info->state == PW_LINK_STATE_PAUSED || info->state == PW_LINK_STATE_ACTIVE)
+    {
+        route->state = PIPEASIO_ROUTE_READY;
+        route->generation = route->client->topology_generation;
+        audio_update_route_ready(route->client, route->direction);
+    }
+    else if (info->state == PW_LINK_STATE_ERROR || info->state == PW_LINK_STATE_UNLINKED)
+    {
+        WARN("hotplug: link entered %s for %s:%s\n", pw_link_state_as_string(info->state),
+             route->target.node_name, route->remote_port_name);
+        if (route->link)
+            pw_proxy_destroy(route->link);
+    }
