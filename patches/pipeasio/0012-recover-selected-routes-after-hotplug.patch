+/* Call with the PipeWire thread-loop held. */
+static bool
+audio_bind_route(struct audio_route *route, audio_port_t *remote)
+{
+    audio_client_t *c = route->client;
+    if (!c->core || !atomic_load_explicit(&c->active, memory_order_acquire) || !route->local
+        || !remote || !route->local->pw_port_id || !remote->pw_port_id
+        || c->our_node_id == SPA_ID_INVALID)
+        return false;
+
+    struct pw_properties *properties = pw_properties_new(PW_KEY_OBJECT_LINGER, "false", NULL);
+    if (!properties)
+        return false;
+    if (route->direction == AUDIO_CAPTURE_LATENCY)
+    {
+        pw_properties_setf(properties, PW_KEY_LINK_OUTPUT_NODE, "%u", remote->pw_node_id);
+        pw_properties_setf(properties, PW_KEY_LINK_OUTPUT_PORT, "%u", remote->pw_port_id);
+        pw_properties_setf(properties, PW_KEY_LINK_INPUT_NODE, "%u", c->our_node_id);
+        pw_properties_setf(properties, PW_KEY_LINK_INPUT_PORT, "%u", route->local->pw_port_id);
+    }
+    else
+    {
+        pw_properties_setf(properties, PW_KEY_LINK_OUTPUT_NODE, "%u", c->our_node_id);
+        pw_properties_setf(properties, PW_KEY_LINK_OUTPUT_PORT, "%u", route->local->pw_port_id);
+        pw_properties_setf(properties, PW_KEY_LINK_INPUT_NODE, "%u", remote->pw_node_id);
+        pw_properties_setf(properties, PW_KEY_LINK_INPUT_PORT, "%u", remote->pw_port_id);
+    }
+    route->link = pw_core_create_object(c->core, "link-factory", PW_TYPE_INTERFACE_Link,
+                                        PW_VERSION_LINK, &properties->dict, 0);
+    pw_properties_free(properties);
+    if (!route->link)
+        return false;
+    route->state = PIPEASIO_ROUTE_LINKING;
+    route->generation = c->topology_generation;
+    route->bound_node_id = remote->pw_node_id;
+    route->bound_port_id = remote->pw_port_id;
+    pw_proxy_add_listener(route->link, &route->proxy_listener, &audio_route_proxy_events, route);
+    pw_link_add_listener((struct pw_link *)route->link, &route->link_listener,
+                         &audio_route_link_events, route);
+    return true;
+}
+
+/* Call on the PipeWire thread-loop after the registry burst settled. */
+static void
+audio_reconcile_routes(audio_client_t *c)
+{
+    if (!atomic_load_explicit(&c->active, memory_order_acquire) || !c->core
+        || atomic_load_explicit(&c->tearing_down, memory_order_acquire))
+        return;
+
+    for (uint32_t direction = AUDIO_PLAYBACK_LATENCY;; direction = AUDIO_CAPTURE_LATENCY)
+    {
+        for (uint32_t i = 0; i < c->n_routes; ++i)
+        {
+            struct audio_route *route = c->routes[i];
+            if (route->direction != direction)
+                continue;
+            bool ambiguous;
+            struct audio_node_info *node = audio_resolve_route_node(route, &ambiguous);
+            audio_port_t *remote = node ? audio_resolve_route_port(route, node) : NULL;
+            if (!remote)
+            {
+                if (route->link)
+                    audio_unbind_route(route);
+                route->state = PIPEASIO_ROUTE_WAIT_TARGET;
+                continue;
+            }
+            if (route->link && route->bound_node_id == remote->pw_node_id
+                && route->bound_port_id == remote->pw_port_id)
+            {
+                route->generation = c->topology_generation;
+                continue;
+            }
+            if (route->link)
+                audio_unbind_route(route);
+            pipeasio_route_identity resolved;
+            audio_node_identity(c, node, &resolved);
+            if (route->explicit_target)
+                audio_identity_fill_missing(&route->target, &resolved);
+            else
+                route->target = resolved;
+            audio_copy_route_string(route->remote_port_name, remote->port_name);
+            route->remote_port_id = remote->port_id;
+            if (!audio_bind_route(route, remote))
+                WARN("hotplug: failed to create %s link for %s:%s\n",
+                     direction == AUDIO_CAPTURE_LATENCY ? "capture" : "playback",
+                     route->target.node_name, route->remote_port_name);
+        }
+        audio_update_route_ready(c, direction);
+        if (direction == AUDIO_CAPTURE_LATENCY)
+            break;
+    }
+}
