+        for (uint32_t j = 0; j < c->n_discovered; ++j)
+            if (c->discovered[j]->pw_node_id == node->id
+                && (c->discovered[j]->flags & required_flags) == required_flags)
+            {
+                has_required_direction = true;
+                break;
+            }
+        pipeasio_route_identity candidate;
+        audio_node_identity(c, node, &candidate);
+        int rank
+                = pipeasio_route_candidate_rank(&route->target, &candidate, has_required_direction);
+        if (rank > best_rank)
+        {
+            best = node;
+            best_rank = rank;
+            *ambiguous = false;
+        }
+        else if (rank && rank == best_rank)
+            *ambiguous = true;
+    }
+    return *ambiguous ? NULL : best;
+}
