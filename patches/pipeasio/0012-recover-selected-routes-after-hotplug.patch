diff --git a/tests/pw_probe/pw_restart_probe.c b/tests/pw_probe/pw_restart_probe.c
new file mode 100644
index 0000000..e809b5f
--- /dev/null
+++ b/tests/pw_probe/pw_restart_probe.c
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE
+#include "audio.h"
+
+#include <stdatomic.h>
+#include <stdio.h>
+#include <unistd.h>
+
+static atomic_uint cycles;
+
+static int
+process_cb(audio_nframes_t nframes, void *arg)
+{
+    (void)nframes;
+    (void)arg;
+    atomic_fetch_add_explicit(&cycles, 1, memory_order_relaxed);
+    return 0;
+}
+
+static bool
+mark(const char *directory, const char *name)
+{
+    char path[1024];
+    if (snprintf(path, sizeof(path), "%s/%s", directory, name) >= (int)sizeof(path))
+        return false;
+    FILE *file = fopen(path, "w");
+    if (!file)
+        return false;
+    fclose(file);
+    return true;
+}
+
+static bool
+exists(const char *directory, const char *name)
+{
+    char path[1024];
+    return snprintf(path, sizeof(path), "%s/%s", directory, name) < (int)sizeof(path)
+           && !access(path, F_OK);
+}
+
+static bool
+wait_marker(const char *directory, const char *name, unsigned seconds)
+{
+    for (unsigned i = 0; i < seconds * 100; ++i)
+    {
+        if (exists(directory, name))
+            return true;
+        usleep(10000);
+    }
+    return false;
+}
+
+static bool
+wait_cycles(unsigned target, unsigned seconds)
+{
+    for (unsigned i = 0; i < seconds * 100; ++i)
+    {
+        if (atomic_load_explicit(&cycles, memory_order_acquire) >= target)
+            return true;
+        usleep(10000);
+    }
+    return false;
+}
+
+int
+main(int argc, char **argv)
+{
+    if (argc != 2)
+        return 2;
+    uint32_t status = AUDIO_STATUS_OK;
+    audio_client_t *client = audio_open("pipeasio.hotplug.probe", AUDIO_NO_START_SERVER, &status);
+    if (!client)
+    {
+        fprintf(stderr, "hotplug probe: audio_open failed, status=%u\n", status);
+        return 1;
+    }
+    audio_port_t *output = audio_port_register(client, "output_1", AUDIO_PORT_IS_OUTPUT, 0);
+    if (!output || !audio_set_process_callback(client, process_cb, NULL)
+        || !audio_activate(client)
+        || !audio_connect_device(client, output, NULL, AUDIO_PORT_IS_INPUT, 0))
+    {
+        fprintf(stderr, "hotplug probe: offline activation/route failed\n");
+        audio_close(client);
+        return 1;
+    }
+    if (!mark(argv[1], "opened") || !wait_marker(argv[1], "started", 10)
+        || !wait_cycles(4, 10))
+    {
+        fprintf(stderr, "hotplug probe: delayed daemon startup did not recover\n");
+        audio_close(client);
+        return 1;
+    }
+    if (!mark(argv[1], "ready") || !wait_marker(argv[1], "restarted", 20))
+    {
+        audio_close(client);
+        return 1;
+    }
+    unsigned before = atomic_load_explicit(&cycles, memory_order_acquire);
+    if (!wait_cycles(before + 4, 15))
+    {
+        fprintf(stderr, "hotplug probe: callbacks did not resume after daemon restart\n");
+        audio_close(client);
+        return 1;
+    }
+    fprintf(stderr, "hotplug probe: PASS delayed startup and restart (%u -> %u cycles)\n",
+            before, atomic_load_explicit(&cycles, memory_order_acquire));
+    audio_deactivate(client);
+    audio_close(client);
+    return 0;
+}
diff --git a/tests/pw_probe/run_restart.sh b/tests/pw_probe/run_restart.sh
new file mode 100755
index 0000000..d10697f
--- /dev/null
+++ b/tests/pw_probe/run_restart.sh
@@ -0,0 +1,71 @@
+#!/bin/sh
+set -eu
+
+probe=${1:?hotplug probe path required}
+command -v pipewire >/dev/null 2>&1 || exit 77
+
+root=$(mktemp -d "${TMPDIR:-/tmp}/pipeasio-hotplug.XXXXXX")
+runtime="$root/runtime"
+state="$root/state"
+mkdir -p "$runtime" "$state"
+daemon_pid=
+probe_pid=
+cleanup()
+{
+    if [ -n "$probe_pid" ]; then kill "$probe_pid" 2>/dev/null || true; fi
+    if [ -n "$daemon_pid" ]; then kill "$daemon_pid" 2>/dev/null || true; fi
+    wait 2>/dev/null || true
+    rm -rf "$root"
+}
+trap cleanup EXIT INT TERM
+
+export XDG_RUNTIME_DIR="$runtime"
+export PIPEWIRE_RUNTIME_DIR="$runtime"
+
+start_daemon()
+{
+    pipewire >"$root/pipewire.log" 2>&1 &
+    daemon_pid=$!
+    i=0
+    while [ ! -S "$runtime/pipewire-0" ]; do
+        if ! kill -0 "$daemon_pid" 2>/dev/null; then exit 77; fi
+        i=$((i + 1))
+        [ "$i" -lt 500 ] || exit 77
+        sleep 0.01
+    done
+}
+
+PIPEASIO_DEBUG=1 "$probe" "$state" >"$root/probe.log" 2>&1 &
+probe_pid=$!
+i=0
+while [ ! -f "$state/opened" ]; do
+    if ! kill -0 "$probe_pid" 2>/dev/null; then
+        wait "$probe_pid" || rc=$?
+        exit "${rc:-1}"
+    fi
+    i=$((i + 1))
+    [ "$i" -lt 500 ] || exit 1
+    sleep 0.01
+done
+
+start_daemon
+touch "$state/started"
+i=0
+while [ ! -f "$state/ready" ]; do
+    if ! kill -0 "$probe_pid" 2>/dev/null; then
+        wait "$probe_pid" || rc=$?
+        exit "${rc:-1}"
+    fi
+    i=$((i + 1))
+    [ "$i" -lt 1500 ] || exit 1
+    sleep 0.01
+done
+
+kill "$daemon_pid"
+wait "$daemon_pid" || true
+daemon_pid=
+start_daemon
+touch "$state/restarted"
+wait "$probe_pid"
+probe_pid=
+echo "pw_restart_probe: delayed startup and daemon restart passed"
