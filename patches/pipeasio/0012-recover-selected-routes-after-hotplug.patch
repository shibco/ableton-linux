+static void
+audio_request_recovery(audio_client_t *c, const char *reason)
+{
+    if (!c || atomic_load_explicit(&c->closing, memory_order_acquire))
+        return;
+    atomic_store_explicit(&c->backend_online, false, memory_order_release);
+    atomic_store_explicit(&c->route_ready[AUDIO_CAPTURE_LATENCY], false, memory_order_release);
+    atomic_store_explicit(&c->route_ready[AUDIO_PLAYBACK_LATENCY], false, memory_order_release);
+    pthread_mutex_lock(&c->recovery_mutex);
+    bool queued = !c->recovery_requested && !c->recovery_in_progress;
+    if (queued)
+        c->recovery_requested = true;
+    pthread_cond_signal(&c->recovery_cond);
+    pthread_mutex_unlock(&c->recovery_mutex);
+    if (queued)
+        WARN("PipeWire backend lost (%s); scheduling recovery\n", reason ? reason : "unknown");
+    else
+        TRACE("PipeWire backend loss coalesced into active recovery (%s)\n",
+              reason ? reason : "unknown");
+}
+
+static void
+audio_on_core_error(void *userdata, uint32_t id, int seq, int res, const char *message)
+{
+    audio_client_t *c = userdata;
+    bool lost = res == -EPIPE || res == -ECONNRESET || res == -ENOTCONN;
+    if (lost && (id == PW_ID_CORE || id == SPA_ID_INVALID))
+    {
+        WARN("PipeWire core connection lost id=%u seq=%d res=%d: %s\n", id, seq, res,
+             message ? message : "unknown");
+        audio_request_recovery(c, "fatal core connection error");
+    }
+    else
+        WARN("PipeWire core object error id=%u seq=%d res=%d (no rebuild): %s\n", id, seq, res,
+             message ? message : "unknown");
+}
+
+static void
+audio_clear_registry_cache(audio_client_t *c)
+{
+    for (uint32_t i = 0; i < c->n_nodes; ++i)
+    {
+        free(c->nodes[i]->node_name);
+        free(c->nodes[i]->display_name);
+        free(c->nodes[i]->media_class);
+        free(c->nodes[i]);
+    }
+    free(c->nodes);
+    c->nodes = NULL;
+    c->n_nodes = c->cap_nodes = 0;
+    for (uint32_t i = 0; i < c->n_discovered; ++i)
+        audio_free_discovered_port(c->discovered[i]);
+    free(c->discovered);
+    c->discovered = NULL;
+    c->n_discovered = c->cap_discovered = 0;
+    for (uint32_t i = 0; i < c->n_devices; ++i)
+        free(c->devices[i]);
+    free(c->devices);
+    c->devices = NULL;
+    c->n_devices = c->cap_devices = 0;
+    c->node_limit_warned = c->port_limit_warned = false;
+    c->chosen_node[0] = c->chosen_node[1] = SPA_ID_INVALID;
+    c->warned_clock_pair[0] = c->warned_clock_pair[1] = SPA_ID_INVALID;
+    c->our_node_id = SPA_ID_INVALID;
+    for (uint32_t i = 0; i < c->n_ports; ++i)
+        c->ports[i]->pw_node_id = c->ports[i]->pw_port_id = c->ports[i]->port_id = 0;
+}
