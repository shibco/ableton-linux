     PAU_RESERVED_13,
-    PAU_RESERVED_14,
+    PAU_CONNECT_DEVICE,
     PAU_PORT_LATENCY_RANGE,
     PAU_RESERVED_16,
     PAU_GET_DEVICE_PORTS,
@@ -189,6 +189,18 @@ typedef struct
