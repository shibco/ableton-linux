+static bool
+audio_recovery_delay(audio_client_t *c, uint32_t milliseconds)
+{
+    struct timespec until;
+    clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_sec += milliseconds / 1000;
+    until.tv_nsec += (long)(milliseconds % 1000) * 1000000L;
+    if (until.tv_nsec >= 1000000000L)
+    {
+        ++until.tv_sec;
+        until.tv_nsec -= 1000000000L;
+    }
+    pthread_mutex_lock(&c->recovery_mutex);
+    if (!atomic_load_explicit(&c->closing, memory_order_acquire))
+        pthread_cond_timedwait(&c->recovery_cond, &c->recovery_mutex, &until);
+    bool keep_going = !atomic_load_explicit(&c->closing, memory_order_acquire);
+    pthread_mutex_unlock(&c->recovery_mutex);
+    return keep_going;
+}
+
+static void *
+audio_recovery_worker(void *userdata)
+{
+    audio_client_t *c = userdata;
+    pthread_mutex_lock(&c->recovery_mutex);
+    for (;;)
+    {
+        while (!atomic_load_explicit(&c->closing, memory_order_acquire)
+               && !c->recovery_requested)
+            pthread_cond_wait(&c->recovery_cond, &c->recovery_mutex);
+        if (atomic_load_explicit(&c->closing, memory_order_acquire))
+            break;
+        c->recovery_requested = false;
+        c->recovery_in_progress = true;
+        pthread_mutex_unlock(&c->recovery_mutex);
+
+        pthread_mutex_lock(&c->lifecycle_mutex);
+        audio_disconnect_backend(c);
+        pthread_mutex_unlock(&c->lifecycle_mutex);
+
+        uint32_t delay_ms = 100;
+        bool recovered = false;
+        while (!atomic_load_explicit(&c->closing, memory_order_acquire))
+        {
+            pthread_mutex_lock(&c->lifecycle_mutex);
+            bool connected = audio_connect_backend(c);
+            bool activated = connected
+                             && (!atomic_load_explicit(&c->desired_active, memory_order_acquire)
+                                 || audio_activate_locked(c));
+            if (activated)
+            {
+                pthread_mutex_lock(&c->recovery_mutex);
+                recovered = atomic_load_explicit(&c->backend_online, memory_order_acquire)
+                            && !atomic_load_explicit(&c->closing, memory_order_acquire);
+                if (recovered)
+                    c->recovery_in_progress = false;
+                pthread_mutex_unlock(&c->recovery_mutex);
+            }
+            if (!recovered)
+                audio_disconnect_backend(c);
+            pthread_mutex_unlock(&c->lifecycle_mutex);
+            if (recovered)
+                break;
+            if (!audio_recovery_delay(c, delay_ms))
+                break;
+            delay_ms = delay_ms < 1000 ? delay_ms * 2u : 2000u;
+        }
+        if (recovered)
+            TRACE("PipeWire recovery: backend and selected routes restored "
+                  "(pipeasio-reliable-hotplug)\n");
+        pthread_mutex_lock(&c->recovery_mutex);
+        if (!recovered)
+            c->recovery_in_progress = false;
+    }
+    pthread_mutex_unlock(&c->recovery_mutex);
+    return NULL;
+}
