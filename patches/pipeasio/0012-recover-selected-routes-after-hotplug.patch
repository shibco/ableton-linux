+bool
+audio_connect_device(audio_client_t *client, audio_port_t *local, const char *node_name,
+                     uint64_t remote_flags, uint32_t ordinal)
+{
+    if (!client || !local
+        || (remote_flags != AUDIO_PORT_IS_INPUT && remote_flags != AUDIO_PORT_IS_OUTPUT))
+        return false;
+    uint32_t direction = remote_flags == AUDIO_PORT_IS_INPUT ? AUDIO_PLAYBACK_LATENCY
+                                                             : AUDIO_CAPTURE_LATENCY;
+    bool result = false;
+    pthread_mutex_lock(&client->lifecycle_mutex);
+    pw_thread_loop_lock(client->loop);
+    bool owned = false;
+    for (uint32_t i = 0; i < client->n_ports; ++i)
+        if (client->ports[i] == local)
+            owned = true;
+    if (!owned || local->node_name
+        || (direction == AUDIO_CAPTURE_LATENCY && local->direction != PW_DIRECTION_INPUT)
+        || (direction == AUDIO_PLAYBACK_LATENCY && local->direction != PW_DIRECTION_OUTPUT))
+        goto done;
+    if (client->n_routes == client->cap_routes)
+    {
+        uint32_t capacity = client->cap_routes ? client->cap_routes * 2u : 16u;
+        struct audio_route **routes = realloc(client->routes,
+                                               (size_t)capacity * sizeof(*routes));
+        if (!routes)
+            goto done;
+        client->routes = routes;
+        client->cap_routes = capacity;
+    }
+    struct audio_route *route = calloc(1, sizeof(*route));
+    if (!route)
+        goto done;
+    route->client = client;
+    route->local = local;
+    route->direction = direction;
+    route->explicit_target = node_name && node_name[0];
+    route->remote_port_id = SPA_ID_INVALID;
+    route->remote_ordinal = ordinal;
+    route->bound_node_id = route->bound_port_id = SPA_ID_INVALID;
+    route->state = PIPEASIO_ROUTE_WAIT_TARGET;
+    if (route->explicit_target)
+    {
+        audio_copy_route_string(route->target.node_name, node_name);
+        uint32_t node_id = audio_find_node_id(client, node_name);
+        if (node_id != SPA_ID_INVALID)
+            audio_node_identity(client, audio_find_node(client, node_id), &route->target);
+    }
+    client->routes[client->n_routes++] = route;
+    atomic_store_explicit(&client->route_ready[direction], false, memory_order_release);
+    audio_schedule_reconcile(client);
+    result = true;
+done:
+    pw_thread_loop_unlock(client->loop);
+    pthread_mutex_unlock(&client->lifecycle_mutex);
+    return result;
+}
