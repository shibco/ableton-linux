+/* Preserve host ports and routes; discard only objects owned by this core. */
+static void
+audio_disconnect_backend(audio_client_t *c)
+{
+    if (!c || !c->loop)
+        return;
+    atomic_store_explicit(&c->backend_online, false, memory_order_release);
+    if (c->filter || c->n_links || atomic_load_explicit(&c->active, memory_order_acquire))
+        audio_teardown_filter(c);
+    atomic_store_explicit(&c->active, false, memory_order_release);
+
+    pw_thread_loop_lock(c->loop);
+    if (c->default_metadata)
+    {
+        spa_hook_remove(&c->default_metadata_listener);
+        pw_proxy_destroy((struct pw_proxy *)c->default_metadata);
+        c->default_metadata = NULL;
+    }
+    if (c->settings_metadata)
+    {
+        spa_hook_remove(&c->settings_metadata_listener);
+        pw_proxy_destroy((struct pw_proxy *)c->settings_metadata);
+        c->settings_metadata = NULL;
+    }
+    for (uint32_t i = 0; i < c->n_nodes; ++i)
+        if (c->nodes[i]->proxy)
+        {
+            spa_hook_remove(&c->nodes[i]->listener);
+            pw_proxy_destroy((struct pw_proxy *)c->nodes[i]->proxy);
+            c->nodes[i]->proxy = NULL;
+        }
+    if (c->registry)
+    {
+        spa_hook_remove(&c->registry_listener);
+        pw_proxy_destroy((struct pw_proxy *)c->registry);
+        c->registry = NULL;
+    }
+    if (c->core)
+    {
+        struct pw_core *core = c->core;
+        spa_hook_remove(&c->core_listener);
+        c->core = NULL;
+        pw_core_disconnect(core);
+    }
+    audio_clear_registry_cache(c);
+    c->n_links = 0;
+    pw_thread_loop_unlock(c->loop);
+
+    c->default_metadata_id = c->settings_metadata_id = SPA_ID_INVALID;
+    c->default_sink_name[0] = c->default_source_name[0] = '\0';
+    c->default_sink_fingerprint = c->default_source_fingerprint = 0;
+    c->default_sink_resolved = c->default_source_resolved = false;
+    c->defaults_baselined = false;
+    c->daemon_version_seen = c->daemon_supported = false;
+    c->sync_seq = c->sync_done_seq = INT_MIN;
+    c->reconcile_seq = c->reconcile_settle_seq = INT_MIN;
+    atomic_store_explicit(&c->foreign_forcers, 0, memory_order_release);
+    atomic_store_explicit(&c->global_force_quantum, 0, memory_order_release);
+    atomic_store_explicit(&c->graph_force_rate, 0, memory_order_release);
+    atomic_store_explicit(&c->device_latency[AUDIO_CAPTURE_LATENCY], 0, memory_order_release);
+    atomic_store_explicit(&c->device_latency[AUDIO_PLAYBACK_LATENCY], 0, memory_order_release);
+    atomic_store_explicit(&c->latency_changed, true, memory_order_release);
+}
+
+static bool
+audio_connect_backend(audio_client_t *c)
+{
+    pw_thread_loop_lock(c->loop);
+    c->core = pw_context_connect(c->ctx, NULL, 0);
+    if (c->core)
+    {
+        pw_core_add_listener(c->core, &c->core_listener, &audio_core_events, c);
+        c->registry = pw_core_get_registry(c->core, PW_VERSION_REGISTRY, 0);
+        if (c->registry)
+            pw_registry_add_listener(c->registry, &c->registry_listener,
+                                     &audio_registry_events, c);
+    }
+    pw_thread_loop_unlock(c->loop);
+    if (!c->core || !c->registry)
+        return false;
+    /* First drain globals, then metadata values bound from those globals. */
+    if (!audio_sync_timeout(c, 2 * SPA_NSEC_PER_SEC) || !c->daemon_version_seen
+        || !c->daemon_supported || !audio_sync_timeout(c, 2 * SPA_NSEC_PER_SEC))
+        return false;
+    pw_thread_loop_lock(c->loop);
+    audio_refresh_defaults(c);
+    c->defaults_baselined = true;
+    atomic_store_explicit(&c->default_changed, false, memory_order_release);
+    pw_thread_loop_unlock(c->loop);
+    atomic_store_explicit(&c->backend_online, true, memory_order_release);
+    return true;
+}
