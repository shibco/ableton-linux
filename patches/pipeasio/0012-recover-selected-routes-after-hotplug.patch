+static uint32_t
+audio_route_count(const audio_client_t *c, uint32_t direction)
+{
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < c->n_routes; ++i)
+        if (c->routes[i]->direction == direction)
+            ++count;
+    return count;
+}
+
+static void
+audio_update_route_ready(audio_client_t *c, uint32_t direction)
+{
+    bool ready = true;
+    for (uint32_t i = 0; i < c->n_routes; ++i)
+    {
+        struct audio_route *route = c->routes[i];
+        if (route->direction == direction
+            && (route->state != PIPEASIO_ROUTE_READY
+                || route->generation != c->topology_generation))
+        {
+            ready = false;
+            break;
+        }
+    }
+    atomic_store_explicit(&c->route_ready[direction], ready, memory_order_release);
+}
+
+/* Call on the PipeWire thread-loop. Two core round-trips debounce the registry
+ * burst for a device into one complete topology generation. */
+static void
+audio_schedule_reconcile(audio_client_t *c)
+{
+    if (!c->core || atomic_load_explicit(&c->closing, memory_order_acquire)
+        || atomic_load_explicit(&c->tearing_down, memory_order_acquire))
+        return;
+    ++c->topology_generation;
+    c->reconcile_settle_seq = INT_MIN;
+    c->reconcile_seq = pw_core_sync(c->core, PW_ID_CORE, c->reconcile_seq);
+}
+
+static void
+audio_route_lost(struct audio_route *route, const char *reason)
+{
+    audio_client_t *c = route->client;
+    route->state = PIPEASIO_ROUTE_WAIT_TARGET;
+    route->generation = 0;
+    route->bound_node_id = route->bound_port_id = SPA_ID_INVALID;
+    atomic_store_explicit(&c->route_ready[route->direction], false, memory_order_release);
+    if (!route->destroying
+        && !atomic_load_explicit(&c->tearing_down, memory_order_acquire))
+    {
+        WARN("hotplug: %s route %s; waiting for selected device\n",
+             route->direction == AUDIO_CAPTURE_LATENCY ? "capture" : "playback", reason);
+        audio_schedule_reconcile(c);
+    }
+}
