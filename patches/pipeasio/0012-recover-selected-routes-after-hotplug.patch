diff --git a/include/pipeasio_hotplug.h b/include/pipeasio_hotplug.h
new file mode 100644
index 0000000..58f4ecf
--- /dev/null
+++ b/include/pipeasio_hotplug.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define PIPEASIO_ROUTE_NAME_MAX 256u
+
+typedef struct
+{
+    char node_name[PIPEASIO_ROUTE_NAME_MAX];
+    char device_name[PIPEASIO_ROUTE_NAME_MAX];
+    char serial[PIPEASIO_ROUTE_NAME_MAX];
+    char bus_path[PIPEASIO_ROUTE_NAME_MAX];
+    char bus_id[PIPEASIO_ROUTE_NAME_MAX];
+    char alsa_path[PIPEASIO_ROUTE_NAME_MAX];
+    char vendor_id[PIPEASIO_ROUTE_NAME_MAX];
+    char product_id[PIPEASIO_ROUTE_NAME_MAX];
+} pipeasio_route_identity;
+
+enum pipeasio_route_state
+{
+    PIPEASIO_ROUTE_WAIT_TARGET = 0,
+    PIPEASIO_ROUTE_LINKING,
+    PIPEASIO_ROUTE_READY,
+};
+
+int pipeasio_route_identity_rank(const pipeasio_route_identity *saved,
+                                 const pipeasio_route_identity *candidate);
+int pipeasio_route_candidate_rank(const pipeasio_route_identity *saved,
+                                  const pipeasio_route_identity *candidate,
+                                  int                            has_required_direction);
+typedef struct
+{
+    const char *name;
+    uint32_t    id;
+} pipeasio_route_port_candidate;
+
+/* Prefer a unique semantic name. Duplicate names require the saved channel id
+ * or, after ids change, the stable configured ordinal. */
+int pipeasio_route_choose_port(const char *saved_name, uint32_t saved_id, uint32_t ordinal,
+                               const pipeasio_route_port_candidate *ports, size_t count);
