+static audio_port_t *
+audio_resolve_route_port(struct audio_route *route, const struct audio_node_info *node)
+{
+    audio_client_t *c = route->client;
+    uint64_t flags = route->direction == AUDIO_PLAYBACK_LATENCY ? AUDIO_PORT_IS_INPUT
+                                                                : AUDIO_PORT_IS_OUTPUT;
+    uint32_t count = 0;
+    audio_port_t **ports = audio_collect_device_port_objects(c, node->node_name, flags, &count);
+    audio_port_t *match = NULL;
+    pipeasio_route_port_candidate *candidates
+            = count ? malloc((size_t)count * sizeof(*candidates)) : NULL;
+    if (candidates)
+    {
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            candidates[i].name = ports[i]->port_name;
+            candidates[i].id = ports[i]->port_id;
+        }
+        int index = pipeasio_route_choose_port(route->remote_port_name, route->remote_port_id,
+                                               route->remote_ordinal, candidates, count);
+        if (index >= 0)
+            match = ports[index];
+    }
+    free(candidates);
+    free(ports);
+    return match;
+}
