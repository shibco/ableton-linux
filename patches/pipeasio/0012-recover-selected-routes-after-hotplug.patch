+{
+    uint32_t  version;
+    pa_handle client;
+    pa_handle port;
+    uint32_t  flags;
+    uint32_t  ordinal;
+    char      node[PAU_PORTNAME_MAX];
+    uint32_t  ok; /* out */
+} pa_connect_device_params;
+
 /* PAU_LOAD_CONFIG: pipeasio_config_load(&cfg) -> found. */
 typedef struct
 {
