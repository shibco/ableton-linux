diff --git a/src/hotplug.c b/src/hotplug.c
new file mode 100644
index 0000000..733baf9
--- /dev/null
+++ b/src/hotplug.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pipeasio_hotplug.h"
+
+#include <stdbool.h>
+#include <string.h>
+
+static bool
+same_nonempty(const char *a, const char *b)
+{
+    return a[0] && b[0] && !strcmp(a, b);
+}
+
+static bool
+matches_saved(const char *saved, const char *candidate)
+{
+    return !saved[0] || (candidate[0] && !strcmp(saved, candidate));
+}
+
+/* Two known physical locators that are both present but differ prove the
+ * candidate sits at a different place on the bus: a different unit, or an
+ * identical serial-less sibling.  Either way a serial-less device that moved
+ * must be reselected by the performer, never silently adopted. */
+static bool
+locator_conflict(const char *saved, const char *candidate)
+{
+    return saved[0] && candidate[0] && strcmp(saved, candidate);
+}
+
+int
+pipeasio_route_identity_rank(const pipeasio_route_identity *saved,
+                             const pipeasio_route_identity *candidate)
+{
+    if (!saved || !candidate)
+        return 0;
+
+    /* Never let a reused friendly name bypass a known hardware conflict. */
+    if (!matches_saved(saved->vendor_id, candidate->vendor_id)
+        || !matches_saved(saved->product_id, candidate->product_id))
+        return 0;
+    if (saved->serial[0])
+    {
+        if (!matches_saved(saved->serial, candidate->serial))
+            return 0;
+        return same_nonempty(saved->node_name, candidate->node_name) ? 6 : 5;
+    }
+    if (locator_conflict(saved->bus_path, candidate->bus_path)
+        || locator_conflict(saved->bus_id, candidate->bus_id)
+        || locator_conflict(saved->alsa_path, candidate->alsa_path))
+        return 0;
+    if (same_nonempty(saved->bus_path, candidate->bus_path))
+        return same_nonempty(saved->node_name, candidate->node_name) ? 6 : 4;
+    if (same_nonempty(saved->bus_id, candidate->bus_id))
+        return same_nonempty(saved->node_name, candidate->node_name) ? 6 : 3;
+    if (same_nonempty(saved->alsa_path, candidate->alsa_path))
+        return same_nonempty(saved->node_name, candidate->node_name) ? 6 : 2;
+    if (same_nonempty(saved->node_name, candidate->node_name))
+        return 2;
+    if (same_nonempty(saved->device_name, candidate->device_name))
+        return 1;
+    return 0;
+}
+
+int
+pipeasio_route_candidate_rank(const pipeasio_route_identity *saved,
+                              const pipeasio_route_identity *candidate, int has_required_direction)
+{
+    return has_required_direction ? pipeasio_route_identity_rank(saved, candidate) : 0;
+}
+
+int
+pipeasio_route_choose_port(const char *saved_name, uint32_t saved_id, uint32_t ordinal,
+                           const pipeasio_route_port_candidate *ports, size_t count)
+{
+    int name_index = -1;
+    int id_index = -1;
+    size_t name_matches = 0;
+    size_t id_matches = 0;
+    if (!ports)
+        return -1;
+    for (size_t i = 0; i < count; ++i)
+    {
+        if (saved_name && saved_name[0] && ports[i].name
+            && !strcmp(saved_name, ports[i].name))
+        {
+            name_index = (int)i;
+            ++name_matches;
+        }
+        if (saved_id != UINT32_MAX && saved_id == ports[i].id)
+        {
+            id_index = (int)i;
+            ++id_matches;
+        }
+    }
+    if (name_matches == 1)
+        return name_index;
+    if (id_matches == 1)
+        return id_index;
+    return ordinal < count ? (int)ordinal : -1;
+}
