+/* Call with the PipeWire thread-loop held. */
+static void
+audio_unbind_route(struct audio_route *route)
+{
+    if (!route)
+        return;
+    if (route->link)
+    {
+        route->destroying = true;
+        pw_proxy_destroy(route->link);
+        route->destroying = false;
+    }
+    route->link = NULL;
+    route->state = PIPEASIO_ROUTE_WAIT_TARGET;
+    route->generation = 0;
+    route->bound_node_id = route->bound_port_id = SPA_ID_INVALID;
+    atomic_store_explicit(&route->client->route_ready[route->direction], false,
+                          memory_order_release);
+}
+
+static void
+audio_unbind_all_routes(audio_client_t *c)
+{
+    if (!c->loop)
+        return;
+    pw_thread_loop_lock(c->loop);
+    for (uint32_t i = 0; i < c->n_routes; ++i)
+        audio_unbind_route(c->routes[i]);
+    pw_thread_loop_unlock(c->loop);
+    audio_update_route_ready(c, AUDIO_CAPTURE_LATENCY);
+    audio_update_route_ready(c, AUDIO_PLAYBACK_LATENCY);
+}
+
+static void
+audio_destroy_routes(audio_client_t *c)
+{
+    if (c->loop)
+        pw_thread_loop_lock(c->loop);
+    for (uint32_t i = 0; i < c->n_routes; ++i)
+    {
+        audio_unbind_route(c->routes[i]);
+        free(c->routes[i]);
+    }
+    free(c->routes);
+    c->routes = NULL;
+    c->n_routes = c->cap_routes = 0;
+    atomic_store_explicit(&c->route_ready[AUDIO_CAPTURE_LATENCY], true, memory_order_release);
+    atomic_store_explicit(&c->route_ready[AUDIO_PLAYBACK_LATENCY], true, memory_order_release);
+    if (c->loop)
+        pw_thread_loop_unlock(c->loop);
+}
