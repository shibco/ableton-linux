+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pipeasio_hotplug.h"
+#include "test_helpers.h"
+
+#include <string.h>
+
+static pipeasio_route_identity
+identity(const char *node, const char *device, const char *serial, const char *path,
+         const char *vendor, const char *product)
+{
+    pipeasio_route_identity result = { 0 };
+#define COPY(field, value)                                                                         \
+    do                                                                                             \
+    {                                                                                              \
+        if (value)                                                                                 \
+            strncpy(result.field, value, sizeof(result.field) - 1);                                \
+    } while (0)
+    COPY(node_name, node);
+    COPY(device_name, device);
+    COPY(serial, serial);
+    COPY(bus_path, path);
+    COPY(vendor_id, vendor);
+    COPY(product_id, product);
+#undef COPY
+    return result;
+}
+
+int
+main(void)
+{
+    pipeasio_route_identity saved = identity("alsa_output.usb-old", "alsa_card.usb", "ABC",
+                                             "pci-1-usb-2", "1234", "5678");
+    pipeasio_route_identity same = identity("alsa_output.usb-old", "other", "ABC",
+                                            "pci-1-usb-2", "1234", "5678");
+    pipeasio_route_identity reused = identity("alsa_output.usb-old", "other", "other", "other",
+                                              "1234", "9999");
+    pipeasio_route_identity moved = identity("alsa_output.usb-new", "other", "ABC",
+                                             "pci-1-usb-7", "1234", "5678");
+    pipeasio_route_identity saved_path = identity("old", "card", NULL, "pci-1-usb-2",
+                                                  "1234", "5678");
+    pipeasio_route_identity same_path = identity("new", "other", NULL, "pci-1-usb-2",
+                                                 "1234", "5678");
+    pipeasio_route_identity moved_path
+            = identity("old", "other", NULL, "pci-1-usb-7", "1234", "5678");
+    pipeasio_route_identity duplex_peer
+            = identity("alsa_input.usb-new", "other", "ABC", "pci-1-usb-7", "1234", "5678");
+
+    EXPECT_EQ(pipeasio_route_identity_rank(&saved, &same), 6);
+    EXPECT_EQ(pipeasio_route_identity_rank(&saved, &reused), 0);
+    EXPECT_EQ(pipeasio_route_identity_rank(&saved, &moved), 5);
+    EXPECT_EQ(pipeasio_route_identity_rank(&saved_path, &same_path), 4);
+    /* A serial-less device seen at a different known bus path is a conflict:
+     * it may be an identical sibling, so it must be reselected, not adopted. */
+    EXPECT_EQ(pipeasio_route_identity_rank(&saved_path, &moved_path), 0);
+    EXPECT_EQ(pipeasio_route_candidate_rank(&saved, &duplex_peer, 0), 0);
+    EXPECT_EQ(pipeasio_route_candidate_rank(&saved, &moved, 1), 5);
+
+    /* Two identical serial-less interfaces: same friendly names and USB ids,
+     * only the bus path differs.  The sibling must never outrank a conflict. */
+    pipeasio_route_identity twin_saved
+            = identity("Scarlett", "Focusrite Scarlett", NULL, "pci-0-usb-1", "1235", "8210");
+    pipeasio_route_identity twin_sibling
+            = identity("Scarlett", "Focusrite Scarlett", NULL, "pci-0-usb-4", "1235", "8210");
+    pipeasio_route_identity twin_same
+            = identity("Scarlett", "Focusrite Scarlett", NULL, "pci-0-usb-1", "1235", "8210");
+    EXPECT_EQ(pipeasio_route_identity_rank(&twin_saved, &twin_sibling), 0);
+    EXPECT_EQ(pipeasio_route_identity_rank(&twin_saved, &twin_same), 6);
+
+    pipeasio_route_port_candidate duplicate_names[] = {
+        { "playback", 10 }, { "playback", 11 }, { "phones", 12 },
+    };
+    EXPECT_EQ(pipeasio_route_choose_port("playback", 11, 0, duplicate_names, 3), 1);
+    EXPECT_EQ(pipeasio_route_choose_port("playback", 99, 1, duplicate_names, 3), 1);
+    EXPECT_EQ(pipeasio_route_choose_port("phones", 10, 0, duplicate_names, 3), 2);
+    EXPECT_EQ(pipeasio_route_choose_port(NULL, UINT32_MAX, 2, duplicate_names, 3), 2);
+    return test_report();
+}
