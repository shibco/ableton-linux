+static void
+audio_remove_cached_node(audio_client_t *client, uint32_t index)
+{
+    struct audio_node_info *node = client->nodes[index];
+    if (node->foreign_forcer)
+        atomic_fetch_sub_explicit(&client->foreign_forcers, 1, memory_order_acq_rel);
+    if (node->proxy)
+    {
+        spa_hook_remove(&node->listener);
+        pw_proxy_destroy((struct pw_proxy *)node->proxy);
+    }
+    for (uint32_t i = 0; i < client->n_discovered;)
+    {
+        if (client->discovered[i]->pw_node_id != node->id)
+        {
+            ++i;
+            continue;
+        }
+        audio_free_discovered_port(client->discovered[i]);
+        memmove(&client->discovered[i], &client->discovered[i + 1],
+                (size_t)(client->n_discovered - i - 1) * sizeof(*client->discovered));
+        --client->n_discovered;
+    }
+    if (client->chosen_node[0] == node->id)
+        client->chosen_node[0] = SPA_ID_INVALID;
+    if (client->chosen_node[1] == node->id)
+        client->chosen_node[1] = SPA_ID_INVALID;
+    free(node->node_name);
+    free(node->display_name);
+    free(node->media_class);
+    free(node);
+    memmove(&client->nodes[index], &client->nodes[index + 1],
+            (size_t)(client->n_nodes - index - 1) * sizeof(*client->nodes));
+    --client->n_nodes;
+}
+
+/* After PipeWire assigns the filter ID, the activation caller classifies
+ * same-name sessions again after audio_sync(). The reclassification acquires
+ * the PipeWire loop lock while it updates cached nodes. */
+static void
+audio_reclassify_nodes(audio_client_t *client)
+{
+    if (!client || client->our_node_id == SPA_ID_INVALID)
+        return;
+    pw_thread_loop_lock(client->loop);
+    for (uint32_t i = 0; i < client->n_nodes; ++i)
+    {
+        struct audio_node_info *node = client->nodes[i];
+        pipeasio_node_classification classification
+                = pipeasio_classify_node(node->id, client->our_node_id, node->node_name,
+                                         client->name, node->media_class,
+                                         node->pipeasio_signature);
+        bool is_ours = classification == PIPEASIO_NODE_OURS;
+        if (node->is_ours != is_ours)
+        {
+            node->is_ours = is_ours;
+            audio_recount_node_forcer(node);
+            TRACE("registry: reclassified node id=%u as %s after own id=%u "
+                  "(pipeasio-node-arbitration)\n",
+                  node->id, is_ours ? "ours" : "foreign", client->our_node_id);
+        }
+    }
+    audio_refresh_defaults(client);
+    pw_thread_loop_unlock(client->loop);
+}
