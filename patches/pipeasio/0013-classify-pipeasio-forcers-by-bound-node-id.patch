From debb1b271651aef7ea1b7fe93f598d9641cce82b Mon Sep 17 00:00:00 2001
From: Shibco <cade@parare.al>
Date: Wed, 26 Aug 2026 03:43:35 +0200
Subject: [PATCH] audio: classify PipeASIO forcers by bound node id

Admit media.class-less PipeASIO filters with their registry-visible
Audio/Duplex/DSP signature, accepting an absent pipeasio.node marker. Retain
raw force-quantum state during the pre-bind name window, then make the bound
filter id authoritative and reclassify same-name peers.

Cover two 128/256 instances, adoption and restoration, and malformed
signatures with deterministic native tests.
---
 include/pipeasio_parse.h |  56 ++++++++++++++
 src/audio.c              | 180 ++++++++++++++++++++++++++++++++--------------
 tests/unit/test_config.c |  67 +++++++++++++++++
 3 files changed, 249 insertions(+), 54 deletions(-)

diff --git a/include/pipeasio_parse.h b/include/pipeasio_parse.h
index 4e79eb5..c23da44 100644
--- a/include/pipeasio_parse.h
+++ b/include/pipeasio_parse.h
@@ -103,6 +103,49 @@ pipeasio_ascii_equal_ci(const char *left, const char *right)
     return !*left && !*right;
 }

+typedef enum
+{
+    PIPEASIO_NODE_IGNORE = 0,
+    PIPEASIO_NODE_OURS,
+    PIPEASIO_NODE_FOREIGN,
+} pipeasio_node_classification;
+
+/* The registry-visible media properties identify a PipeASIO filter before
+ * PipeWire assigns its ID. Validate the optional pipeasio.node marker when
+ * the registry includes it. */
+static inline bool
+pipeasio_node_signature(const char *marker, const char *media_type, const char *media_category,
+                        const char *media_role)
+{
+    return media_type && media_category && media_role && (!marker || !strcmp(marker, "1"))
+           && !strcmp(media_type, "Audio") && !strcmp(media_category, "Duplex")
+           && !strcmp(media_role, "DSP");
+}
+
+/* A matching audio name identifies this session until PipeWire assigns
+ * its filter ID. The assigned ID then takes priority.
+ * Same-name Live or PipeASIO sessions remain separate after
+ * assignment. */
+static inline pipeasio_node_classification
+pipeasio_classify_node(uint32_t node_id, uint32_t our_node_id, const char *node_name,
+                       const char *our_node_name, const char *media_class,
+                       bool pipeasio_signature)
+{
+    bool audio_class = media_class && strstr(media_class, "Audio")
+                       && !strstr(media_class, "Internal");
+    if (node_id == UINT32_MAX)
+        return PIPEASIO_NODE_IGNORE;
+    if (our_node_id != UINT32_MAX)
+    {
+        if (node_id == our_node_id)
+            return PIPEASIO_NODE_OURS;
+    }
+    else if ((pipeasio_signature || audio_class) && node_name && our_node_name
+             && !strcmp(node_name, our_node_name))
+        return PIPEASIO_NODE_OURS;
+    return pipeasio_signature || audio_class ? PIPEASIO_NODE_FOREIGN : PIPEASIO_NODE_IGNORE;
+}
+
 /* Update one cached node.force-quantum state from a complete PipeWire node
  * property dictionary.  The return value is the delta for the aggregate
  * foreign-forcer count: +1 for 0 -> Q, -1 for Q -> 0 (or absent/invalid),
@@ -120,6 +163,19 @@ pipeasio_quantum_forcer_transition(bool *forced, const char *value)
     return next ? 1 : -1;
 }

+/* Count a buffer request when it belongs to another session.
+ * Count again after PipeWire identifies our filter. The second count
+ * assigns a same-name peer's saved request to that peer. */
+static inline int
+pipeasio_quantum_forcer_count_transition(bool *counted, bool is_ours, bool forced)
+{
+    bool next = !is_ours && forced;
+    if (!counted || next == *counted)
+        return 0;
+    *counted = next;
+    return next ? 1 : -1;
+}
+
 /* Commit a successful foreign-quantum rebuild.  A graph-wide force predicted
  * before CreateBuffers has no pending reset target, so it must be recorded
  * explicitly here or its later Q -> 0 transition cannot restore the user's
