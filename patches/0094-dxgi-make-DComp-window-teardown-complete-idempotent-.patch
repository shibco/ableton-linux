+/* WINE_DCOMP_TEARDOWN=legacy restores the pre-0094 swapchain-release
+ * teardown (window-owning cleanup only on the owning thread, skipped
+ * otherwise) for comparison. */
+BOOL dcomp_teardown_legacy(void)
+{
+    static int legacy = -1;
+
+    if (legacy == -1)
+    {
+        WCHAR val[8] = {0};
+        legacy = GetEnvironmentVariableW(L"WINE_DCOMP_TEARDOWN", val, ARRAY_SIZE(val))
+                && !wcscmp(val, L"legacy");
+    }
+    return legacy;
+}
+
+/* Complete, idempotent teardown of a subclassed DComp target window:
+ * timers, subclass, window properties, popup-stack entry, active count
+ * and parent clip restore.  Must run on the window's owning thread
+ * (KillTimer and SetWindowLongPtrW are thread-affine); a cross-thread
+ * swapchain Release marshals here via WM_WINE_DCOMP_TEARDOWN.  The
+ * __wine_dcomp_subclassed marker makes the count/stack/clip effects
+ * one-shot however many of Release, the marshalled message and
+ * WM_NCDESTROY run for the same window. */
+void dcomp_teardown_window(HWND hwnd)
+{
+    WNDPROC orig = (WNDPROC)GetPropW(hwnd, L"__wine_dcomp_orig_wndproc");
+    WNDPROC current;
+
+    if (!GetPropW(hwnd, L"__wine_dcomp_subclassed")) return; /* already torn down */
+    RemovePropW(hwnd, L"__wine_dcomp_subclassed");
+
+    KillTimer(hwnd, DCOMP_REBLIT_TIMER_ID);
+    KillTimer(hwnd, DCOMP_POPUP_REBLIT_TIMER_ID);
+    KillTimer(hwnd, DCOMP_RESIZE_REBLIT_TIMER_ID);
+
+    /* Only unhook while one of our procs is still the current wndproc:
+     * if something subclassed the window after us, restoring orig here
+     * would cut that outer chain.  Leave the chain and the orig property
+     * in place so our proc keeps forwarding. */
+    current = (WNDPROC)GetWindowLongPtrW(hwnd, GWLP_WNDPROC);
+    if (orig && (current == dcomp_target_wndproc || current == dcomp_popup_wndproc))
+    {
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)orig);
+        RemovePropW(hwnd, L"__wine_dcomp_orig_wndproc");
+    }
+
+    InterlockedDecrement(&dcomp_subclassed_target_count);
+    dcomp_update_active_prop();
+    dcomp_popup_stack_remove(hwnd);
+    dcomp_restore_parent_clip(hwnd);
+
+    RemovePropW(hwnd, L"__wine_dcomp_comp_dc");
+    RemovePropW(hwnd, L"__wine_dcomp_comp_size");
+    RemovePropW(hwnd, L"__wine_dcomp_comp_bits");
+    RemovePropW(hwnd, L"__wine_dcomp_last_present");
+    RemovePropW(hwnd, L"__wine_dcomp_reblit_tries");
+    RemovePropW(hwnd, L"__wine_dcomp_popup_parent");
+    dcomp_clear_null_device_props(hwnd);
+    TRACE_(wmtrace)("DCOMP-TEARDOWN hwnd=%p\n", hwnd);
+}
