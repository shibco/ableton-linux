 dlls/winex11.drv/mouse.c | 259 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 259 insertions(+)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index e118ae1..2d7a230 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -29,6 +29,7 @@
 #include <dlfcn.h>
 #include <X11/Xlib.h>
 #include <X11/cursorfont.h>
+#include <X11/keysym.h>
 #include <stdarg.h>
 #include <stdlib.h>
 #include <string.h>
@@ -129,6 +130,9 @@ static Cursor create_cursor( HANDLE handle );
 #ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
 static BOOL xinput2_available;
 static BOOL broken_rawevents;
+#ifdef XI_GesturePinchBegin
+static BOOL xinput2_gestures;
+#endif
 #define MAKE_FUNCPTR(f) static typeof(f) * p##f
 MAKE_FUNCPTR(XIGetClientPointer);
 MAKE_FUNCPTR(XIFreeDeviceInfo);
@@ -136,6 +140,56 @@ MAKE_FUNCPTR(XIQueryDevice);
 MAKE_FUNCPTR(XIQueryVersion);
 MAKE_FUNCPTR(XISelectEvents);
 #undef MAKE_FUNCPTR
+
+#ifdef XI_GesturePinchBegin
+/***********************************************************************
+ *              pinch_zoom_enabled
+ *
+ * Report a touchpad pinch as the Ctrl+wheel input Win32 applications zoom
+ * with. WINE_X11_PINCH_ZOOM=off keeps the XInput2 version at 2.2 and leaves
+ * gesture events with the X server.
+ */
+static BOOL pinch_zoom_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv( "WINE_X11_PINCH_ZOOM" );
+        if (!value) enabled = TRUE;
+        else if (!strcmp( value, "on" ) || !strcmp( value, "1" ) || !strcmp( value, "notch" )) enabled = TRUE;
+        else if (!strcmp( value, "off" ) || !strcmp( value, "0" )) enabled = FALSE;
+        else
+        {
+            WARN( "unrecognized WINE_X11_PINCH_ZOOM=%s, disabling pinch zoom\n", debugstr_a( value ));
+            enabled = FALSE;
+        }
+    }
+    return enabled;
+}
+
+/***********************************************************************
+ *              pinch_zoom_notched
+ *
+ * WINE_X11_PINCH_ZOOM=notch reports whole wheel notches instead of following
+ * the pinch continuously, for an application that ignores the part of a
+ * notch a precision touchpad reports.
+ */
+static BOOL pinch_zoom_notched(void)
+{
+    static int notched = -1;
+    const char *value;
+
+    if (notched == -1)
+    {
+        value = getenv( "WINE_X11_PINCH_ZOOM" );
+        notched = value && !strcmp( value, "notch" );
+    }
+    return notched;
+}
+#endif
+
 #endif
 
 /***********************************************************************
@@ -305,6 +359,14 @@ void x11drv_xinput2_enable( Display *display, Window window )
         XISetMask( mask_bits, XI_TouchBegin );
         XISetMask( mask_bits, XI_TouchUpdate );
         XISetMask( mask_bits, XI_TouchEnd );
+#ifdef XI_GesturePinchBegin
+        if (xinput2_gestures)
+        {
+            XISetMask( mask_bits, XI_GesturePinchBegin );
+            XISetMask( mask_bits, XI_GesturePinchUpdate );
+            XISetMask( mask_bits, XI_GesturePinchEnd );
+        }
+#endif
     }
 
     pXISelectEvents( display, window, &mask, 1 );
@@ -346,6 +408,23 @@ void x11drv_xinput2_init( struct x11drv_thread_data *data )
     XIEventMask mask;
     int count;
 
+#ifdef XI_GesturePinchBegin
+    /* gesture events need version 2.4, and the server refuses to select them
+     * for a client that asked for less, so only raise the request when they
+     * are wanted */
+    if (pinch_zoom_enabled()) minor = 4;
+#else
+    {
+        static BOOL pinch_zoom_warned;
+
+        if (!pinch_zoom_warned && getenv( "WINE_X11_PINCH_ZOOM" ))
+        {
+            pinch_zoom_warned = TRUE;
+            WARN( "WINE_X11_PINCH_ZOOM is set, but gesture events were not compiled in (old XInput2 headers)\n" );
+        }
+    }
+#endif
+
     if (!xinput2_available || pXIQueryVersion( data->display, &major, &minor ))
     {
         WARN( "XInput 2.0 not available\n" );
@@ -353,6 +432,12 @@ void x11drv_xinput2_init( struct x11drv_thread_data *data )
         return;
     }
 
+#ifdef XI_GesturePinchBegin
+    xinput2_gestures = pinch_zoom_enabled() && (major > 2 || minor >= 4);
+    if (pinch_zoom_enabled() && !xinput2_gestures)
+        WARN( "XInput2 %d.%d has no gesture events, pinch zoom unavailable\n", major, minor );
+#endif
+
     mask.mask     = mask_bits;
     mask.mask_len = sizeof(mask_bits);
     mask.deviceid = XIAllMasterDevices;
@@ -1923,6 +2008,172 @@ static BOOL X11DRV_TouchEvent( HWND hwnd, XGenericEventCookie *xev )
     return TRUE;
 }
 
+#ifdef XI_GesturePinchBegin
+
+/***********************************************************************
+ *           X11DRV_GesturePinchEvent
+ *
+ * Report a touchpad pinch as the wheel input a Windows precision touchpad
+ * sends for one: the scale change becomes wheel movement held with Ctrl, so
+ * an application that zooms on Ctrl+wheel zooms on a pinch.
+ *
+ * A pinch reports a scale many times a second, so each report is worth a
+ * fraction of a notch. WHEEL_DELTA is a unit, not a minimum: a precision
+ * touchpad sends part of it too, and an application that follows the amount
+ * rather than counting messages zooms continuously. WINE_X11_PINCH_ZOOM=notch
+ * rounds to whole notches instead, for an application that ignores the rest.
+ *
+ * Ctrl is pressed once at gesture begin and released once at gesture end,
+ * not around every update: at gesture rate a press, wheel and release per
+ * update would each force a wineserver round trip, and the application
+ * would see a real Ctrl key down/up pair for every tick instead of one per
+ * gesture. The wheel position is the pointer position frozen at gesture
+ * begin, because a precision touchpad pinch never moves the cursor: the
+ * pinch focal point wanders with the fingers, and reporting it would drag
+ * the cursor across the screen. Both the baseline scale and the anchor are
+ * tracked per XInput2 device, so two concurrent pinch sources do not
+ * interleave updates against one baseline.
+ */
+static BOOL X11DRV_GesturePinchEvent( XGenericEventCookie *xev )
+{
+    /* scale change one whole wheel notch stands for */
+    static const double zoom_step = 1.1;
+    static const int max_delta = 16 * WHEEL_DELTA;
+    static struct
+    {
+        int deviceid;    /* device with a gesture in progress, 0 = free slot */
+        HWND hwnd;       /* window the gesture reports to */
+        POINT anchor;    /* pointer position frozen at gesture begin */
+        double scale;    /* scale already reported as wheel movement */
+    } gestures[4];
+    static unsigned int active;  /* gestures in progress */
+    static BOOL ctrl_held;       /* a synthesized Ctrl is held for them */
+
+    XIGesturePinchEvent *event = xev->data;
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    POINT pt = { event->event_x, event->event_y }, root = { event->root_x, event->root_y };
+    INPUT ctrl = { .type = INPUT_KEYBOARD, .ki = { .wVk = VK_LCONTROL, .wScan = 0x1d, .time = time } };
+    double units;
+    int delta, i, slot = -1, free_slot = -1;
+    HWND hwnd;
+
+    for (i = 0; i < ARRAY_SIZE( gestures ); i++)
+    {
+        if (gestures[i].deviceid == event->deviceid) slot = i;
+        else if (!gestures[i].deviceid && free_slot == -1) free_slot = i;
+    }
+
+    if (event->evtype == XI_GesturePinchBegin)
+    {
+        Window root_win, child;
+        int x, y, win_x, win_y;
+        unsigned int xstate;
+
+        if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+        if (slot == -1)
+        {
+            if ((slot = free_slot) == -1)
+            {
+                WARN( "no free pinch gesture slot for device %d\n", event->deviceid );
+                return FALSE;
+            }
+            memset( &gestures[slot], 0, sizeof(gestures[slot]) );
+            gestures[slot].deviceid = event->deviceid;
+            active++;
+        }
+        else TRACE( "pinch begin on device %d with a gesture in progress, re-arming\n", event->deviceid );
+
+        gestures[slot].hwnd = hwnd;
+        gestures[slot].scale = 1.0;
+        if (XQueryPointer( event->display, root_window, &root_win, &child, &x, &y, &win_x, &win_y, &xstate ))
+            gestures[slot].anchor = root_to_virtual_screen( x, y );
+        else gestures[slot].anchor = map_event_coords( hwnd, event->event, event->root, root, pt );
+
+        /* hold Ctrl across the gesture: a bare wheel update then picks up
+         * MK_CONTROL from the held key. A Ctrl the user already holds is
+         * left alone, and a begin while a synthesized Ctrl is still held (a
+         * lost end) reuses it instead of pressing twice. */
+        if (!ctrl_held && !(NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000))
+        {
+            NtUserSendHardwareInput( hwnd, 0, &ctrl, 0 );
+            ctrl_held = TRUE;
+        }
+
+        TRACE( "pinch begin on %lx, device %d\n", event->event, event->deviceid );
+        return TRUE;
+    }
+
+    if (event->evtype == XI_GesturePinchEnd)
+    {
+        char keys[32];
+        KeyCode left, right;
+
+        TRACE( "pinch end on %lx, device %d\n", event->event, event->deviceid );
+
+        hwnd = slot != -1 ? gestures[slot].hwnd : 0;
+        if (slot != -1) gestures[slot].deviceid = 0;
+        else TRACE( "pinch end on device %d without a begin\n", event->deviceid );
+        if (active) active--;
+        if (active || !ctrl_held) return TRUE;
+
+        /* release the synthesized Ctrl unless the user is physically holding
+         * one: the real release then clears the state, while ours would clear
+         * a Ctrl that is still down. GetAsyncKeyState cannot tell a
+         * synthesized press from a physical one, so ask the server. */
+        XQueryKeymap( event->display, keys );
+        left = XKeysymToKeycode( event->display, XK_Control_L );
+        right = XKeysymToKeycode( event->display, XK_Control_R );
+        if ((left && (keys[left >> 3] >> (left & 7)) & 1) ||
+            (right && (keys[right >> 3] >> (right & 7)) & 1))
+        {
+            ctrl_held = FALSE;
+            return TRUE;
+        }
+
+        ctrl.ki.dwFlags = KEYEVENTF_KEYUP;
+        NtUserSendHardwareInput( hwnd, 0, &ctrl, 0 );
+        ctrl_held = FALSE;
+        return TRUE;
+    }
+
+    if (!(event->scale > 0.0)) return FALSE;
+
+    if (slot == -1)
+    {
+        /* the begin went somewhere else: start from the current scale at the
+         * event position rather than dropping the gesture */
+        if ((slot = free_slot) == -1) return FALSE;
+        if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+        memset( &gestures[slot], 0, sizeof(gestures[slot]) );
+        gestures[slot].deviceid = event->deviceid;
+        gestures[slot].hwnd = hwnd;
+        gestures[slot].scale = event->scale;
+        gestures[slot].anchor = map_event_coords( hwnd, event->event, event->root, root, pt );
+        active++;
+        if (!ctrl_held && !(NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000))
+        {
+            NtUserSendHardwareInput( hwnd, 0, &ctrl, 0 );
+            ctrl_held = TRUE;
+        }
+    }
+
+    units = WHEEL_DELTA * log( event->scale / gestures[slot].scale ) / log( zoom_step );
+    if (pinch_zoom_notched()) units = trunc( units / WHEEL_DELTA ) * WHEEL_DELTA;
+    if ((delta = round( units )) > max_delta) delta = max_delta;
+    else if (delta < -max_delta) delta = -max_delta;
+    if (!delta) return TRUE;
+
+    /* advance by what was reported, so the rest waits for the next update */
+    gestures[slot].scale *= pow( zoom_step, (double)delta / WHEEL_DELTA );
+
+    TRACE( "hwnd %p/%lx scale %f delta %d\n", gestures[slot].hwnd, event->event, event->scale, delta );
+
+    send_wheel_input( gestures[slot].hwnd, gestures[slot].anchor, MOUSEEVENTF_WHEEL, delta, FALSE, time );
+    return TRUE;
+}
+
+#endif /* XI_GesturePinchBegin */
+
 #endif /* HAVE_X11_EXTENSIONS_XINPUT2_H */
 
 
@@ -1994,6 +2245,14 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
         ret = X11DRV_TouchEvent( hwnd, event );
         break;
 
+#ifdef XI_GesturePinchBegin
+    case XI_GesturePinchBegin:
+    case XI_GesturePinchUpdate:
+    case XI_GesturePinchEnd:
+        ret = X11DRV_GesturePinchEvent( event );
+        break;
+#endif
+
     default:
         TRACE( "Unhandled event %#x\n", event->evtype );
         break;
-- 
