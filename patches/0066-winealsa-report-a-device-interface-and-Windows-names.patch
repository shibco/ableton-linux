-/* Build the display name winmm exposes for a seq port: "client - port",
- * falling back to the port name alone if that would overflow.  Must stay
- * stable across replug so hotplug re-matching by name works. */
+/* Windows gives each USB MIDI port a name from its USB MIDI class driver. The
+ * first port of a device gets the device name. The other ports get the names
+ * "MIDIIN<n> (device)" and "MIDIOUT<n> (device)". Windows also gives each port
+ * a KS device interface path. This path contains the USB ids of the device:
+ *
+ *   \\?\usb#vid_2982&pid_1969&mi_05#7&1e0d0a41&0&0005#{6994ad04-...}
+ *
+ * Applications use the names and the path to find their hardware. Ableton Live
+ * looks for vid_xxxx&pid_xxxx in the path of each MIDI device. Live starts its
+ * Push helper only if it finds these ids. The helper then compares the port
+ * names with one pattern for each Push generation.
+ *
+ * ALSA gives no path and different names. Make both from the USB device that is
+ * behind the sound card of the port. A port that has no USB card keeps the name
+ * "client - port" and gets no path.
+ */
+static const char midi_ks_category[] = "{6994ad04-93ef-11d0-a3cc-00a0c9223196}";
+
+static BOOL sysfs_read_hex(const char *dir, const char *file, unsigned int *value)
+{
+    char path[512];
+    FILE *f;
+    int ret;
+
+    snprintf(path, sizeof(path), "%s/%s", dir, file);
+    if (!(f = fopen(path, "r"))) return FALSE;
+    ret = fscanf(f, "%x", value);
+    fclose(f);
+    return ret == 1;
+}
+
+/* Find the MIDI streaming interface of the USB device. Windows shows this
+ * interface number in the &mi_ field. Return -1 if there is no such interface. */
+static int usb_midi_interface(const char *device_dir)
+{
+    struct dirent *entry;
+    int number = -1;
+    DIR *dir;
+
+    if (!(dir = opendir(device_dir))) return -1;
+    while ((entry = readdir(dir)))
+    {
+        unsigned int iface_class, iface_subclass, iface_number;
+        char path[512];
+
+        /* interface directories are <bus>-<port>:<config>.<interface> */
+        if (!strchr(entry->d_name, ':')) continue;
+        snprintf(path, sizeof(path), "%s/%s", device_dir, entry->d_name);
+        if (!sysfs_read_hex(path, "bInterfaceClass", &iface_class) || iface_class != 0x01) continue;
+        if (!sysfs_read_hex(path, "bInterfaceSubClass", &iface_subclass) || iface_subclass != 0x03) continue;
+        if (!sysfs_read_hex(path, "bInterfaceNumber", &iface_number)) continue;
+        number = iface_number;
+        break;
+    }
+    closedir(dir);
+    return number;
+}
+
+/* Find the USB device of an ALSA card. The device link of the card points to one
+ * interface of the USB device. Go up in the tree until a directory has the ids. */
+static BOOL card_usb_ids(int card, unsigned int *vid, unsigned int *pid, int *midi_iface)
+{
+    char link[64], *dir;
+    BOOL found = FALSE;
+    int i;
+
+    if (card < 0) return FALSE;
+    snprintf(link, sizeof(link), "/sys/class/sound/card%d/device", card);
+    if (!(dir = realpath(link, NULL))) return FALSE;
+
+    for (i = 0; i < 4; i++)
+    {
+        char *slash;
+
+        if (sysfs_read_hex(dir, "idVendor", vid) && sysfs_read_hex(dir, "idProduct", pid))
+        {
+            if (midi_iface) *midi_iface = usb_midi_interface(dir);
+            found = TRUE;
+            break;
+        }
+        if (!(slash = strrchr(dir, '/')) || slash == dir) break;
+        *slash = 0;
+    }
+    free(dir);
+    return found;
+}
+
+/* Write the interface path of the port. Write nothing if the port has no USB
+ * card. Write nothing if the path is too long for the buffer, because a short
+ * path is not correct. */
+static void set_interface_name(WCHAR *dst, unsigned int dst_len, int card,
+                               snd_seq_port_info_t *pinfo)
+{
+    char path[MIDI_INTERFACE_LEN];
+    unsigned int vid, pid;
+    int midi_iface = -1, len;
+
+    if (!card_usb_ids(card, &vid, &pid, &midi_iface)) return;
+
+    if (midi_iface >= 0)
+        len = snprintf(path, sizeof(path),
+                       "\\\\?\\usb#vid_%04x&pid_%04x&mi_%02x#alsa&card%d&port%d#%s",
+                       vid, pid, midi_iface, card, snd_seq_port_info_get_port(pinfo),
+                       midi_ks_category);
+    else
+        len = snprintf(path, sizeof(path),
+                       "\\\\?\\usb#vid_%04x&pid_%04x#alsa&card%d&port%d#%s",
+                       vid, pid, card, snd_seq_port_info_get_port(pinfo), midi_ks_category);
+    if (len < 0 || len >= (int)sizeof(path)) return;
+
+    ntdll_umbstowcs(path, len + 1, dst, dst_len);
+    TRACE("%d:%d interface '%s'\n", snd_seq_port_info_get_client(pinfo),
+          snd_seq_port_info_get_port(pinfo), path);
+}
+
+/* Make the name that winmm shows for a seq port. A port on a USB card gets the
+ * Windows name. Each other port gets the name "client - port". If that name is
+ * too long, use the port name only. The name must not change after a replug,
+ * because the hotplug code finds the port again by name. */
 static unsigned int port_display_name(snd_seq_client_info_t *cinfo, snd_seq_port_info_t *pinfo,
-                                      char name[MAXPNAMELEN])
+                                      BOOL is_out, char name[MAXPNAMELEN])
 {
     unsigned int len = strlen(snd_seq_port_info_get_name(pinfo));
+    int port = snd_seq_port_info_get_port(pinfo);
+    unsigned int vid, pid;
+
+    if (card_usb_ids(snd_seq_client_info_get_card(cinfo), &vid, &pid, NULL)) {
+        if (!port)
+            snprintf(name, MAXPNAMELEN, "%s", snd_seq_client_info_get_name(cinfo));
+        else
+            snprintf(name, MAXPNAMELEN, is_out ? "MIDIOUT%d (%s)" : "MIDIIN%d (%s)",
+                     port + 1, snd_seq_client_info_get_name(cinfo));
+        return strlen(name);
+    }
 
     if ((strlen(snd_seq_client_info_get_name(cinfo)) + len + 3) < MAXPNAMELEN) {
         sprintf(name, "%s - %s", snd_seq_client_info_get_name(cinfo), snd_seq_port_info_get_name(pinfo));
@@ -307,6 +441,30 @@ static unsigned int port_display_name(snd_seq_client_info_t *cinfo, snd_seq_port
     return len;
 }
 
+/* Answer DRV_QUERYDEVICEINTERFACE and DRV_QUERYDEVICEINTERFACESIZE for one
+ * port. The sizes are in bytes and include the terminator. The wave devices in
+ * winmm use the same counts. */
+static UINT get_device_interface(UINT msg, const WCHAR *name, void *param_1, UINT_PTR param_2)
+{
+    const WCHAR *end = name;
+    ULONG len_bytes;
+
+    if (!*name) return MMSYSERR_NOTSUPPORTED;
+    if (!param_1) return MMSYSERR_INVALPARAM;
+
+    while (*end) end++;
+    len_bytes = (end - name + 1) * sizeof(WCHAR);
+
+    if (msg == DRV_QUERYDEVICEINTERFACESIZE)
+    {
+        *(ULONG *)param_1 = len_bytes;
+        return MMSYSERR_NOERROR;
+    }
+    if (param_2 < len_bytes) return MMSYSERR_INVALPARAM;
+    memcpy(param_1, name, len_bytes);
+    return MMSYSERR_NOERROR;
+}
