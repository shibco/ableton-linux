@@ -2968,6 +3288,9 @@ static POINT map_raw_event_coords( XIRawEvent *event, POINT *raw )
 
     warp_emulation_raw_motion( event->display, event->sourceid, event->time,
                                x_value * x_scale, y_value * y_scale );
