  *              warp_emulation_cancel
  *
@@ -1439,6 +1736,11 @@ static BOOL send_discrete_wheel_input( HWND hwnd, POINT pt, UINT flags, int delt
 {
     unsigned int held_button_mask = pointer_button_mask();
 
+    if (held_control_drag_active())
+    {
+        TRACE( "discrete wheel %d suppressed: held LMB control drag is isolated\n", delta );
+        return TRUE;
+    }
     if (pointer_config.wheel_while_button_held == POINTER_WHEEL_WHILE_BUTTON_HELD_ENABLED &&
         event_button_mask && event_button_mask == held_button_mask &&
         !x11drv_thread_data()->middle_drag.active)
@@ -2601,6 +2903,7 @@ BOOL X11DRV_SetCursorPos( INT x, INT y )
         warp_emulation_record_warp( target, prewarp, state );
     }
     else warp_emulation_disarm();
+    held_control_drag_reanchor( (POINT){x, y} );
 
     if (!clipping_cursor)
         XUngrabPointer( data->display, CurrentTime );
@@ -2628,6 +2931,7 @@ BOOL X11DRV_GetCursorPos(LPPOINT pos)
         POINT old = *pos;
         *pos = root_to_virtual_screen( winX, winY );
         warp_emulation_get_position( pos );
+        held_control_drag_get_position( pos );
         TRACE( "pointer at %s server pos %s\n", wine_dbgstr_point(pos), wine_dbgstr_point(&old) );
     }
     return ret;
@@ -2741,6 +3045,7 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    held_control_drag_button_press( event->button, event->state, pt );
     /* Invalidate delayed fixed wheel input before a gesture lock can wait
      * behind a low-level hook. */
     if (button >= NB_BUTTONS) warp_emulation_cancel();
@@ -2800,6 +3105,7 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
     {
         if (button_up_flags[button])
             pt = map_emulated_warp_coords( event->display, pt, event->time, FALSE );
+        held_control_drag_button_release( event->button, &pt );
         warp_emulation_button_release( event->button );
     }
     /* Never carry a sub-notch remainder across a button release into whatever
@@ -2833,6 +3139,7 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
 static BOOL x11drv_motion_notify( HWND hwnd, XEvent *xev, BOOL co_reported_scroll )
 {
     XMotionEvent *event = &xev->xmotion;
+    enum held_control_motion_result held_result;
     POINT pt = { event->x, event->y }, root = { event->x_root, event->y_root };
     UINT time = EVENT_x11_time_to_win32_time( event->time );
 
@@ -2853,6 +3160,15 @@ static BOOL x11drv_motion_notify( HWND hwnd, XEvent *xev, BOOL co_reported_scrol
      * coast. Pointer coordinates carried by the same XI2 report as scrolling
      * are part of that scroll frame and must not split its speed history. */
     if (middle_drag_motion( event, pt, time )) return TRUE;
