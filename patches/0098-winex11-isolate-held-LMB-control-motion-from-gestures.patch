From b0eab98628d4f9956d4d72f6966c6e428773fb67 Mon Sep 17 00:00:00 2001
From: ableton-wine <local@ableton-wine>
Date: Thu, 13 Aug 2026 10:58:11 +0200
Subject: [PATCH] winex11: isolate held LMB control motion from gestures

Treat a Button1 control drag as ordinary pointer input, never as a scroll or inertia gesture. Accumulate the X server's processed XI2 pointer deltas at one logical point and forward every delta exactly once without adding a Wine transfer function.

Reanchor that point across SetCursorPos and bypass warp classification while held. Fall back to cooked coordinate deltas when RawMotion is unavailable, and preserve clipped relative operation without sending a second motion path.

Suppress smooth and discrete wheel input, pinch, inertia, and duplicate cooked reports for the lifetime of the drag. Cancel the channel on release, focus loss, capture loss, device replacement, or thread teardown.
---
 dlls/winex11.drv/event.c       |   7 +-
 dlls/winex11.drv/mouse.c       | 347 ++++++++++++++++++++++++++++++++-
 dlls/winex11.drv/window.c      |   1 +
 dlls/winex11.drv/x11drv.h      |   1 +
 dlls/winex11.drv/x11drv_main.c |   1 +
 5 files changed, 351 insertions(+), 6 deletions(-)

diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index 923b6f0..38b3509 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -757,6 +757,7 @@ static BOOL X11DRV_FocusIn( HWND hwnd, XEvent *xev )
  */
 static void focus_out( Display *display , HWND hwnd )
  {
+    held_control_drag_cancel();
     warp_emulation_cancel();
     /* a pinch in progress does not survive losing the input focus */
     pinch_gestures_reset();
@@ -816,7 +817,11 @@ static BOOL X11DRV_FocusOut( HWND hwnd, XEvent *xev )
     HWND foreground = NtUserGetForegroundWindow();
     XFocusChangeEvent *event = &xev->xfocus;
 
-    if (event->detail != NotifyPointer) warp_emulation_cancel();
+    if (event->detail != NotifyPointer)
+    {
+        held_control_drag_cancel();
+        warp_emulation_cancel();
+    }
     if (event->detail == NotifyPointer)
     {
         if (!hwnd && event->window == x11drv_thread_data()->clip_window)
diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index b5be221..66d5d74 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -140,6 +140,39 @@ enum warp_probe_result
     WARP_PROBE_APPLIED,
 };
 
+enum held_control_motion_result
+{
+    HELD_CONTROL_MOTION_INACTIVE,
+    HELD_CONTROL_MOTION_SUPPRESSED,
+    HELD_CONTROL_MOTION_DELIVERED,
+};
+
+/* A left-button control drag is not a gesture. Keep a process-wide logical
+ * point because the button press, raw event, cooked event, cursor warp, and
+ * release can cross attached Wine threads. raw_dx/raw_dy are the X server's
+ * already-processed pointer deltas; Wine applies no velocity curve, gain, or
+ * smoothing to them. */
+static struct
+{
+    BOOL active;
+    BOOL raw_seen;
+    Display *raw_display;
+    Time raw_time;
+    double raw_dx;
+    double raw_dy;
+    double raw_used_x;
+    double raw_used_y;
+    double logical_x;
+    double logical_y;
+    POINT emitted;
+    BOOL native_valid;
+    POINT native;
+    BOOL fallback_valid;
+    Display *fallback_display;
+    Time fallback_time;
+} held_control_drag;
+static pthread_mutex_t held_control_drag_mutex = PTHREAD_MUTEX_INITIALIZER;
+
 /* X events can cross Wine threads after input attachment.  Keep one process
  * state so a release, focus loss, or capture loss on another X11 thread still
  * terminates the drag which armed emulation. */
@@ -1053,6 +1086,270 @@ static POINT map_event_coords( HWND hwnd, Window window, Window event_root, POIN
     return dst;
 }
 
+static void held_control_drag_reset_locked(void)
+{
+    memset( &held_control_drag, 0, sizeof(held_control_drag) );
+}
+
+/***********************************************************************
+ *              held_control_drag_cancel
+ *
+ * End the process-wide LMB control-drag channel at an input discontinuity.
+ */
+void held_control_drag_cancel(void)
+{
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (held_control_drag.active) TRACE( "cancelling held LMB control drag\n" );
+    held_control_drag_reset_locked();
+    pthread_mutex_unlock( &held_control_drag_mutex );
+}
+
+static void held_control_drag_button_press( unsigned int button, unsigned int state, POINT point )
+{
+    /* Buttons 4--7 are wheel transitions, not drag ownership. They are
+     * suppressed independently below and must not break an LMB drag. */
+    if (button >= Button4 && button <= 7) return;
+
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (button != Button1 || (state & (Button2Mask | Button3Mask)))
+    {
+        held_control_drag_reset_locked();
+        pthread_mutex_unlock( &held_control_drag_mutex );
+        return;
+    }
+    if (!held_control_drag.active)
+    {
+        held_control_drag_reset_locked();
+        held_control_drag.active = TRUE;
+        held_control_drag.logical_x = point.x;
+        held_control_drag.logical_y = point.y;
+        held_control_drag.emitted = point;
+        held_control_drag.native = point;
+        held_control_drag.native_valid = TRUE;
+        TRACE( "held LMB control drag begins at %s\n", wine_dbgstr_point( &point ) );
+    }
+    pthread_mutex_unlock( &held_control_drag_mutex );
+}
+
+static BOOL held_control_drag_button_release( unsigned int button, POINT *point )
+{
+    BOOL active = FALSE;
+
+    if (button != Button1) return FALSE;
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if ((active = held_control_drag.active))
+    {
+        *point = held_control_drag.emitted;
+        TRACE( "held LMB control drag ends at %s\n", wine_dbgstr_point( point ) );
+    }
+    held_control_drag_reset_locked();
+    pthread_mutex_unlock( &held_control_drag_mutex );
+    return active;
+}
+
+static BOOL held_control_drag_active(void)
+{
+    BOOL active;
+
+    pthread_mutex_lock( &held_control_drag_mutex );
+    active = held_control_drag.active;
+    pthread_mutex_unlock( &held_control_drag_mutex );
+    return active;
+}
+
+static void held_control_drag_reanchor( POINT point )
+{
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (held_control_drag.active)
+    {
+        held_control_drag.logical_x = point.x;
+        held_control_drag.logical_y = point.y;
+        held_control_drag.emitted = point;
+        /* The server may apply or ignore the warp. The next processed raw
+         * delta is valid either way; a cooked-only fallback first reseeds. */
+        held_control_drag.native_valid = FALSE;
+        held_control_drag.raw_seen = FALSE;
+        held_control_drag.fallback_valid = FALSE;
+        TRACE( "held LMB control drag reanchored at %s\n", wine_dbgstr_point( &point ) );
+    }
+    pthread_mutex_unlock( &held_control_drag_mutex );
+}
+
+static BOOL held_control_drag_get_position( POINT *point )
+{
+    BOOL active;
+
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if ((active = held_control_drag.active)) *point = held_control_drag.emitted;
+    pthread_mutex_unlock( &held_control_drag_mutex );
+    return active;
+}
+
+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+static void held_control_drag_raw_motion( Display *display, Time time, double dx, double dy )
+{
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (!held_control_drag.active) goto done;
+
+    if (!held_control_drag.raw_seen || held_control_drag.raw_time != time)
+    {
+        held_control_drag.raw_seen = TRUE;
+        held_control_drag.raw_display = display;
+        held_control_drag.raw_time = time;
+        held_control_drag.raw_dx = dx;
+        held_control_drag.raw_dy = dy;
+        held_control_drag.raw_used_x = held_control_drag.raw_used_y = 0.0;
+    }
+    else if (held_control_drag.raw_display == display)
+    {
+        held_control_drag.raw_dx += dx;
+        held_control_drag.raw_dy += dy;
+    }
+    else
+    {
+        /* Attached Wine threads can select the same master RawMotion on
+         * separate X connections. The first connection owns this timestamp;
+         * a second copy must not multiply the physical distance. */
+        TRACE( "held LMB control drag ignores duplicate raw frame on another connection\n" );
+        goto done;
+    }
+
+    /* A cooked event can precede its RawMotion copy on another attached
+     * queue. If that cooked fallback was already delivered, mark all raw
+     * movement for the same server frame consumed instead of doubling it. */
+    if (held_control_drag.fallback_valid && held_control_drag.fallback_time == time)
+    {
+        held_control_drag.raw_used_x = held_control_drag.raw_dx;
+        held_control_drag.raw_used_y = held_control_drag.raw_dy;
+    }
+
+done:
+    pthread_mutex_unlock( &held_control_drag_mutex );
+}
+#endif
+
+static enum held_control_motion_result held_control_drag_apply_raw_locked( Time time,
+                                                                           POINT *reported )
+{
+    double dx, dy;
+    POINT point;
+
+    if (!held_control_drag.raw_seen || held_control_drag.raw_time != time)
+        return HELD_CONTROL_MOTION_SUPPRESSED;
+
+    dx = held_control_drag.raw_dx - held_control_drag.raw_used_x;
+    dy = held_control_drag.raw_dy - held_control_drag.raw_used_y;
+    held_control_drag.raw_used_x = held_control_drag.raw_dx;
+    held_control_drag.raw_used_y = held_control_drag.raw_dy;
+    if (dx == 0.0 && dy == 0.0) return HELD_CONTROL_MOTION_SUPPRESSED;
+
+    held_control_drag.logical_x += dx;
+    held_control_drag.logical_y += dy;
+    point.x = round( held_control_drag.logical_x );
+    point.y = round( held_control_drag.logical_y );
+    if (point.x == held_control_drag.emitted.x && point.y == held_control_drag.emitted.y)
+        return HELD_CONTROL_MOTION_SUPPRESSED;
+
+    held_control_drag.emitted = point;
+    *reported = point;
+    TRACE( "held LMB control drag forwards one processed delta %f,%f at %s\n",
+           dx, dy, wine_dbgstr_point( reported ) );
+    return HELD_CONTROL_MOTION_DELIVERED;
+}
+
+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+static enum held_control_motion_result held_control_drag_clipped_motion( Time time,
+                                                                         POINT *reported )
+{
+    enum held_control_motion_result result;
+
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (!held_control_drag.active) result = HELD_CONTROL_MOTION_INACTIVE;
+    else result = held_control_drag_apply_raw_locked( time, reported );
+    pthread_mutex_unlock( &held_control_drag_mutex );
+    return result;
+}
+#endif
+
+static enum held_control_motion_result held_control_drag_motion( Display *display, Time time,
+                                                                 POINT native, unsigned int state,
+                                                                 BOOL co_reported_scroll,
+                                                                 POINT *reported )
+{
+    enum held_control_motion_result result = HELD_CONTROL_MOTION_SUPPRESSED;
+    double dx, dy;
+    POINT point;
+
+    pthread_mutex_lock( &held_control_drag_mutex );
+    if (!held_control_drag.active)
+    {
+        result = HELD_CONTROL_MOTION_INACTIVE;
+        goto done;
+    }
+    if ((state & (Button2Mask | Button3Mask)) ||
+        (!(state & Button1Mask) && !co_reported_scroll))
+    {
+        held_control_drag_reset_locked();
+        result = HELD_CONTROL_MOTION_INACTIVE;
+        goto done;
+    }
+
+    if (held_control_drag.raw_seen && held_control_drag.raw_time == time)
+    {
+        held_control_drag.native = native;
+        held_control_drag.native_valid = TRUE;
+        result = held_control_drag_apply_raw_locked( time, reported );
+        goto done;
+    }
+    else
+    {
+        /* A scroll-bearing frame without a pointer delta is gesture input,
+         * never control movement. Reseed native coordinates so a later
+         * cooked-only fallback cannot release the ignored distance. */
+        if (co_reported_scroll)
+        {
+            held_control_drag.native = native;
+            held_control_drag.native_valid = TRUE;
+            goto done;
+        }
+        if (held_control_drag.fallback_valid &&
+            held_control_drag.fallback_display == display &&
+            held_control_drag.fallback_time == time &&
+            held_control_drag.native.x == native.x && held_control_drag.native.y == native.y)
+            goto done;
+
+        held_control_drag.fallback_valid = TRUE;
+        held_control_drag.fallback_display = display;
+        held_control_drag.fallback_time = time;
+        if (!held_control_drag.native_valid)
+        {
+            held_control_drag.native = native;
+            held_control_drag.native_valid = TRUE;
+            goto done;
+        }
+        dx = native.x - held_control_drag.native.x;
+        dy = native.y - held_control_drag.native.y;
+        held_control_drag.native = native;
+        if (dx == 0.0 && dy == 0.0) goto done;
+    }
+
+    held_control_drag.logical_x += dx;
+    held_control_drag.logical_y += dy;
+    point.x = round( held_control_drag.logical_x );
+    point.y = round( held_control_drag.logical_y );
+    if (point.x == held_control_drag.emitted.x && point.y == held_control_drag.emitted.y) goto done;
+
+    held_control_drag.emitted = point;
+    *reported = point;
+    result = HELD_CONTROL_MOTION_DELIVERED;
+    TRACE( "held LMB control drag forwards one cooked fallback delta %f,%f at %s\n",
+           dx, dy, wine_dbgstr_point( reported ) );
+
+done:
+    pthread_mutex_unlock( &held_control_drag_mutex );
+    return result;
+}
+
