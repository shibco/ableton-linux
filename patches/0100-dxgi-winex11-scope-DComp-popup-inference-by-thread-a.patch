+static CRITICAL_SECTION_DEBUG dcomp_popup_stack_cs_debug =
+{
+    0, 0, &dcomp_popup_stack_cs,
+    { &dcomp_popup_stack_cs_debug.ProcessLocksList, &dcomp_popup_stack_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": dcomp_popup_stack_cs") }
+};
+static CRITICAL_SECTION dcomp_popup_stack_cs = { &dcomp_popup_stack_cs_debug, -1, 0, 0, 0, 0 };
+
+/* Transient anchor for a new target: the previously-opened target on the SAME
+ * UI thread.  A plugin creates its popups on its own thread, so thread
+ * affinity relates a popup to its plugin; the old process-global top could
+ * hand plugin B's popup an anchor belonging to plugin A.
+ * WINE_DCOMP_SCOPE=global restores the plain top-of-stack. */
+static HWND dcomp_popup_stack_top_for(HWND target)
+{
+    HWND ret = NULL;
+    DWORD tid;
+    int i;
+
+    EnterCriticalSection(&dcomp_popup_stack_cs);
+    if (dcomp_scope_global())
+    {
+        if (dcomp_popup_stack_depth > 0) ret = dcomp_popup_stack[dcomp_popup_stack_depth - 1];
+    }
+    else
+    {
+        tid = GetWindowThreadProcessId(target, NULL);
+        for (i = dcomp_popup_stack_depth - 1; i >= 0; --i)
+        {
+            if (dcomp_popup_stack_tid[i] == tid && IsWindow(dcomp_popup_stack[i]))
+            {
+                ret = dcomp_popup_stack[i];
+                break;
+            }
+        }
+    }
+    LeaveCriticalSection(&dcomp_popup_stack_cs);
+    return ret;
+}
+
+/* Full-versus-popup mode: the first target on its own UI thread is that
+ * plugin's main window; later targets on the thread are its popups.  The old
+ * process-global count made the first target of a SECOND plugin a popup,
+ * costing it the present timer. */
