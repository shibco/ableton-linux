+/* Set on the desktop window by dxgi while a DComp plugin GUI is hosted by
+ * THIS process.  Used to mark embedded ownerless TOOLWINDOW popups as
+ * DROPDOWN_MENU (see set_style_hints): they anchor to the host window, so
+ * the per-window dcomp discriminators below cannot see they belong to a
+ * DComp plugin.  The name is scoped by process id: the desktop property
+ * list spans the window station, and the old session-wide flag gave
+ * unrelated processes' ownerless popups a menu role while any DComp GUI
+ * existed anywhere.  WINE_DCOMP_SCOPE=global restores the session-wide
+ * name for comparison. */
+static void get_dcomp_active_prop_name( WCHAR *name, size_t count )
+{
+    const char *env = getenv( "WINE_DCOMP_SCOPE" );
+    char ascii[64];
+    size_t i;
+
+    if (env && !strcmp( env, "global" ))
