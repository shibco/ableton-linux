+        snprintf( ascii, sizeof(ascii), "__wine_dcomp_active_%u", (UINT)GetCurrentProcessId() );
+    for (i = 0; ascii[i] && i < count - 1; i++) name[i] = (WCHAR)ascii[i];
+    name[i] = 0;
+}
 
