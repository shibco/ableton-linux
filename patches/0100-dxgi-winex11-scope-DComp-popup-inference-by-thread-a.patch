  * Set while count > 0, removed at 0 (SetProp with value 0 is not distinguishable
  * from "unset" — see the SetPropW (HANDLE)1/2 lesson). */
+/* WINE_DCOMP_SCOPE=global restores the session-wide active flag and the
+ * process-global popup anchoring for comparison. */
+static BOOL dcomp_scope_global(void)
+{
+    static int global = -1;
+
+    if (global == -1)
+    {
+        WCHAR val[16] = {0};
+        global = GetEnvironmentVariableW(L"WINE_DCOMP_SCOPE", val, ARRAY_SIZE(val))
+                && !wcscmp(val, L"global");
+    }
+    return global;
+}
+
+static void dcomp_active_prop_name(WCHAR *name, SIZE_T count)
+{
+    if (dcomp_scope_global())
+        swprintf(name, count, L"__wine_dcomp_active");
+    else
+        swprintf(name, count, L"__wine_dcomp_active_%u", GetCurrentProcessId());
+}
+
 static void dcomp_update_active_prop(void)
 {
+    WCHAR name[64];
     LONG count = dcomp_subclassed_target_count;
+
+    dcomp_active_prop_name(name, ARRAY_SIZE(name));
