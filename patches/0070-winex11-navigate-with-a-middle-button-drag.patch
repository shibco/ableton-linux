 dlls/winex11.drv/mouse.c | 243 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 243 insertions(+)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index 2c394b6..20565ac 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -30,6 +30,8 @@
 #include <X11/Xlib.h>
 #include <X11/cursorfont.h>
 #include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
 #ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
 #include <X11/extensions/XInput2.h>
 #endif
@@ -557,6 +559,243 @@ static void send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT
     NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT, &input, (LPARAM)raw );
 }
 
+/***********************************************************************
+ *           send_wheel_input
+ *
+ * Send wheel or horizontal wheel input, optionally with Ctrl held. The
+ * MK_CONTROL bit in the message and GetKeyState() both read the desktop key
+ * state, so the modifier has to be a key event and not a flag on the mouse
+ * input. A Ctrl the user is already holding is left alone.
+ */
+static void send_wheel_input( HWND hwnd, POINT pos, UINT flags, int delta, BOOL control, UINT time )
+{
+    INPUT input = { .type = INPUT_KEYBOARD, .ki = { .wVk = VK_CONTROL, .wScan = 0x1d, .time = time } };
+    BOOL press_control = control && !(NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000);
+
+    if (press_control) NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+    send_mouse_input( hwnd, pos, MOUSEEVENTF_ABSOLUTE | flags, delta, time, NULL );
+    if (press_control)
+    {
+        input.ki.dwFlags = KEYEVENTF_KEYUP;
+        NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+    }
+}
+
+/***********************************************************************
+ *           middle_drag_enabled
+ *
+ * WINE_X11_MIDDLE_DRAG=navigate turns a middle-button drag into navigation
+ * input: vertical movement becomes wheel notches, horizontal movement
+ * becomes horizontal wheel notches. Default off, where the middle button
+ * reports WM_MBUTTONDOWN and WM_MBUTTONUP as usual.
+ */
+static BOOL middle_drag_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv( "WINE_X11_MIDDLE_DRAG" );
+        enabled = value && (!strcmp( value, "navigate" ) || !strcmp( value, "on" ) ||
+                            !strcmp( value, "1" ) || !strcmp( value, "notch" ));
+    }
+    return enabled;
+}
+
+/***********************************************************************
+ *           middle_drag_notched
+ *
+ * WINE_X11_MIDDLE_DRAG=notch reports whole wheel notches instead of following
+ * the pointer continuously, for an application that ignores the part of a
+ * notch a precision pointing device reports.
+ */
+static BOOL middle_drag_notched(void)
+{
+    static int notched = -1;
+    const char *value;
+
+    if (notched == -1)
+    {
+        value = getenv( "WINE_X11_MIDDLE_DRAG" );
+        notched = value && !strcmp( value, "notch" );
+    }
+    return notched;
+}
+
+/* movement one wheel notch stands for, in raw virtual screen pixels */
+#define MIDDLE_DRAG_STEP 24
+/* movement below this leaves the press a plain middle click */
+#define MIDDLE_DRAG_SLOP 3
+
+/* Process-global, while winex11 polls each thread's display on that thread:
+ * drags on windows owned by different threads can race on this. */
+static struct
+{
+    BOOL  active;
+    BOOL  moved;
+    HWND  hwnd;
+    UINT  time;        /* when the press was held back */
+    POINT origin;      /* position the press landed on, virtual screen coordinates */
+    POINT last;        /* previous position, in the same coordinates */
+    int   accum_x;
+    int   accum_y;
+} middle_drag;
+
+/***********************************************************************
+ *           middle_drag_flush_click
+ *
+ * Replay a held-back press that never moved as a plain middle click: the
+ * down stamped with the time and at the position the press landed on, the
+ * up with the time it is let go.
+ */
+static void middle_drag_flush_click( UINT time )
+{
+    if (middle_drag.moved) return;
+    send_mouse_input( middle_drag.hwnd, middle_drag.origin,
+                      MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MIDDLEDOWN, 0, middle_drag.time, NULL );
+    send_mouse_input( middle_drag.hwnd, middle_drag.origin,
+                      MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MIDDLEUP, 0, time, NULL );
+}
+
+/***********************************************************************
+ *           middle_drag_abort
+ *
+ * End a drag without its release: another button joined in, or the release
+ * was lost. A press that never moved is replayed as a click; a drag that
+ * reported wheel movement syncs the cursor to the real pointer position, so
+ * the input that follows lands there.
+ */
+static void middle_drag_abort( POINT pt, UINT time )
+{
+    middle_drag_flush_click( time );
+    if (middle_drag.moved)
+        send_mouse_input( middle_drag.hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    middle_drag.active = FALSE;
+}
+
+/***********************************************************************
+ *           middle_drag_begin
+ *
+ * Hold back a middle-button press. The release replays it as a plain click
+ * when the pointer did not move, so a middle click keeps working. A press
+ * of another button during a drag ends it instead and goes through, so a
+ * click placed mid-drag is not followed by motion a held-back drag keeps
+ * swallowing.
+ */
+static BOOL middle_drag_begin( HWND hwnd, XButtonEvent *event, POINT pt, UINT time )
+{
+    if (!middle_drag_enabled()) return FALSE;
+
+    if (middle_drag.active)
+    {
+        if (event->button == Button2)
+            middle_drag_flush_click( time );  /* a stale drag, its release was lost */
+        else
+        {
+            middle_drag_abort( pt, time );
+            return FALSE;
+        }
+    }
+    if (event->button != Button2) return FALSE;
+    if (event->state & (Button1Mask | Button3Mask)) return FALSE;
+
+    TRACE( "hwnd %p/%lx begin at %s\n", hwnd, event->window, wine_dbgstr_point( &pt ) );
+
+    middle_drag.active = TRUE;
+    middle_drag.moved = FALSE;
+    middle_drag.hwnd = hwnd;
+    middle_drag.time = time;
+    middle_drag.origin = pt;
+    middle_drag.last = pt;
+    middle_drag.accum_x = middle_drag.accum_y = 0;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           middle_drag_motion
+ *
+ * Report movement during a middle-button drag as wheel notches at the point
+ * the drag started, and keep the movement itself from the application. Each
+ * axis reports its own wheel, so the drag scrolls the way the pointer moves.
+ * The movement is measured in raw virtual screen pixels: map_event_coords()
+ * reports MDT_RAW_DPI coordinates with no DPI normalization, so one notch
+ * is a fixed physical distance and covers less of a window's content the
+ * more the display is scaled up.
+ *
+ * No modifier is added: a Ctrl the user holds during the drag still reaches
+ * the message through the key state, which turns the same drag into whatever
+ * the application does for Ctrl+wheel.
+ */
+static int middle_drag_delta( int *accum, BOOL notched )
+{
+    int delta = *accum * WHEEL_DELTA / MIDDLE_DRAG_STEP;
+
+    if (notched) delta = (delta / WHEEL_DELTA) * WHEEL_DELTA;
+    *accum -= delta * MIDDLE_DRAG_STEP / WHEEL_DELTA;
+    return delta;
+}
+
+static BOOL middle_drag_motion( XMotionEvent *event, POINT pt, UINT time )
+{
+    BOOL notched = middle_drag_notched();
+    int delta;
+
+    if (!middle_drag.active) return FALSE;
+    if (!(event->state & Button2Mask) ||                /* the release went somewhere else */
+        (event->state & (Button1Mask | Button3Mask)))   /* another button joined in */
+    {
+        middle_drag_abort( pt, time );
+        return FALSE;
+    }
+
+    middle_drag.accum_x += pt.x - middle_drag.last.x;
+    middle_drag.accum_y += pt.y - middle_drag.last.y;
+    middle_drag.last = pt;
+    if (!middle_drag.moved)
+    {
+        if (abs( pt.x - middle_drag.origin.x ) <= MIDDLE_DRAG_SLOP &&
+            abs( pt.y - middle_drag.origin.y ) <= MIDDLE_DRAG_SLOP) return TRUE;
+        middle_drag.moved = TRUE;
+    }
+
+    if ((delta = middle_drag_delta( &middle_drag.accum_y, notched )))  /* up scrolls up */
+    {
+        TRACE( "hwnd %p wheel delta %d\n", middle_drag.hwnd, -delta );
+        send_wheel_input( middle_drag.hwnd, middle_drag.origin, MOUSEEVENTF_WHEEL,
+                          -delta, FALSE, time );
+    }
+    if ((delta = middle_drag_delta( &middle_drag.accum_x, notched )))  /* right scrolls right */
+    {
+        TRACE( "hwnd %p hwheel delta %d\n", middle_drag.hwnd, delta );
+        send_wheel_input( middle_drag.hwnd, middle_drag.origin, MOUSEEVENTF_HWHEEL,
+                          delta, FALSE, time );
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           middle_drag_end
+ *
+ * Let a held-back press go. A press that never moved is replayed as a plain
+ * click; after a drag the cursor is synced to the position the wheel input
+ * was reported at. Both go to the window and the position the drag started
+ * on: the release itself may land somewhere else when a grab broke.
+ */
+static BOOL middle_drag_end( XButtonEvent *event, UINT time )
+{
+    if (!middle_drag.active) return FALSE;
+    if (event->button != Button2) return FALSE;
+
+    TRACE( "hwnd %p/%lx end, moved %u\n", middle_drag.hwnd, event->window, middle_drag.moved );
+
+    middle_drag_flush_click( time );
+    if (middle_drag.moved)
+        send_mouse_input( middle_drag.hwnd, middle_drag.origin, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    middle_drag.active = FALSE;
+    return TRUE;
+}
+
 #ifdef SONAME_LIBXCURSOR
 
 /***********************************************************************
@@ -1526,6 +1765,7 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_begin( hwnd, event, pt, time )) return TRUE;
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_down_data[button], time, NULL );
     return TRUE;
 }
@@ -1545,6 +1785,7 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
     TRACE( "hwnd %p/%lx button %u pos %s\n", hwnd, event->window, button, wine_dbgstr_point( &pt ) );
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_end( event, time )) return TRUE;
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_up_data[button], time, NULL );
     return TRUE;
 }
@@ -1569,6 +1810,8 @@ BOOL X11DRV_MotionNotify( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
+    if (middle_drag_motion( event, pt, time )) return TRUE;
+
     send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
     return TRUE;
 }
