+/***********************************************************************
+ *		pointer_option_string
+ *
+ * Read one source for a pointer setting. Callers try the environment,
+ * AppDefaults, and the global registry key in that order. An invalid value
+ * can then be ignored without hiding a valid lower-priority value.
+ */
+static BOOL pointer_option_string( HKEY defkey, HKEY appkey, const char *name, const char *env,
+                                   unsigned int source_index, char *buffer, size_t size,
+                                   const char **source )
+{
+    static const char *const sources[] = { "environment", "AppDefaults registry", "global registry" };
+    HKEY key;
+    char data[256];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (void *)data;
+    WCHAR nameW[128];
+    WCHAR valueW[64];
+    const char *value;
+    size_t bytes, i;
+
+    if (source_index >= ARRAY_SIZE( sources )) return FALSE;
+    *source = sources[source_index];
+    if (!source_index)
+    {
+        if (!(value = getenv( env ))) return FALSE;
+        snprintf( buffer, size, "%s", value );
+        return TRUE;
+    }
+
+    key = source_index == 1 ? appkey : defkey;
+    if (!key) return FALSE;
+    asciiz_to_unicode( nameW, name );
+    if (!query_reg_value( key, nameW, info, sizeof(data) )) return FALSE;
+    bytes = min( info->DataLength, sizeof(valueW) - sizeof(WCHAR) );
+    memcpy( valueW, info->Data, bytes );
+    valueW[bytes / sizeof(WCHAR)] = 0;
+
+    /* The accepted vocabulary is ASCII. */
+    for (i = 0; i < size - 1 && valueW[i]; i++)
+        buffer[i] = valueW[i] < 128 ? (char)valueW[i] : '?';
+    buffer[i] = 0;
+    return TRUE;
+}
+
+/***********************************************************************
+ *		pointer_option_enum
+ *
+ * Match each configured source against the accepted values. Invalid values
+ * warn and fall through, so a typo cannot hide a lower-priority disable.
+ */
+static void pointer_option_enum( HKEY defkey, HKEY appkey, const char *name, const char *env,
+                                 const char *const *names, int count, int *result )
+{
+    char buffer[64];
+    const char *source;
+    unsigned int source_index;
+    int i;
+
+    for (source_index = 0; source_index < 3; source_index++)
+    {
+        if (!pointer_option_string( defkey, appkey, name, env, source_index,
+                                    buffer, sizeof(buffer), &source )) continue;
+        for (i = 0; i < count; i++)
+        {
+            if (strcasecmp( buffer, names[i] )) continue;
+            *result = i;
+            TRACE( "%s = %s (%s)\n", name, names[i], source );
+            return;
+        }
+        if (!strcasecmp( names[0], "disabled" ) &&
+            (!strcasecmp( buffer, "off" ) || !strcmp( buffer, "0" )))
+        {
+            *result = 0;
+            TRACE( "%s = %s (%s alias %s)\n", name, names[0], source, debugstr_a( buffer ) );
+            return;
+        }
+        WARN_(winediag)( "unrecognized %s value %s from the %s, ignoring it\n",
+                         name, debugstr_a( buffer ), source );
+    }
+    TRACE( "%s = %s (default)\n", name, names[*result] );
+}
+
+/***********************************************************************
+ *		setup_pointer_options
+ *
+ * Parse the pointer feature settings once into pointer_config.
+ */
+static void setup_pointer_options( HKEY defkey, HKEY appkey )
+{
+    static const char *const scroll_names[] = { "disabled", "precise", "notched" };
+    static const char *const inertia_names[] = { "disabled", "auto", "enabled" };
+    static const char *const pinch_names[] = { "disabled", "legacy-wheel" };
+    static const char *const drag_names[] = { "disabled", "navigate", "navigate-notched" };
+    static const char *const throw_names[] = { "disabled", "enabled" };
+    static const char *const held_wheel_names[] = { "disabled", "enabled" };
+    static const char *const curve_names[] = { "exponential", "linear" };
+    static const char *const warp_names[] = { "disabled", "auto", "enabled" };
+    char buffer[64], *end;
+    const char *source;
+    double parsed;
+    unsigned int source_index;
+    int value;
+
+    /* One master switch to a known-stock baseline. It beats the environment
+     * and both registry keys for every pointer setting, so a broken-desktop
+     * report can be reproduced against unmodified pointer behaviour with a
+     * single variable. */
+    {
+        const char *master = getenv( "WINE_X11_POINTER_FEATURES" );
+
+        if (master && (!strcasecmp( master, "disabled" ) || !strcasecmp( master, "off" ) ||
+                       !strcmp( master, "0" )))
+        {
+            pointer_config.enabled = FALSE;
+            pointer_config.smooth_scrolling = POINTER_SCROLL_DISABLED;
+            pointer_config.touchpad_inertia = POINTER_INERTIA_DISABLED;
+            pointer_config.pinch_zoom = POINTER_PINCH_DISABLED;
+            pointer_config.middle_drag = POINTER_MIDDLE_DRAG_DISABLED;
+            pointer_config.middle_drag_throw = POINTER_MIDDLE_DRAG_THROW_DISABLED;
+            pointer_config.wheel_while_button_held = POINTER_WHEEL_WHILE_BUTTON_HELD_DISABLED;
+            pointer_config.warp_emulation = POINTER_WARP_DISABLED;
+            WARN_(winediag)( "WINE_X11_POINTER_FEATURES=%s disables every pointer feature; stock pointer behaviour applies\n",
+                             debugstr_a( master ) );
+            return;
+        }
+    }
+
+    value = pointer_config.smooth_scrolling;
+    pointer_option_enum( defkey, appkey, "SmoothScrolling", "WINE_X11_SMOOTH_SCROLLING",
+                         scroll_names, ARRAY_SIZE( scroll_names ), &value );
+    pointer_config.smooth_scrolling = value;
+
+    value = pointer_config.touchpad_inertia;
+    pointer_option_enum( defkey, appkey, "TouchpadInertia", "WINE_X11_TOUCHPAD_INERTIA",
+                         inertia_names, ARRAY_SIZE( inertia_names ), &value );
+    pointer_config.touchpad_inertia = value;
+
+    value = pointer_config.pinch_zoom;
+    pointer_option_enum( defkey, appkey, "PinchZoom", "WINE_X11_PINCH_ZOOM",
+                         pinch_names, ARRAY_SIZE( pinch_names ), &value );
+    pointer_config.pinch_zoom = value;
+
+    value = pointer_config.middle_drag;
+    pointer_option_enum( defkey, appkey, "MiddleDrag", "WINE_X11_MIDDLE_DRAG",
+                         drag_names, ARRAY_SIZE( drag_names ), &value );
+    pointer_config.middle_drag = value;
+
+    value = pointer_config.middle_drag_throw;
+    pointer_option_enum( defkey, appkey, "MiddleDragThrow", "WINE_X11_MIDDLE_DRAG_THROW",
+                         throw_names, ARRAY_SIZE( throw_names ), &value );
+    pointer_config.middle_drag_throw = value;
+
+    value = pointer_config.wheel_while_button_held;
+    pointer_option_enum( defkey, appkey, "WheelWhileButtonHeld", "WINE_X11_WHEEL_WHILE_BUTTON_HELD",
+                         held_wheel_names, ARRAY_SIZE( held_wheel_names ), &value );
+    pointer_config.wheel_while_button_held = value;
+
+    value = pointer_config.inertia_curve;
+    pointer_option_enum( defkey, appkey, "InertiaCurve", "WINE_X11_INERTIA_CURVE",
+                         curve_names, ARRAY_SIZE( curve_names ), &value );
+    pointer_config.inertia_curve = value;
+
+    value = pointer_config.warp_emulation;
+    pointer_option_enum( defkey, appkey, "WarpEmulation", "WINE_X11_WARP_EMULATION",
+                         warp_names, ARRAY_SIZE( warp_names ), &value );
+    pointer_config.warp_emulation = value;
+
+    for (source_index = 0; source_index < 3; source_index++)
+    {
+        if (!pointer_option_string( defkey, appkey, "InertiaRate", "WINE_X11_INERTIA_RATE",
+                                    source_index, buffer, sizeof(buffer), &source )) continue;
+        parsed = strtod( buffer, &end );
+        if (end == buffer || *end || !isfinite( parsed ) || parsed < 0.5 || parsed > 16.0)
+        {
+            WARN_(winediag)( "InertiaRate value %s from the %s is outside [0.5, 16.0], ignoring it\n",
+                             debugstr_a( buffer ), source );
+            continue;
+        }
+        pointer_config.inertia_rate = parsed;
+        TRACE( "InertiaRate = %.2f (%s)\n", parsed, source );
+        break;
+    }
+}
