+/***********************************************************************
+ *		ClipCursor (X11DRV.@)
+ */
+BOOL X11DRV_ClipCursor( const RECT *clip, BOOL reset )
+{
+    if (reset || !clip || !grab_clipping_window( clip )) ungrab_clipping_window();
+    XFlush( x11drv_thread_data()->display );
+    return TRUE;
+}
