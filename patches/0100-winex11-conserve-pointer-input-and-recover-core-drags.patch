+            left = XKeysymToKeycode( display, XK_Control_L );
+            right = XKeysymToKeycode( display, XK_Control_R );
+            left_down = left && (keys[left >> 3] >> (left & 7) & 1);
+            right_down = right && (keys[right >> 3] >> (right & 7) & 1);
+        }
