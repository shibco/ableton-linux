+/***********************************************************************
+ *           middle_drag_end
+ *
+ * Let a held-back press go. A press that stayed within the slop becomes a
+ * plain click at the press point. After a drag the cursor is
+ * synced to the X11 release coordinates, so the input that follows lands
+ * where the pointer really is.
+ */
+static BOOL middle_drag_end( XButtonEvent *event, POINT pt, UINT time )
+{
+    struct x11drv_middle_drag *drag = &x11drv_thread_data()->middle_drag;
+
+    if (!drag->active) return FALSE;
+    if (event->button != Button2) return FALSE;
+
+    TRACE( "hwnd %p/%lx end, moved %u\n", drag->hwnd, event->window, drag->moved );
+
+    middle_drag_flush_click( time );
+    if (drag->moved)
+        send_mouse_input( drag->hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    drag->active = FALSE;
+#ifdef XIScrollClass
+    if (drag->moved) middle_drag_throw_release( drag->hwnd, time );
+    else pointer_inertia_cancel();
+#endif
+    return TRUE;
+}
+
+void pointer_input_reset(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+
+    if (!data) return;
+    if (data->middle_drag.active)
+        TRACE( "ptr middle event=cancel hwnd=%p reason=lifecycle\n", data->middle_drag.hwnd );
+    memset( &data->middle_drag, 0, sizeof(data->middle_drag) );
+#ifdef XIScrollClass
+    pointer_inertia_cancel();
+#endif
+#ifdef XI_GesturePinchBegin
+    pinch_gesture_cancel();
+#endif
+#ifdef XIScrollClass
+    xinput2_core_drag_restore( data->display, "lifecycle" );
+#endif
+}
