+    move_y = (long long)drag->last.y - pt.y;
+    drag->accum_x += move_x;
+    drag->accum_y += move_y;
+    drag->last = pt;
+
+    if (!drag->moved)
+    {
+        if (abs( pt.x - drag->origin.x ) <= drag->slop_x &&
+            abs( pt.y - drag->origin.y ) <= drag->slop_y) return TRUE;
