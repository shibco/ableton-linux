+        goto cleanup;
+    }
+    info->bmiHeader.biBitCount = 1;
+    info->bmiColors[0].rgbRed      = 0;
+    info->bmiColors[0].rgbGreen    = 0;
+    info->bmiColors[0].rgbBlue     = 0;
