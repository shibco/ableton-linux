From 45fcca1083661a55cc5821526adf825cfbf3b526 Mon Sep 17 00:00:00 2001
From: ableton-wine <local@ableton-wine>
Date: Wed, 12 Aug 2026 23:53:15 +0200
Subject: [PATCH] winex11: restore pointer inertia and ignore held scroll
 motion

Use the last 100 ms of middle-drag movement. Sum every timed sample.
Assign 24 ms to a single sample or same-time samples. Record fractional
XI2 scroll movement for fine inertia.

Set the default rate to 4.0. Limit each update to 300 units per axis,
each axis to 4,800 units, the total to 7,200 units and each run to 384
updates. Keep the timer, cancellation and missed-frame rules.

Invert both middle-drag navigation axes so dragged content follows the
pointer. Ignore pointer motion from a smooth-scroll report during an
ordinary held-button drag. Keep ordinary drag and physical wheel handling.
---
 dlls/winex11.drv/mouse.c       | 159 +++++++++++++++++----------------
 dlls/winex11.drv/x11drv.h      |   1 +
 dlls/winex11.drv/x11drv_main.c |   2 +-
 3 files changed, 83 insertions(+), 79 deletions(-)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index 729ec0b..ca2c580 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1609,11 +1609,6 @@ static BOOL middle_drag_begin( HWND hwnd, XButtonEvent *event, POINT pt, UINT ti
     drag->slop_x = NtUserGetSystemMetrics( SM_CXDRAG );
     drag->slop_y = NtUserGetSystemMetrics( SM_CYDRAG );
     drag->accum_x = drag->accum_y = 0;
-#ifdef XIScrollClass
-    /* The press is the zero-motion time anchor. One later coherent raw motion
-     * can therefore have a measured velocity even when X coalesces a flick. */
-    middle_drag_throw_sample( x11drv_thread_data(), hwnd, pt, 0.0, 0.0, time );
-#endif
     return TRUE;
 }
 
@@ -1676,20 +1671,12 @@ static BOOL middle_drag_motion( XMotionEvent *event, POINT pt, UINT time )
         return FALSE;
     }
 
-    move_x = pt.x - drag->last.x;
-    move_y = pt.y - drag->last.y;
+    move_x = drag->last.x - pt.x;
+    move_y = drag->last.y - pt.y;
     drag->accum_x += move_x;
     drag->accum_y += move_y;
     drag->last = pt;
 
-#ifdef XIScrollClass
-    /* Record the raw path even inside click slop. A release only evaluates it
-     * after the gesture has independently crossed that slop and become a drag. */
-    if (move_x || move_y)
-        middle_drag_throw_sample( x11drv_thread_data(), drag->hwnd, drag->origin,
-                                  move_x, -move_y, time );
-#endif
-
     if (!drag->moved)
     {
         if (abs( pt.x - drag->origin.x ) <= drag->slop_x &&
@@ -1697,8 +1684,15 @@ static BOOL middle_drag_motion( XMotionEvent *event, POINT pt, UINT time )
         drag->moved = TRUE;
     }
 
-    delta_y = middle_drag_delta( &drag->accum_y, notched );  /* up scrolls up */
-    delta_x = middle_drag_delta( &drag->accum_x, notched );  /* right scrolls right */
+#ifdef XIScrollClass
+    /* Start throw history with the motion that begins navigation. */
+    if (move_x || move_y)
+        middle_drag_throw_sample( x11drv_thread_data(), drag->hwnd, drag->origin,
+                                  move_x, -move_y, time );
+#endif
+
+    delta_y = middle_drag_delta( &drag->accum_y, notched );  /* dragging down scrolls up */
+    delta_x = middle_drag_delta( &drag->accum_x, notched );  /* dragging right scrolls left */
 
     if (delta_y)
     {
@@ -3181,20 +3175,21 @@ static BOOL send_xinput2_wheel_input( HWND hwnd, POINT pt, UINT flags, int delta
 #define INERTIA_DEADLINE_MS  100     /* conservative XI2 inactivity end fallback */
 #define INERTIA_RELEASE_GATE_MS 70   /* reject an end marker after movement has rested */
 #define INERTIA_MIN_SPAN_MS 10       /* minimum timed fine-scroll history */
-#define MIDDLE_THROW_HISTORY_MS 120  /* terminal raw pointer path used at Button2 release */
+#define MIDDLE_THROW_HISTORY_MS 100  /* Button2 release reads this terminal raw pointer path */
 #define MIDDLE_THROW_MAX_GAP_MS 80   /* a longer pause ends the terminal-motion suffix */
 #define MIDDLE_THROW_FALLBACK_SPAN_MS 24 /* time assigned to an untimed coalesced sample */
 #define MIDDLE_THROW_MIN_DISTANCE 4.0 /* reject a terminal path shorter than four pixels */
 #define INERTIA_TICK_MS      8
 #define INERTIA_MAX_FRAME_MS 16      /* discard movement from older missed frames */
-#define INERTIA_MAX_PACKET   (WHEEL_DELTA / 8)
-#define INERTIA_MAX_TRAVEL   (4 * WHEEL_DELTA)
-#define INERTIA_MAX_MESSAGES 224
+#define INERTIA_MAX_PACKET   300
+#define INERTIA_MAX_TRAVEL   (40 * WHEEL_DELTA)
+#define INERTIA_MAX_TOTAL_TRAVEL (60 * WHEEL_DELTA)
+#define INERTIA_MAX_MESSAGES 384
 #define INERTIA_CAP_MS       3000    /* longest coast before the decay is forced steeper */
 #define INERTIA_CAP_RATE     14.0    /* decay rate used after the three-second cap */
 #define INERTIA_START_SPEED  240.0   /* wheel units per second, vector magnitude */
 #define INERTIA_STOP_SPEED   60.0
-#define INERTIA_MAX_SPEED    1200.0
+#define INERTIA_MAX_SPEED    19200.0
 
 #define INERTIA_NUDGE_SLOTS 8
 
@@ -3297,10 +3292,9 @@ static void inertia_nudge_arm( HWND hwnd, LONG input_serial, UINT interval )
         HANDLE thread;
         int ret;
 
-        /* the waits must not follow wall-clock steps (an ntp correction
-         * would stall a deadline or freeze a coast by the step size);
-         * initialise the condition exactly once, before its only waiter
-         * exists. Fail closed unless the clock and condition both succeed. */
+        /* Wall-clock changes must not alter a deadline or coast. Initialise
+         * the condition once, before its only waiter exists. Disable inertia
+         * unless the clock and condition both initialise. */
         if ((ret = pthread_condattr_init( &attr )))
         {
             WARN( "failed to initialise inertia condition attributes (%d), inertia disabled\n", ret );
@@ -3414,11 +3408,11 @@ void pointer_inertia_cancel(void)
 /***********************************************************************
  *           pointer_inertia_record
  *
- * Fine scrolling records delivered wheel units, including a zero unit sample
- * when the cumulative XI2 value changed by less than half a unit. Middle drag
- * records raw screen pixels and converts them only after Button2 release. A
- * different kind, source, or window restarts tracking. Fine-scroll samples
- * re-arm a one-shot inactivity timer; middle tracking waits for Button2 release.
+ * Fine scrolling records the raw fractional wheel units between XI2 reports.
+ * Middle drag records raw screen pixels and converts them only after Button2
+ * release. A different kind, source, or window restarts tracking. Fine-scroll
+ * samples re-arm a one-shot inactivity timer; middle tracking waits for
+ * Button2 release.
  */
 static void pointer_inertia_record( struct x11drv_thread_data *data, enum pointer_inertia_kind kind,
                                     int sourceid, HWND hwnd, POINT anchor,
@@ -3530,14 +3524,7 @@ static BOOL pointer_fine_inertia_velocity( struct x11drv_scroll_inertia *si,
         unsigned int j = (si->pos + i) % INERTIA_HISTORY_SIZE;
 
         if (si->last_time - si->history[j].time > INERTIA_HISTORY_MS) continue;
-        if (!used)
-        {
-            /* The first delta accrued before the window opens. Its timestamp
-             * anchors the span, but its movement cannot be timed safely. */
-            first = last = si->history[j].time;
-            used++;
-            continue;
-        }
+        if (!used) first = si->history[j].time;
         last = si->history[j].time;
         sum_x += si->history[j].dx;
         sum_y += si->history[j].dy;
@@ -3561,7 +3548,6 @@ static BOOL pointer_middle_throw_velocity( struct x11drv_scroll_inertia *si, UIN
     double sum_x = 0.0, sum_y = 0.0, distance;
     UINT first, last, previous, span;
     unsigned int i, j, start;
-    BOOL timed_anchor;
 
     if (!si->count)
     {
@@ -3569,8 +3555,8 @@ static BOOL pointer_middle_throw_velocity( struct x11drv_scroll_inertia *si, UIN
         return FALSE;
     }
 
-    /* Walk backward from the latest sample. This preserves a final burst even
-     * when a long hold or compositor coalescing separated it from the press. */
+    /* Select up to 100 ms of movement ending at the latest sample. Stop at
+     * any gap longer than 80 ms. */
     start = si->count - 1;
     j = (si->pos + start) % INERTIA_HISTORY_SIZE;
     last = previous = si->history[j].time;
@@ -3583,7 +3569,7 @@ static BOOL pointer_middle_throw_velocity( struct x11drv_scroll_inertia *si, UIN
     while (start)
     {
         j = (si->pos + start - 1) % INERTIA_HISTORY_SIZE;
-        if (release_time - si->history[j].time > MIDDLE_THROW_HISTORY_MS ||
+        if (last - si->history[j].time > MIDDLE_THROW_HISTORY_MS ||
             previous - si->history[j].time > MIDDLE_THROW_MAX_GAP_MS) break;
         previous = si->history[j].time;
         start--;
@@ -3591,25 +3577,32 @@ static BOOL pointer_middle_throw_velocity( struct x11drv_scroll_inertia *si, UIN
 
     j = (si->pos + start) % INERTIA_HISTORY_SIZE;
     first = si->history[j].time;
-    timed_anchor = first != last && !si->history[j].dx && !si->history[j].dy;
     span = last - first;
-    if (!timed_anchor) span += MIDDLE_THROW_FALLBACK_SPAN_MS;
 
-    /* A zero press sample is a real time anchor and contributes no movement.
-     * Otherwise include the complete terminal suffix and assign its first,
-     * possibly coalesced delta one conservative input frame. */
-    for (i = start + timed_anchor; i < si->count; i++)
+    /* Sum every selected delta. Give a single sample or same-time samples a
+     * 24 ms interval. Reject distinct timestamps spanning less than 10 ms. */
+    for (i = start; i < si->count; i++)
     {
         j = (si->pos + i) % INERTIA_HISTORY_SIZE;
         sum_x += si->history[j].dx;
         sum_y += si->history[j].dy;
     }
 
-    distance = hypot( sum_x, sum_y );
-    if (distance < MIDDLE_THROW_MIN_DISTANCE)
+    if (si->count - start < 2 || !span)
+    {
+        distance = hypot( sum_x, sum_y );
+        if (distance < MIDDLE_THROW_MIN_DISTANCE)
+        {
+            TRACE( "middle throw fallback rejected: terminal distance %.3f pixels\n",
+                   distance );
+            return FALSE;
+        }
+        span = MIDDLE_THROW_FALLBACK_SPAN_MS;
+    }
+    else if (span < INERTIA_MIN_SPAN_MS)
     {
-        TRACE( "middle throw rejected: terminal distance %.3f pixels over %u ms\n",
-               distance, span );
+        TRACE( "middle throw rejected: %u timed samples over %u ms\n",
+               si->count - start, span );
         return FALSE;
     }
 
@@ -3621,9 +3614,8 @@ static BOOL pointer_middle_throw_velocity( struct x11drv_scroll_inertia *si, UIN
 /***********************************************************************
  *           pointer_inertia_evaluate
  *
- * Fine-scroll velocity is measured in accepted wheel units. Middle drag uses
- * a separate raw-pixel terminal-motion estimator and converts to wheel units
- * only here, after the real Button2 release.
+ * The fine-scroll estimator reads raw fractional wheel units. The middle-drag
+ * estimator reads raw screen pixels and converts them after Button2 release.
  */
 static void pointer_inertia_evaluate( struct x11drv_thread_data *data, UINT now,
                                       enum pointer_inertia_end_reason reason )
@@ -3667,6 +3659,7 @@ static void pointer_inertia_evaluate( struct x11drv_thread_data *data, UINT now,
     si->vy = si->v0y = vy;
     si->rem_x = si->rem_y = 0.0;
     si->travel_x = si->travel_y = 0;
+    si->travel_total = 0;
     si->message_count = 0;
     si->start_time = si->last_tick = now;
 
@@ -3748,16 +3741,16 @@ static void middle_drag_throw_release( struct x11drv_thread_data *data, HWND hwn
 /***********************************************************************
  *           pointer_inertia_packet
  *
- * Bound one axis independently. Whole-unit output beyond the packet cap is
- * discarded instead of becoming debt for a later tick; only its sub-unit
- * remainder survives. Four notches per axis bounds deliberately slow custom
- * curves while preserving the natural default-rate coast. A shared packet
- * budget remains a final backstop.
+ * Drop whole-unit output beyond each limit instead of sending it later. Keep
+ * the sub-unit remainder. The limits do not shorten movement at the default
+ * rate.
  */
-static int pointer_inertia_packet( double *remainder, double *velocity, int *travel )
+static int pointer_inertia_packet( double *remainder, double *velocity,
+                                   int *travel, int *travel_total )
 {
     int available = (int)*remainder;
-    int remaining = INERTIA_MAX_TRAVEL - *travel;
+    int remaining = min( INERTIA_MAX_TRAVEL - *travel,
+                         INERTIA_MAX_TOTAL_TRAVEL - *travel_total );
     int delta;
 
     *remainder -= available;
@@ -3774,7 +3767,9 @@ static int pointer_inertia_packet( double *remainder, double *velocity, int *tra
     else if (delta < -remaining) delta = -remaining;
 
     *travel += abs( delta );
-    if (*travel >= INERTIA_MAX_TRAVEL) *remainder = *velocity = 0.0;
+    *travel_total += abs( delta );
+    if (*travel >= INERTIA_MAX_TRAVEL || *travel_total >= INERTIA_MAX_TOTAL_TRAVEL)
+        *remainder = *velocity = 0.0;
     return delta;
 }
 
@@ -3920,7 +3915,8 @@ void pointer_inertia_tick(LONG input_serial)
     }
 
     if (si->message_count < INERTIA_MAX_MESSAGES &&
-        (delta = pointer_inertia_packet( &si->rem_y, &si->vy, &si->travel_y )))
+        (delta = pointer_inertia_packet( &si->rem_y, &si->vy,
+                                         &si->travel_y, &si->travel_total )))
     {
         si->message_count++;
         TRACE( "coast wheel %d\n", delta );
@@ -3934,7 +3930,8 @@ void pointer_inertia_tick(LONG input_serial)
         }
     }
     if (si->message_count < INERTIA_MAX_MESSAGES &&
-        (delta = pointer_inertia_packet( &si->rem_x, &si->vx, &si->travel_x )))
+        (delta = pointer_inertia_packet( &si->rem_x, &si->vx,
+                                         &si->travel_x, &si->travel_total )))
     {
         si->message_count++;
         TRACE( "coast hwheel %d\n", delta );
@@ -3950,11 +3947,11 @@ void pointer_inertia_tick(LONG input_serial)
 
     if (si->message_count >= INERTIA_MAX_MESSAGES ||
         hypot( si->vx, si->vy ) < INERTIA_STOP_SPEED ||
-        now - si->start_time > INERTIA_CAP_MS + 1000)  /* backstop after the raised decay rate */
+        now - si->start_time > INERTIA_CAP_MS + 1000)  /* stop after four seconds */
     {
-        TRACE( "%s ends: velocity %.3f,%.3f, travel %d,%d, messages %u%s%s%s\n",
+        TRACE( "%s ends: velocity %.3f,%.3f, travel %d,%d total %d, messages %u%s%s%s\n",
                si->kind == POINTER_INERTIA_KIND_MIDDLE_DRAG ? "middle throw" : "fine inertia",
-               si->vx, si->vy, si->travel_x, si->travel_y, si->message_count,
+               si->vx, si->vy, si->travel_x, si->travel_y, si->travel_total, si->message_count,
                si->message_count >= INERTIA_MAX_MESSAGES ? ", message limit" : "",
                hypot( si->vx, si->vy ) < INERTIA_STOP_SPEED ? ", speed floor" : "",
                now - si->start_time > INERTIA_CAP_MS + 1000 ? ", time limit" : "" );
@@ -3991,6 +3988,7 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
     BOOL stop_marker = FALSE, scroll_changed = FALSE;
     BOOL discontinuity = FALSE;
     BOOL quantize, buttons_down;
+    double units_x = 0.0, units_y = 0.0;
     int delta_x = 0, delta_y = 0;
     HWND hwnd;
 
@@ -4054,17 +4052,18 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
         return TRUE;
     }
 
-    /* Forward co-reported pointer motion before wheel delivery. This updates
-     * the cursor or consumes the motion as part of an active
-     * middle drag. */
-    if (saw_motion) forward_xinput2_core_event( hwnd, event, TRUE );
-
-    /* A clickpad thumb-hold with a moving finger can classify as two-finger
-     * scroll. Reseed held-button reports instead of emitting wheel input into
-     * the control under the drag; no suppressed movement survives release. */
+    /* While the user holds any button, keep scroll baselines current without
+     * sending smooth wheel input to the dragged control. */
     buttons_down = xinput2_any_button_down( event );
     quantize = pointer_config.smooth_scrolling == POINTER_SCROLL_NOTCHED;
 
+    /* Ignore pointer motion from a smooth-scroll report during an ordinary
+     * button drag. Continue sending this motion during middle navigation. */
+    if (saw_motion && (!buttons_down || data->middle_drag.active))
+        forward_xinput2_core_event( hwnd, event, TRUE );
+    else if (saw_motion)
+        TRACE( "Wine ignores pointer motion from a scroll report while a button is held\n" );
+
     /* A same-value report remains an explicit end hint. A changed report is
      * activity even if wheel-unit rounding produces zero below. */
     stop_marker = (have_x || have_y) &&
@@ -4072,6 +4071,10 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
                   (!have_y || (src->scroll_y.last_value_valid && value_y == src->scroll_y.last_value));
     scroll_changed = (have_x && src->scroll_x.last_value_valid && value_x != src->scroll_x.last_value) ||
                      (have_y && src->scroll_y.last_value_valid && value_y != src->scroll_y.last_value);
+    if (have_x && src->scroll_x.last_value_valid)
+        units_x = WHEEL_DELTA * (value_x - src->scroll_x.last_value) / src->scroll_x.increment;
+    if (have_y && src->scroll_y.last_value_valid)
+        units_y = WHEEL_DELTA * (value_y - src->scroll_y.last_value) / src->scroll_y.increment;
     if (have_x) { src->scroll_x.last_value = value_x; src->scroll_x.last_value_valid = TRUE; }
     if (have_y) { src->scroll_y.last_value = value_y; src->scroll_y.last_value_valid = TRUE; }
 
@@ -4098,7 +4101,7 @@ static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
         if (stop_marker) pointer_inertia_stop_marker( data, event->sourceid, hwnd, time );
         else if (scroll_changed)
             pointer_scroll_inertia_activity( data, event->sourceid, hwnd, pt,
-                                             delta_x, -delta_y, time );
+                                             units_x, -units_y, time );
     }
     else pointer_inertia_cancel();
 
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index ad53b50..1c38c39 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -567,6 +567,7 @@ struct x11drv_scroll_inertia
     double v0x, v0y;      /* velocity at coast begin, for the linear curve */
     double rem_x, rem_y;  /* sub-unit wheel remainder carried across ticks */
     int travel_x, travel_y; /* absolute wheel units emitted by this coast */
+    int travel_total;     /* counts absolute wheel units across both axes */
     unsigned int message_count; /* packets attempted by this coast */
 };
 
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 2b8d8ad..c655e55 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -426,7 +426,7 @@ struct x11drv_pointer_config pointer_config =
     .wheel_while_button_held = POINTER_WHEEL_WHILE_BUTTON_HELD_ENABLED,
     .inertia_curve    = POINTER_INERTIA_CURVE_EXPONENTIAL,
     .warp_emulation   = POINTER_WARP_DISABLED,
-    .inertia_rate     = 3.0,
+    .inertia_rate     = 4.0,
 };
 
