diff --git a/include/wine/winedxgi.idl b/include/wine/winedxgi.idl
index fff00de..d59013e 100644
--- a/include/wine/winedxgi.idl
+++ b/include/wine/winedxgi.idl
@@ -20,6 +20,19 @@
 
 import "dxgi1_6.idl";
 
+/* Desktop-property name format mapping a composition swapchain to its
+ * composition window.  Shared verbatim by dxgi (setter) and dcomp (getter);
+ * keeping it in one place here is the only guard against the two DLLs'
+ * copies diverging silently.  The key is the swapchain pointer together with
+ * the owning process id: the desktop window's property list is shared across
+ * the whole window station, so an address-only key can collide between
+ * processes that happen to allocate a swapchain at the same address (e.g. a
+ * host app and its webview2 child).  The process id scopes each process's
+ * address space apart; within a single process the ownership check in
+ * d3d11_swapchain_Release keeps a recycled address from stranding a live
+ * window. */
+cpp_quote("#define WINE_DCOMP_WND_PROP_FMT L\"__wine_dcomp_wnd_%lu_%I64x\"")
+
 [
     object,
     local,
