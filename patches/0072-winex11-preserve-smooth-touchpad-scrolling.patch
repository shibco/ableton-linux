+#ifdef XIScrollClass
+
+static int smooth_scroll_delta( struct x11drv_scroll_axis *axis, double value, BOOL emulated )
+{
+    static const int max_delta = 16 * WHEEL_DELTA;
+    double units;
+    int delta;
+
+    if (!axis->value_valid || emulated)
+    {
+        axis->value = value;
+        axis->value_valid = TRUE;
+        return 0;
+    }
+
+    units = WHEEL_DELTA * (value - axis->value) / axis->increment;
+    if ((delta = round( units )) > max_delta) delta = max_delta;
+    else if (delta < -max_delta) delta = -max_delta;
+    if (smooth_scroll_notched()) delta = (delta / WHEEL_DELTA) * WHEEL_DELTA;
+    /* advance by what was reported, so the rest carries into the next report */
+    axis->value += (double)delta * axis->increment / WHEEL_DELTA;
+    return delta;
+}
+
+static unsigned int xinput2_core_state( const XIDeviceEvent *event )
+{
+    unsigned int state = event->mods.effective;
+    int button;
+
+    /* XIButtonState uses button numbers as bit indices.  Core X state only
+     * has masks for the first five buttons, which is all the existing core
+     * handlers inspect. */
+    for (button = 1; button <= 5; button++)
+        if (button / 8 < event->buttons.mask_len && XIMaskIsSet( event->buttons.mask, button ))
+            state |= Button1Mask << (button - 1);
+    return state;
+}
+
+static BOOL xinput2_any_button_down( const XIDeviceEvent *event )
+{
+    int button;
+
+    for (button = 1; button < event->buttons.mask_len * 8; button++)
+        if (XIMaskIsSet( event->buttons.mask, button )) return TRUE;
+    return FALSE;
+}
+
+/***********************************************************************
+ *           forward_xinput2_core_event
+ *
+ * Selecting a master-device XI event prevents the X server from delivering
+ * its core equivalent.  Feed non-scroll button events and motion through
+ * Wine's existing core handlers so smooth scrolling does not replace normal
+ * pointer input.
+ */
+static BOOL forward_xinput2_core_event( HWND hwnd, XIDeviceEvent *event )
+{
+    XEvent core = {0};
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        core.xbutton.type = event->evtype == XI_ButtonPress ? ButtonPress : ButtonRelease;
+        core.xbutton.serial = event->serial;
+        core.xbutton.send_event = event->send_event;
+        core.xbutton.display = event->display;
+        core.xbutton.window = event->event;
+        core.xbutton.root = event->root;
+        core.xbutton.subwindow = event->child;
+        core.xbutton.time = event->time;
+        core.xbutton.x = event->event_x;
+        core.xbutton.y = event->event_y;
+        core.xbutton.x_root = event->root_x;
+        core.xbutton.y_root = event->root_y;
+        core.xbutton.state = xinput2_core_state( event );
+        core.xbutton.button = event->detail;
+        core.xbutton.same_screen = True;
+        if (event->evtype == XI_ButtonPress) return X11DRV_ButtonPress( hwnd, &core );
+        return X11DRV_ButtonRelease( hwnd, &core );
+    }
+
+    core.xmotion.type = MotionNotify;
+    core.xmotion.serial = event->serial;
+    core.xmotion.send_event = event->send_event;
+    core.xmotion.display = event->display;
+    core.xmotion.window = event->event;
+    core.xmotion.root = event->root;
+    core.xmotion.subwindow = event->child;
+    core.xmotion.time = event->time;
+    core.xmotion.x = event->event_x;
+    core.xmotion.y = event->event_y;
+    core.xmotion.x_root = event->root_x;
+    core.xmotion.y_root = event->root_y;
+    core.xmotion.state = xinput2_core_state( event );
+    core.xmotion.is_hint = NotifyNormal;
+    core.xmotion.same_screen = True;
+    return X11DRV_MotionNotify( hwnd, &core );
+}
+
+/* milliseconds of scroll reports the fling velocity sums */
+#define SCROLL_INERTIA_WINDOW 100
+/* quiet time before a gesture may turn into a fling, and before the thread sleeps */
+#define SCROLL_INERTIA_QUIET 50
+#define SCROLL_INERTIA_IDLE 100
+/* milliseconds between fling steps, and the longest a fling may run */
+#define SCROLL_INERTIA_TICK 16
+#define SCROLL_INERTIA_CAP 3000
+/* wheel units a second: below MIN no fling starts, below FLOOR a fling ends */
+#define SCROLL_INERTIA_MIN 60.0
+#define SCROLL_INERTIA_FLOOR 30.0
+
+enum scroll_inertia_state { INERTIA_IDLE, INERTIA_ACTIVE, INERTIA_FLING };
+
+static struct
+{
+    enum scroll_inertia_state state;
+    ULONG generation;           /* bumped by every cancellation */
+    DWORD last_tick;            /* time of the last scroll report */
+    HWND hwnd;                  /* window the running gesture reports at */
+    POINT pt;                   /* window coordinates it reports at */
+    struct
+    {
+        DWORD tick;
+        int delta_x, delta_y;   /* wheel units the application was sent */
+    } samples[8];
+    unsigned int count, pos;
+    HANDLE wake_event;
+    HANDLE thread;
+    BOOL failed;
+} scroll_inertia;
+
+/* this is unix-side code, where the codebase locks with pthread (see kbd_mutex) */
+static pthread_mutex_t scroll_inertia_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/***********************************************************************
+ *              scroll_inertia_enabled
+ *
+ * WINE_X11_SCROLL_INERTIA=off keeps the scroll at the reports the device
+ * sent. Default on, where the end of a gesture decays into a fling.
+ */
+static BOOL scroll_inertia_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv( "WINE_X11_SCROLL_INERTIA" );
+        if (!value || !strcmp( value, "on" ) || !strcmp( value, "1" )) enabled = TRUE;
+        else if (!strcmp( value, "off" ) || !strcmp( value, "0" )) enabled = FALSE;
+        else
+        {
+            WARN( "unrecognized WINE_X11_SCROLL_INERTIA=%s, using on\n", debugstr_a( value ));
+            enabled = TRUE;
+        }
+    }
+    return enabled;
+}
+
+/***********************************************************************
+ *              scroll_inertia_friction
+ *
+ * WINE_X11_SCROLL_INERTIA_FRICTION is the decay rate of a fling, a fraction
+ * of its velocity lost per second (1/s). The default 3.0 halves the
+ * velocity about four times a second. For the linear curve it scales the
+ * constant deceleration so both curves share their initial slope.
+ */
+static double scroll_inertia_friction(void)
+{
+    static double friction = -1.0;
+    const char *value;
+    char *end;
+    double parsed;
+
+    if (friction < 0)
+    {
+        friction = 3.0;
+        if ((value = getenv( "WINE_X11_SCROLL_INERTIA_FRICTION" )))
+        {
+            parsed = strtod( value, &end );
+            if (end == value || *end || parsed <= 0.0)
+                WARN( "unrecognized WINE_X11_SCROLL_INERTIA_FRICTION=%s, using %f\n",
+                      debugstr_a( value ), friction );
+            else friction = parsed;
+        }
+    }
+    return friction;
+}
+
+/***********************************************************************
+ *              scroll_inertia_linear
+ *
+ * WINE_X11_SCROLL_INERTIA_CURVE=linear decays a fling at a constant rate
+ * instead of the default exponential decay.
+ */
+static BOOL scroll_inertia_linear(void)
+{
+    static int linear = -1;
+    const char *value;
+
+    if (linear == -1)
+    {
+        value = getenv( "WINE_X11_SCROLL_INERTIA_CURVE" );
+        if (!value || !strcmp( value, "expo" )) linear = FALSE;
+        else if (!strcmp( value, "linear" )) linear = TRUE;
+        else
+        {
+            WARN( "unrecognized WINE_X11_SCROLL_INERTIA_CURVE=%s, using expo\n", debugstr_a( value ));
+            linear = FALSE;
+        }
+    }
+    return linear;
+}
+
+/* sum the reports of the trailing SCROLL_INERTIA_WINDOW ms, in wheel units a second */
+static void scroll_inertia_velocity( DWORD now, double *vx, double *vy )
+{
+    unsigned int i;
+    int sum_x = 0, sum_y = 0;
+
+    for (i = 0; i < scroll_inertia.count; i++)
+    {
+        unsigned int j = (scroll_inertia.pos + i) % ARRAY_SIZE( scroll_inertia.samples );
+
+        if (now - scroll_inertia.samples[j].tick > SCROLL_INERTIA_WINDOW) continue;
+        sum_x += scroll_inertia.samples[j].delta_x;
+        sum_y += scroll_inertia.samples[j].delta_y;
+    }
+    *vx = sum_x * (1000.0 / SCROLL_INERTIA_WINDOW);
+    *vy = sum_y * (1000.0 / SCROLL_INERTIA_WINDOW);
+}
+
+static double scroll_inertia_decay_linear( double v, double v0, double friction, DWORD dt )
+{
+    /* same initial slope as the exponential: dv/dt = -friction * v0 */
+    double dec = friction * fabs( v0 ) * dt / 1000.0;
+
+    if (v > 0) return max( 0.0, v - dec );
+    return min( 0.0, v + dec );
+}
+
+/***********************************************************************
+ *           scroll_inertia_thread
+ *
+ * Decay a gesture's final velocity into wheel input after its reports stop,
+ * the way macOS keeps scrolling after a flick. The thread only makes
+ * wineserver calls; the X display belongs to the event thread.
+ */
+static void CALLBACK scroll_inertia_thread( void *arg )
+{
+    HANDLE wake_event = scroll_inertia.wake_event;
+    LARGE_INTEGER timeout;
+
+    for (;;)
+    {
+        ULONG generation;
+        double vx, vy, v0x, v0y, rem_x, rem_y, friction;
+        DWORD start, last, now, quiet;
+        BOOL linear;
+
+        /* block until the first report of a gesture wakes the thread */
+        NtWaitForSingleObject( wake_event, FALSE, NULL );
+
+        for (;;)
+        {
+            timeout.QuadPart = -(LONGLONG)SCROLL_INERTIA_TICK * 10000;
+            NtWaitForSingleObject( wake_event, FALSE, &timeout );  /* doubles as the poll sleep */
+            now = NtGetTickCount();
+
+            pthread_mutex_lock( &scroll_inertia_mutex );
+            quiet = now - scroll_inertia.last_tick;
+            if (quiet > SCROLL_INERTIA_IDLE)
+            {
+                scroll_inertia.state = INERTIA_IDLE;
+                pthread_mutex_unlock( &scroll_inertia_mutex );
+                break;
+            }
+            if (quiet <= SCROLL_INERTIA_QUIET)
+            {
+                pthread_mutex_unlock( &scroll_inertia_mutex );
+                continue;
+            }
+
+            scroll_inertia_velocity( now, &vx, &vy );
+            if (fabs( vx ) < SCROLL_INERTIA_MIN && fabs( vy ) < SCROLL_INERTIA_MIN)
+            {
+                /* too slow to fling; keep polling until the gesture idles out */
+                pthread_mutex_unlock( &scroll_inertia_mutex );
+                continue;
+            }
+
+            /* consume the samples, so the fling can never restart from them */
+            scroll_inertia.count = 0;
+            scroll_inertia.state = INERTIA_FLING;
+            generation = scroll_inertia.generation;
+            pthread_mutex_unlock( &scroll_inertia_mutex );
+
+            v0x = vx;
+            v0y = vy;
+            rem_x = rem_y = 0.0;
+            friction = scroll_inertia_friction();
+            linear = scroll_inertia_linear();
+            start = last = now;
+
+            TRACE( "fling start velocity %f,%f\n", vx, vy );
+
+            for (;;)
+            {
+                HWND hwnd;
+                POINT pt;
+                DWORD dt;
+                int delta_x, delta_y;
+
+                timeout.QuadPart = -(LONGLONG)SCROLL_INERTIA_TICK * 10000;
+                NtWaitForSingleObject( wake_event, FALSE, &timeout );
+                now = NtGetTickCount();
+                if (!(dt = now - last)) continue;
+                last = now;
+
+                /* a held Ctrl means a pinch zoom or a manual Ctrl+wheel */
+                if (NtUserGetAsyncKeyState( VK_CONTROL ) & 0x8000)
+                {
+                    pthread_mutex_lock( &scroll_inertia_mutex );
+                    scroll_inertia.generation++;
+                    scroll_inertia.count = 0;
+                    scroll_inertia.state = INERTIA_ACTIVE;
+                    pthread_mutex_unlock( &scroll_inertia_mutex );
+                    break;
+                }
+
+                pthread_mutex_lock( &scroll_inertia_mutex );
+                if (scroll_inertia.generation != generation)  /* cancelled */
+                {
+                    pthread_mutex_unlock( &scroll_inertia_mutex );
+                    break;
+                }
+                if (now - start > SCROLL_INERTIA_CAP)
+                {
+                    scroll_inertia.state = INERTIA_ACTIVE;
+                    pthread_mutex_unlock( &scroll_inertia_mutex );
+                    break;
+                }
+
+                if (linear)
+                {
+                    vx = scroll_inertia_decay_linear( vx, v0x, friction, dt );
+                    vy = scroll_inertia_decay_linear( vy, v0y, friction, dt );
+                }
+                else
+                {
+                    double factor = exp( -friction * dt / 1000.0 );
+
+                    vx *= factor;
+                    vy *= factor;
+                }
+
+                if (fabs( vx ) < SCROLL_INERTIA_FLOOR && fabs( vy ) < SCROLL_INERTIA_FLOOR)
+                {
+                    scroll_inertia.state = INERTIA_ACTIVE;
+                    pthread_mutex_unlock( &scroll_inertia_mutex );
+                    break;
+                }
+
+                rem_x += vx * dt / 1000.0;
+                rem_y += vy * dt / 1000.0;
+                delta_x = (int)rem_x;
+                rem_x -= delta_x;
+                delta_y = (int)rem_y;
+                rem_y -= delta_y;
+                hwnd = scroll_inertia.hwnd;
+                pt = scroll_inertia.pt;
+                pthread_mutex_unlock( &scroll_inertia_mutex );
+
+                if (delta_y) send_wheel_input( hwnd, pt, MOUSEEVENTF_WHEEL, delta_y, FALSE, now );
+                if (delta_x) send_wheel_input( hwnd, pt, MOUSEEVENTF_HWHEEL, delta_x, FALSE, now );
+            }
+        }
+    }
+}
+
+/* start the inertia thread; called with scroll_inertia_mutex held */
+static BOOL scroll_inertia_start_thread(void)
+{
+    if (!scroll_inertia.wake_event &&
+        NtCreateEvent( &scroll_inertia.wake_event, EVENT_ALL_ACCESS, NULL, SynchronizationEvent, FALSE ))
+        return FALSE;
+    /* NtCreateThreadEx is what the unix side of ntdll exports for this */
+    return !NtCreateThreadEx( &scroll_inertia.thread, THREAD_ALL_ACCESS, NULL, NtCurrentProcess(),
+                              scroll_inertia_thread, NULL, 0, 0, 0, 0, NULL );
+}
+
+/***********************************************************************
+ *           scroll_inertia_cancel
+ *
+ * Cancel any fling for input outside the scroll valuators: a button press,
+ * or a core wheel step. The generation bump keeps the fling thread from
+ * emitting or restarting with what it already sampled.
+ */
+static void scroll_inertia_cancel(void)
+{
+    if (!xinput2_smooth_scroll) return;
+
+    pthread_mutex_lock( &scroll_inertia_mutex );
+    scroll_inertia.generation++;
+    scroll_inertia.count = 0;
+    if (scroll_inertia.state == INERTIA_FLING) scroll_inertia.state = INERTIA_ACTIVE;
+    pthread_mutex_unlock( &scroll_inertia_mutex );
+}
+
+/***********************************************************************
+ *           scroll_inertia_sample
+ *
+ * Record what one scroll report sent to the application, so a fling can
+ * continue from exactly that. Wakes the inertia thread on the first report
+ * of a gesture; any further report cancels a fling still running, and a
+ * report for another window starts its gesture over.
+ */
+static void scroll_inertia_sample( HWND hwnd, POINT pt, int delta_x, int delta_y )
+{
+    DWORD now = NtGetTickCount();
+
+    if (!scroll_inertia_enabled()) return;
+
+    pthread_mutex_lock( &scroll_inertia_mutex );
+
+    if (scroll_inertia.state == INERTIA_FLING || hwnd != scroll_inertia.hwnd)
+    {
+        scroll_inertia.generation++;
+        scroll_inertia.count = 0;
+        if (scroll_inertia.state == INERTIA_FLING) scroll_inertia.state = INERTIA_ACTIVE;
+    }
+
+    scroll_inertia.hwnd = hwnd;
+    scroll_inertia.pt = pt;
+    scroll_inertia.last_tick = now;
+
+    if (delta_x || delta_y)
+    {
+        unsigned int i;
+
+        if (scroll_inertia.count == ARRAY_SIZE( scroll_inertia.samples ))
+            scroll_inertia.pos = (scroll_inertia.pos + 1) % ARRAY_SIZE( scroll_inertia.samples );
+        else
+            scroll_inertia.count++;
+        i = (scroll_inertia.pos + scroll_inertia.count - 1) % ARRAY_SIZE( scroll_inertia.samples );
+        scroll_inertia.samples[i].tick = now;
+        scroll_inertia.samples[i].delta_x = delta_x;
+        scroll_inertia.samples[i].delta_y = delta_y;
+    }
+
+    if (scroll_inertia.state == INERTIA_IDLE && !scroll_inertia.failed)
+    {
+        if (!scroll_inertia.thread && !scroll_inertia_start_thread())
+        {
+            WARN( "failed to start the scroll inertia thread, inertia disabled\n" );
+            scroll_inertia.failed = TRUE;
+        }
+        else
+        {
+            scroll_inertia.state = INERTIA_ACTIVE;
+            NtSetEvent( scroll_inertia.wake_event, NULL );
+        }
+    }
+
+    pthread_mutex_unlock( &scroll_inertia_mutex );
+}
+
+/* latest value of each scroll axis in one event, and whether it carries motion */
+static void scan_scroll_valuators( XIDeviceEvent *event, struct x11drv_scroll_source *src,
+                                   double *value_x, double *value_y, BOOL *have_x, BOOL *have_y,
+                                   BOOL *saw_motion )
+{
+    const double *values = event->valuators.values;
+    int i;
+
+    for (i = 0; i < event->valuators.mask_len * 8; i++)
+    {
+        if (!XIMaskIsSet( event->valuators.mask, i )) continue;
+        if (i == src->scroll_x.number) { *value_x = *values; *have_x = TRUE; }
+        else if (i == src->scroll_y.number) { *value_y = *values; *have_y = TRUE; }
+        else if (i < 2) *saw_motion = TRUE;  /* valuators 0 and 1 are the pointer */
+        values++;
+    }
+}
+
+/***********************************************************************
+ *           X11DRV_SmoothScrollEvent
+ *
+ * XInput2 reports touchpad and high-resolution wheel scrolling as cumulative
+ * valuator positions. Turn the change into fractional Win32 wheel units and
+ * ignore the legacy button events the X server emulates from the same input.
+ */
+static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
+{
+    XIDeviceEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_source *src;
+    struct x11drv_win_data *win_data;
+    POINT pt = { event->event_x, event->event_y }, root = { event->root_x, event->root_y };
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    BOOL emulated = event->flags & XIPointerEmulated;
+    double value_x = 0, value_y = 0;
+    BOOL have_x = FALSE, have_y = FALSE, saw_motion = FALSE;
+    int delta_x = 0, delta_y = 0;
+    HWND hwnd;
+
+    if (!xinput2_smooth_scroll) return FALSE;
+    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        int button = event->detail - 1;
+
+        if (event->evtype == XI_ButtonPress) scroll_inertia_cancel();
+        if (button < 3 || button > 6) return forward_xinput2_core_event( hwnd, event );
+        if (event->evtype == XI_ButtonRelease || emulated) return TRUE;
+
+        if ((win_data = get_win_data( hwnd )))
+        {
+            window_set_user_time( win_data, event->time, FALSE );
+            release_win_data( win_data );
+        }
+        pt = map_event_coords( hwnd, event->event, event->root, root, pt );
+        send_wheel_input( hwnd, pt, button_down_flags[button], (int)button_down_data[button], FALSE, time );
+        return TRUE;
+    }
+
+    if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
+    {
+        /* a device is queried once, when first seen; its axes and baselines
+         * stay cached after that, so alternating devices costs nothing */
+        query_scroll_valuators( event->display, event->sourceid );
+        if (!(src = find_scroll_source( data, event->sourceid, FALSE )))
+            return forward_xinput2_core_event( hwnd, event );
+    }
+
+    scan_scroll_valuators( event, src, &value_x, &value_y, &have_x, &have_y, &saw_motion );
+    if (!have_x && !have_y) return forward_xinput2_core_event( hwnd, event );
+
+    if (emulated)
+    {
+        /* the emulated report only refreshes the baseline; the same movement
+         * arrives as core wheel buttons */
+        if (have_x) smooth_scroll_delta( &src->scroll_x, value_x, TRUE );
+        if (have_y) smooth_scroll_delta( &src->scroll_y, value_y, TRUE );
+        return TRUE;
+    }
+
+    if (have_x) delta_x = smooth_scroll_delta( &src->scroll_x, value_x, FALSE );
+    if (have_y) delta_y = smooth_scroll_delta( &src->scroll_y, value_y, FALSE );
+
+    pt = map_event_coords( hwnd, event->event, event->root, root, pt );
+
+    TRACE( "hwnd %p/%lx smooth scroll delta %d,%d\n", hwnd, event->event, delta_x, delta_y );
+
+    /* macOS delivers no scroll while a button is held: a clickpad thumb-hold
+     * with a moving finger reports two-finger scroll, and a dragged control
+     * would follow the noise. The baselines advanced above, so the first
+     * scroll after the release does not jump by the dragged distance, and the
+     * press itself already cancelled any running fling. */
+    if (!xinput2_any_button_down( event ))
+    {
+        if (delta_x || delta_y)
+        {
+            if ((win_data = get_win_data( hwnd )))
+            {
+                window_set_user_time( win_data, event->time, FALSE );
+                release_win_data( win_data );
+            }
+            if (delta_y) send_wheel_input( hwnd, pt, MOUSEEVENTF_WHEEL, -delta_y, FALSE, time );
+            if (delta_x) send_wheel_input( hwnd, pt, MOUSEEVENTF_HWHEEL, delta_x, FALSE, time );
+        }
+
+        if (!smooth_scroll_notched()) scroll_inertia_sample( hwnd, pt, delta_x, -delta_y );
+    }
+
+    /* a report can carry pointer motion next to the scroll axes */
+    if (saw_motion) forward_xinput2_core_event( hwnd, event );
+    return TRUE;
+}
