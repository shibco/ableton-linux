 }
 
+#ifdef XIScrollClass
+
+static int smooth_scroll_delta( struct x11drv_scroll_axis *axis, double value, BOOL emulated )
+{
+    static const int max_delta = 16 * WHEEL_DELTA;
+    double units;
+    int delta;
+
+    if (!axis->value_valid || emulated)
+    {
+        axis->value = value;
+        axis->value_valid = TRUE;
+        return 0;
+    }
+
+    units = WHEEL_DELTA * (value - axis->value) / axis->increment;
+    if ((delta = round( units )) > max_delta) delta = max_delta;
+    else if (delta < -max_delta) delta = -max_delta;
+    axis->value += (double)delta * axis->increment / WHEEL_DELTA;
+    return delta;
+}
+
+static unsigned int xinput2_core_state( const XIDeviceEvent *event )
+{
+    unsigned int state = event->mods.effective;
+    int button;
+
+    /* XIButtonState uses button numbers as bit indices.  Core X state only
+     * has masks for the first five buttons, which is all the existing core
+     * handlers inspect. */
+    for (button = 1; button <= 5; button++)
+        if (button / 8 < event->buttons.mask_len && XIMaskIsSet( event->buttons.mask, button ))
+            state |= Button1Mask << (button - 1);
+    return state;
+}
+
+/***********************************************************************
+ *           forward_xinput2_core_event
+ *
+ * Selecting a master-device XI event prevents the X server from delivering
+ * its core equivalent.  Feed non-scroll button events and motion through
+ * Wine's existing core handlers so smooth scrolling does not replace normal
+ * pointer input.
+ */
+static BOOL forward_xinput2_core_event( HWND hwnd, XIDeviceEvent *event )
+{
+    XEvent core = {0};
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        core.xbutton.type = event->evtype == XI_ButtonPress ? ButtonPress : ButtonRelease;
+        core.xbutton.serial = event->serial;
+        core.xbutton.send_event = event->send_event;
+        core.xbutton.display = event->display;
+        core.xbutton.window = event->event;
+        core.xbutton.root = event->root;
+        core.xbutton.subwindow = event->child;
+        core.xbutton.time = event->time;
+        core.xbutton.x = event->event_x;
+        core.xbutton.y = event->event_y;
+        core.xbutton.x_root = event->root_x;
+        core.xbutton.y_root = event->root_y;
+        core.xbutton.state = xinput2_core_state( event );
+        core.xbutton.button = event->detail;
+        core.xbutton.same_screen = True;
+        if (event->evtype == XI_ButtonPress) return X11DRV_ButtonPress( hwnd, &core );
+        return X11DRV_ButtonRelease( hwnd, &core );
+    }
+
+    core.xmotion.type = MotionNotify;
+    core.xmotion.serial = event->serial;
+    core.xmotion.send_event = event->send_event;
+    core.xmotion.display = event->display;
+    core.xmotion.window = event->event;
+    core.xmotion.root = event->root;
+    core.xmotion.subwindow = event->child;
+    core.xmotion.time = event->time;
+    core.xmotion.x = event->event_x;
+    core.xmotion.y = event->event_y;
+    core.xmotion.x_root = event->root_x;
+    core.xmotion.y_root = event->root_y;
+    core.xmotion.state = xinput2_core_state( event );
+    core.xmotion.is_hint = NotifyNormal;
+    core.xmotion.same_screen = True;
+    return X11DRV_MotionNotify( hwnd, &core );
+}
+
+/***********************************************************************
+ *           X11DRV_SmoothScrollEvent
+ *
+ * XInput2 reports touchpad and high-resolution wheel scrolling as cumulative
+ * valuator positions. Turn the change into fractional Win32 wheel units and
+ * ignore the legacy button events the X server emulates from the same input.
+ */
+static BOOL X11DRV_SmoothScrollEvent( XGenericEventCookie *xev )
+{
+    XIDeviceEvent *event = xev->data;
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    POINT pt = { event->event_x, event->event_y }, root = { event->root_x, event->root_y };
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    BOOL emulated = event->flags & XIPointerEmulated;
+    const double *values = event->valuators.values;
+    int i, delta_x = 0, delta_y = 0;
+    BOOL saw_scroll = FALSE;
+    HWND hwnd;
+
+    if (!xinput2_smooth_scroll) return FALSE;
+    if (XFindContext( event->display, event->event, winContext, (char **)&hwnd )) return FALSE;
+
+    if (event->evtype == XI_ButtonPress || event->evtype == XI_ButtonRelease)
+    {
+        int button = event->detail - 1;
+
+        if (button < 3 || button > 6) return forward_xinput2_core_event( hwnd, event );
+        if (event->evtype == XI_ButtonRelease || emulated) return TRUE;
+        pt = map_event_coords( hwnd, event->event, event->root, root, pt );
+        send_wheel_input( hwnd, pt, button_down_flags[button], (int)button_down_data[button], FALSE, time );
+        return TRUE;
+    }
+
+    if (data->scroll_sourceid != event->sourceid) query_scroll_valuators( event->display, event->sourceid );
+    for (i = 0; i < event->valuators.mask_len * 8; i++)
+    {
+        if (!XIMaskIsSet( event->valuators.mask, i )) continue;
+        if (i == data->scroll_x.number)
+        {
+            delta_x = smooth_scroll_delta( &data->scroll_x, *values, emulated );
+            saw_scroll = TRUE;
+        }
+        if (i == data->scroll_y.number)
+        {
+            delta_y = smooth_scroll_delta( &data->scroll_y, *values, emulated );
+            saw_scroll = TRUE;
+        }
+        values++;
+    }
+    if (!saw_scroll) return forward_xinput2_core_event( hwnd, event );
+    if (emulated) return TRUE;
+
+    TRACE( "hwnd %p/%lx smooth scroll delta %d,%d\n", hwnd, event->event, delta_x, delta_y );
+    pt = map_event_coords( hwnd, event->event, event->root, root, pt );
+    if (delta_y) send_wheel_input( hwnd, pt, MOUSEEVENTF_WHEEL, -delta_y, FALSE, time );
+    if (delta_x) send_wheel_input( hwnd, pt, MOUSEEVENTF_HWHEEL, delta_x, FALSE, time );
+    return TRUE;
+}
+
+#endif /* XIScrollClass */
+
 #ifdef XI_GesturePinchBegin
 
 /***********************************************************************
@@ -2113,6 +2360,14 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
         ret = X11DRV_RawMotion( event );
         break;
 
+#ifdef XIScrollClass
+    case XI_Motion:
+    case XI_ButtonPress:
+    case XI_ButtonRelease:
+        ret = X11DRV_SmoothScrollEvent( event );
+        break;
+#endif
+
     case XI_TouchBegin:
     case XI_TouchUpdate:
     case XI_TouchEnd:
