+#ifdef XIScrollClass
+/***********************************************************************
+ *              smooth_scroll_enabled
+ *
+ * Use XInput2 scroll valuators to preserve the fractional movement from a
+ * touchpad or high-resolution wheel. Off leaves Wine's core button-to-wheel
+ * path unchanged.
+ */
+static BOOL smooth_scroll_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv( "WINE_X11_SMOOTH_SCROLL" );
+        enabled = !value || !strcmp( value, "on" ) || !strcmp( value, "1" );
+    }
+    return enabled;
+}
+#endif
+
 #ifdef XI_GesturePinchBegin
 /***********************************************************************
  *              pinch_zoom_enabled
@@ -323,6 +348,60 @@ static void update_relative_valuators( XIAnyClassInfo **classes, int num_classes
     thread_data->y_valuator.value = 0;
 }
 
+#ifdef XIScrollClass
+/***********************************************************************
+ *              update_scroll_valuators
+ */
+static void update_scroll_valuators( XIAnyClassInfo **classes, int num_classes, int sourceid )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct x11drv_scroll_axis *axis;
+    int i;
+
+    data->scroll_sourceid = sourceid;
+    data->scroll_x.number = data->scroll_y.number = -1;
+    data->scroll_x.increment = data->scroll_y.increment = 0.0;
+    data->scroll_x.value_valid = data->scroll_y.value_valid = FALSE;
+
+    for (i = 0; i < num_classes; i++)
+    {
+        XIScrollClassInfo *scroll;
+
+        if (classes[i]->type != XIScrollClass) continue;
+        scroll = (XIScrollClassInfo *)classes[i];
+        if (!scroll->increment) continue;
+        if (!data->scroll_sourceid) data->scroll_sourceid = scroll->sourceid;
+        if (scroll->sourceid != data->scroll_sourceid) continue;
+
+        if (scroll->scroll_type == XIScrollTypeVertical) axis = &data->scroll_y;
+        else if (scroll->scroll_type == XIScrollTypeHorizontal) axis = &data->scroll_x;
+        else continue;
+        if (axis->number >= 0 && !(scroll->flags & XIScrollFlagPreferred)) continue;
+        axis->number = scroll->number;
+        axis->sourceid = scroll->sourceid;
+        axis->increment = scroll->increment;
+    }
+
+    TRACE( "source %d scroll x %d/%f, y %d/%f\n", data->scroll_sourceid,
+           data->scroll_x.number, data->scroll_x.increment,
+           data->scroll_y.number, data->scroll_y.increment );
+}
+
+static void query_scroll_valuators( Display *display, int sourceid )
+{
+    XIDeviceInfo *info;
+    int count;
+
+    if (!(info = pXIQueryDevice( display, sourceid, &count )))
+    {
+        update_scroll_valuators( NULL, 0, sourceid );
+        return;
+    }
+    update_scroll_valuators( info->classes, info->num_classes, sourceid );
+    pXIFreeDeviceInfo( info );
+}
+#endif
+
 
