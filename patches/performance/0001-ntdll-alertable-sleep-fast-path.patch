From 7a5257aeff3eea67188e5928c574d94b56dd54e1 Mon Sep 17 00:00:00 2001
From: dist <build@localhost>
Date: Wed, 5 Aug 2026 18:59:54 +0200
Subject: [PATCH] ntdll: reroute alertable zero-handle sleeps through the
 ntsync alert event
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A traced empty Live 12 Set produced ~3,650 wineserver context switches/sec.
One verified contributor to that request traffic is that every alertable
zero-handle sleep costs a full wineserver round trip. NtDelayExecution
with alertable=TRUE unconditionally calls server_wait(NULL, 0,
SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, timeout) — the comment says
"if alertable, we need to query the server" (dlls/ntdll/unix/sync.c,
NtDelayExecution) — because the server-side user APC queue has to be
checked before and during the sleep.

The per-thread ntsync alert machinery makes that check unnecessary on
the client side: the server creates thread->alert_sync as a manual-reset
event (server/thread.c:570), signals it when the first user APC is
queued (server/thread.c:1483-1488) and resets it when the server-side
user APC queue empties (server/thread.c:1520-1521,1536-1537), and the
client already caches its own fd for it through get_inproc_alert_fd()
(dlls/ntdll/unix/sync.c:872-897). A count=0 wait with only an alert fd
is legal — the NTSYNC_MAX_WAIT_COUNT check only bounds count above — and
sleeps in-kernel until the alert event signals or the timeout expires.

With WINE_APC_FASTPATH explicitly set to "1", "on", "true", or "yes"
(case-insensitive), NtDelayExecution now performs the alertable sleep as
an in-kernel NTSYNC_IOC_WAIT_ANY with count=0 and args.alert set to the
thread's alert fd, via a small alertable_sleep_fastpath() helper that
reuses linux_wait_objs() (sync.c:399-450). The path is off by default;
an unset, empty, or unrecognised value leaves Wine's ordinary wait in
place, and "0", "off", "false", or "no" remain explicit rollback
values. Reusing linux_wait_objs() keeps the do/ioctl/while(EINTR) retry,
so system APCs delivered through SIGUSR1 signal frames interrupt the
wait exactly as they do for alertable handle waits today.
linux_wait_objs() only learns to return STATUS_USER_APC to the caller
for count=0 waits instead of draining internally; the count>0 path is
byte-identical.

Semantics preserved, point by point:

- Timeout expiry maps to STATUS_SUCCESS and still yields: today the
  yield happens inside server_wait (server.c:813-816), so the fast path
  calls NtYieldExecution() itself on ETIMEDOUT. The comment above the
  fallback ("we never return STATUS_NO_YIELD_PERFORMED") stays true.
- An alert wake does the same zero-timeout server_wait drain that the
  alert branch of linux_wait_objs() does for handle waits
  (sync.c:436-443), and STATUS_USER_APC propagates after dispatch.
- If that drain finds no user APC (spurious wake — the APC was
  cancelled between the kernel wake and the drain — the issue-109
  livelock class), the fast path never loops client-side: it computes
  the remaining timeout and falls back to a normal blocking server_wait,
  which is today's exact behavior with less time left.
- get_inproc_alert_fd() failure, a missing /dev/ntsync
  (inproc_device_fd < 0), or any ntsync error falls back to today's
  server_wait path. If an ioctl error arrives after a partial relative
  wait, the fallback receives only the remaining duration; absolute and
  infinite deadlines remain unchanged. With ntsync absent,
  linux_wait_objs() is the STATUS_NOT_IMPLEMENTED stub, so the ordinary
  path is taken before any wait.
- The non-alertable path is untouched.

Verification: rebased onto the current Wine series and linked in ntdll.so
warning-free. The exact one-patch build passes all 45 alertable-delay/APC
semantics checks with WINE_APC_FASTPATH=1 and with the variable unset or set
to off. A host-side ioctl probe observes count=0 NTSYNC_IOC_WAIT_ANY calls
carrying an alert fd only with the explicit opt-in, and zero such calls with
the default-unset and explicit-off controls. Injecting EIO for only those
alert-only waits exercises the ordinary server fallback and retains the same
45/45 result.
---
 dlls/ntdll/unix/sync.c | 102 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 101 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index fbf054e..8047a5f 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -49,6 +49,7 @@
 # include <sys/resource.h>
 #endif
 #include <string.h>
+#include <strings.h>
 #include <stdarg.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -77,6 +78,32 @@ WINE_DEFAULT_DEBUG_CHANNEL(sync);
 HANDLE keyed_event = 0;
 int inproc_device_fd = -1;
 
+
+/***********************************************************************
+ *           apc_fastpath_enabled
+ *
+ * Single gate for the WINE_APC_FASTPATH path that keeps alertable sleeps
+ * off the wineserver socket. Disabled by default; "1", "on", "true", or
+ * "yes" (case-insensitive) explicitly enables it.
+ */
+static int apc_fastpath;
+
+static void init_apc_fastpath(void)
+{
+    const char *env = getenv( "WINE_APC_FASTPATH" );
+
+    apc_fastpath = env && (!strcasecmp( env, "1" ) || !strcasecmp( env, "on" ) ||
+                            !strcasecmp( env, "true" ) || !strcasecmp( env, "yes" ));
+}
+
+static int apc_fastpath_enabled(void)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+    pthread_once( &once, init_apc_fastpath );
+    return apc_fastpath;
+}
+
 static const char *debugstr_timeout( const LARGE_INTEGER *timeout )
 {
     if (!timeout) return "(infinite)";
@@ -437,6 +464,7 @@ static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_
         {
             static const LARGE_INTEGER timeout;
 
+            if (!count) return STATUS_USER_APC;  /* alert-only wait: leave the drain to the caller */
             ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &timeout );
             assert( ret == STATUS_USER_APC );
             return ret;
@@ -2413,6 +2441,74 @@ NTSTATUS WINAPI NtYieldExecution(void)
 }
 
 
+/***********************************************************************
+ *           alertable_sleep_fastpath
+ *
+ * Perform an alertable sleep without a wineserver round trip, as an
+ * in-kernel ntsync wait with count 0 whose only wake source is the calling
+ * thread's own alert event (a count 0 wait with only an alert fd is legal;
+ * NTSYNC_MAX_WAIT_COUNT only bounds count above). The wait goes through
+ * linux_wait_objs() so that EINTR/system APC (SIGUSR1) handling is identical
+ * to alertable handle waits. Returns FALSE before the ioctl when the fast path
+ * is unavailable and the caller should use server_wait() instead. Once an
+ * ioctl was attempted, writes the final status and returns TRUE, including
+ * when a kernel error required the ordinary server fallback.
+ */
+static BOOL alertable_sleep_fastpath( const LARGE_INTEGER *timeout, unsigned int *result )
+{
+    static const LARGE_INTEGER zero_timeout;
+    LARGE_INTEGER start, now, remaining;
+    const LARGE_INTEGER *fallback_timeout = timeout;
+    NTSTATUS status;
+    BOOL relative_timeout;
+    int alert_fd;
+
+    if (inproc_device_fd < 0) return FALSE;
+    if ((alert_fd = get_inproc_alert_fd()) < 0) return FALSE;
+
+    relative_timeout = timeout && timeout->QuadPart < 0 && timeout->QuadPart != TIMEOUT_INFINITE;
+    if (relative_timeout) NtQueryPerformanceCounter( &start, NULL );
+
+    status = linux_wait_objs( inproc_device_fd, 0, NULL, WaitAny, alert_fd, timeout );
+    if (status == STATUS_TIMEOUT)
+    {
+        /* server_wait() yields implicitly when a wait times out
+           (dlls/ntdll/unix/server.c:813-816); replicate that here so the
+           implicit-yield behavior of an expired alertable sleep is unchanged */
+        NtYieldExecution();
+        *result = STATUS_SUCCESS;
+        return TRUE;
+    }
+    if (status != STATUS_USER_APC) goto server_fallback;  /* ntsync error */
+
+    /* The alert event was signaled: drain the server-side user APC queue the
+       same way the alert branch of linux_wait_objs() does for handle waits. */
+    status = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero_timeout );
+    if (status != STATUS_TIMEOUT)
+    {
+        *result = status;  /* an APC was dispatched */
+        return TRUE;
+    }
+
+    /* Spurious wake (the APC was cancelled between the kernel wake and the
+       drain): never loop client-side — block in the server for the remaining
+       timeout instead. */
+server_fallback:
+    if (relative_timeout)
+    {
+        NtQueryPerformanceCounter( &now, NULL );
+        remaining.QuadPart = timeout->QuadPart + (now.QuadPart - start.QuadPart);
+        if (remaining.QuadPart > 0) remaining.QuadPart = 0;  /* expired: zero-timeout poll */
+        fallback_timeout = &remaining;
+    }
+    if ((status = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE,
+                               fallback_timeout )) == STATUS_TIMEOUT)
+        status = STATUS_SUCCESS;
+    *result = status;
+    return TRUE;
+}
+
+
 /******************************************************************
  *		NtDelayExecution (NTDLL.@)
  */
@@ -2420,9 +2516,13 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
 {
     unsigned int status = STATUS_SUCCESS;
 
-    /* if alertable, we need to query the server */
+    /* if alertable, the server-side user APC queue has to be checked; the
+       WINE_APC_FASTPATH path does that in-kernel through the alert event */
     if (alertable)
     {
+        if (apc_fastpath_enabled() && alertable_sleep_fastpath( timeout, &status ))
+            return status;
+
         /* Since server_wait will result in an unconditional implicit yield,
            we never return STATUS_NO_YIELD_PERFORMED */
         if ((status = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, timeout )) == STATUS_TIMEOUT)
-- 
2.55.0
