 }
 
+
+/***********************************************************************
+ *           apc_fastpath_create_event
+ *
+ * Create a thread's client poke event: a manual-reset ntsync event owned by
+ * the client (no server object behind it), used to wake the thread's
+ * in-kernel waits when a same-process user APC is queued to it. Returns
+ * -1 when ntsync is unavailable.
+ */
+int apc_fastpath_create_event(void)
+{
+    struct ntsync_event_args args = {.manual = 1, .signaled = 0};
+
+    if (inproc_device_fd < 0) return -1;
+    return ioctl( inproc_device_fd, NTSYNC_IOC_CREATE_EVENT, &args );
+}
+
+void apc_fastpath_set_event( int fd )
+{
+    __u32 prev;
+    int ret;
+
+    do { ret = ioctl( fd, NTSYNC_IOC_EVENT_SET, &prev ); }
+    while (ret < 0 && errno == EINTR);
+    if (ret < 0) WARN( "client APC poke event set failed: %s\n", strerror( errno ) );
+}
+
+void apc_fastpath_reset_event( int fd )
+{
+    __u32 prev;
+    int ret;
+
+    do { ret = ioctl( fd, NTSYNC_IOC_EVENT_RESET, &prev ); }
+    while (ret < 0 && errno == EINTR);
+    if (ret < 0) WARN( "client APC poke event reset failed: %s\n", strerror( errno ) );
+}
+
+/***********************************************************************
+ *           apc_fastpath_server_apc_pending
+ *
+ * The server-side alert event is manual-reset and is signaled iff the
+ * server-side user APC queue of this thread is non-empty (signaled on the
+ * first queue, server/thread.c:1483-1488, reset when it empties,
+ * server/thread.c:1520-1521,1536-1537), and same-process queuers never
+ * touch it. Returns 1 if signaled, 0 if not, -1 when unknown.
+ */
+int apc_fastpath_server_apc_pending(void)
+{
+    struct ntsync_event_args args = {0};
+    int fd = get_inproc_alert_fd();
+
+    if (fd < 0) return -1;
+    if (ioctl( fd, NTSYNC_IOC_EVENT_READ, &args ) < 0) return -1;
+    return args.signaled;
+}
+
 #else /* NTSYNC_IOC_EVENT_READ */
 
 static NTSTATUS linux_release_semaphore_obj( int obj, ULONG count, ULONG *prev_count )
@@ -518,6 +567,24 @@ static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_
     return STATUS_NOT_IMPLEMENTED;
 }
 
+int apc_fastpath_create_event(void)
+{
+    return -1;
+}
+
+void apc_fastpath_set_event( int fd )
+{
+}
+
+void apc_fastpath_reset_event( int fd )
+{
+}
+
+int apc_fastpath_server_apc_pending(void)
+{
+    return -1;
+}
+
 #endif /* NTSYNC_IOC_EVENT_READ */
 
 /* It's possible for synchronization primitives to remain alive even after being
@@ -890,7 +957,7 @@ static NTSTATUS inproc_query_mutex( HANDLE handle, MUTANT_BASIC_INFORMATION *inf
     return ret;
 }
 
-static int get_inproc_alert_fd(void)
+int get_inproc_alert_fd(void)
 {
     struct thread_data *data = get_thread_data();
     obj_handle_t token;
@@ -921,7 +988,9 @@ static NTSTATUS inproc_wait( DWORD count, const HANDLE *handles, WAIT_TYPE type,
                              BOOLEAN alertable, const LARGE_INTEGER *timeout )
 {
     struct inproc_sync *syncs[64], stack[ARRAY_SIZE(syncs)];
-    int objs[ARRAY_SIZE(syncs)], alert_fd = 0;
+    int objs[ARRAY_SIZE(syncs)], alert_fd = 0, client_event = -1;
+    DWORD wait_count = count;
+    BOOL unarmed = FALSE;
     NTSTATUS ret;
 
     if (inproc_device_fd < 0) return STATUS_NOT_IMPLEMENTED;
@@ -938,8 +1007,50 @@ static NTSTATUS inproc_wait( DWORD count, const HANDLE *handles, WAIT_TYPE type,
         objs[i] = syncs[i]->fd;
     }
 
-    if (alertable) alert_fd = get_inproc_alert_fd();
-    ret = linux_wait_objs( inproc_device_fd, count, objs, type, alert_fd, timeout );
+    if (alertable)
+    {
+        alert_fd = get_inproc_alert_fd();
+
+        if (apc_fastpath_enabled())
+        {
+            /* The client poke event can only ride along as a wait object in
+               WaitAny waits with a free slot; while blocked anywhere else
+               (WaitAll, full 64-handle waits) same-process queuers fall back
+               to the server path, whose alert event is always armed. */
+            if (type == WaitAll || count == ARRAY_SIZE(syncs) ||
+                (client_event = apc_fastpath_client_event()) < 0)
+            {
+                apc_fastpath_enter_unarmed_wait();
+                unarmed = TRUE;
+            }
+            else objs[wait_count++] = client_event;
+
+            /* deliver same-process user APCs queued while busy, before sleeping */
+            if (apc_fastpath_deliver_client_apc( NULL ))
+            {
+                if (unarmed) apc_fastpath_leave_unarmed_wait();
+                while (count--) release_inproc_sync( syncs[count] );
+                return STATUS_USER_APC;
+            }
+        }
+    }
+
+    ret = linux_wait_objs( inproc_device_fd, wait_count, objs, type, alert_fd, timeout );
+    if (unarmed) apc_fastpath_leave_unarmed_wait();
+
+    if (ret == STATUS_USER_APC)  /* alert wake: drain the server-side user APC queue */
+    {
+        static const LARGE_INTEGER zero_timeout;
+
+        ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero_timeout );
+        if (ret == STATUS_TIMEOUT) ret = STATUS_USER_APC;  /* spurious wake (cancel race): report alerted */
+    }
+    else if (client_event >= 0 && ret == count)  /* client poke event wake (index == original count) */
+    {
+        if (!apc_fastpath_deliver_client_apc( NULL ))
+            WARN( "client APC event signaled with an empty queue\n" );
+        ret = STATUS_USER_APC;
+    }
 
     while (count--) release_inproc_sync( syncs[count] );
     return ret;
@@ -950,6 +1061,7 @@ static NTSTATUS inproc_signal_and_wait( HANDLE signal, HANDLE wait,
 {
     struct inproc_sync stack_signal, stack_wait, *signal_sync = &stack_signal, *wait_sync = &stack_wait;
     int alert_fd = 0;
+    BOOL unarmed = FALSE;
     NTSTATUS ret;
 
     if (inproc_device_fd < 0) return STATUS_NOT_IMPLEMENTED;
@@ -969,8 +1081,32 @@ static NTSTATUS inproc_signal_and_wait( HANDLE signal, HANDLE wait,
 
     if (!ret)
     {
-        if (alertable) alert_fd = get_inproc_alert_fd();
-        ret = linux_wait_objs( inproc_device_fd, 1, &wait_sync->fd, WaitAny, alert_fd, timeout );
+        if (alertable)
+        {
+            alert_fd = get_inproc_alert_fd();
+            if (apc_fastpath_enabled())
+            {
+                /* a client-event poke cannot reach this wait, so same-process
+                   queuers fall back to the server path for its duration */
+                apc_fastpath_enter_unarmed_wait();
+                unarmed = TRUE;
+                /* deliver same-process user APCs queued while busy, before sleeping */
+                if (apc_fastpath_deliver_client_apc( NULL )) ret = STATUS_USER_APC;
+            }
+        }
+        if (!ret)
+        {
+            ret = linux_wait_objs( inproc_device_fd, 1, &wait_sync->fd, WaitAny, alert_fd, timeout );
+            if (unarmed) apc_fastpath_leave_unarmed_wait();
+            if (ret == STATUS_USER_APC)  /* alert wake: drain the server-side user APC queue */
+            {
+                static const LARGE_INTEGER zero_timeout;
+
+                ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero_timeout );
+                if (ret == STATUS_TIMEOUT) ret = STATUS_USER_APC;  /* spurious wake: report alerted */
+            }
+        }
+        else if (unarmed) apc_fastpath_leave_unarmed_wait();
     }
 
     release_inproc_sync( wait_sync );
@@ -2449,15 +2585,22 @@ static NTSTATUS alertable_sleep_fastpath( const LARGE_INTEGER *timeout )
 {
     static const LARGE_INTEGER zero_timeout;
     LARGE_INTEGER start, now, remaining;
+    int objs[1], alert_fd, count = 0;
     NTSTATUS status;
-    int alert_fd;
 
     if (inproc_device_fd < 0) return STATUS_NOT_IMPLEMENTED;
     if ((alert_fd = get_inproc_alert_fd()) < 0) return STATUS_NOT_IMPLEMENTED;
 
+    /* deliver same-process user APCs queued while busy, before sleeping */
+    if (apc_fastpath_deliver_client_apc( NULL )) return STATUS_USER_APC;
+
+    /* arm the client poke event so a same-process APC queued mid-sleep wakes
+       the wait in-kernel */
+    if ((objs[0] = apc_fastpath_client_event()) >= 0) count = 1;
+
     if (timeout && timeout->QuadPart < 0) NtQueryPerformanceCounter( &start, NULL );
 
-    status = linux_wait_objs( inproc_device_fd, 0, NULL, WaitAny, alert_fd, timeout );
+    status = linux_wait_objs( inproc_device_fd, count, objs, WaitAny, alert_fd, timeout );
     if (status == STATUS_TIMEOUT)
     {
         /* server_wait() yields implicitly when a wait times out
@@ -2466,10 +2609,16 @@ static NTSTATUS alertable_sleep_fastpath( const LARGE_INTEGER *timeout )
         NtYieldExecution();
         return STATUS_SUCCESS;
     }
-    if (status != STATUS_USER_APC) return STATUS_NOT_IMPLEMENTED;  /* ntsync error: use the server path */
+    if (count && !status)  /* client poke event wake (index 0) */
+    {
+        if (apc_fastpath_deliver_client_apc( NULL )) return STATUS_USER_APC;
+        WARN( "client APC event signaled with an empty queue\n" );
+        /* spurious: fall through to the drain + remaining-timeout wait below */
+    }
+    else if (status != STATUS_USER_APC) return STATUS_NOT_IMPLEMENTED;  /* ntsync error: use the server path */
 
-    /* The alert event was signaled: drain the server-side user APC queue the
-       same way the alert branch of linux_wait_objs() does for handle waits. */
+    /* Alert wake: drain the server-side user APC queue the same way the
+       alert branch of inproc_wait() does for handle waits. */
     status = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero_timeout );
     if (status != STATUS_TIMEOUT) return status;  /* an APC was dispatched */
 
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 546963a..4bbb774 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1102,6 +1102,10 @@ static void contexts_from_server( CONTEXT *context, struct context_data server_c
 static DECLSPEC_NORETURN void pthread_exit_wrapper( int status )
 {
     struct thread_data *data = get_thread_data();
+    /* deregister before closing the fds: queuers hold apc_mutex while using
+       the registered fds, so they can never touch a recycled fd number */
+    apc_fastpath_deregister_thread( data );
+    close( data->client_event_fd );
