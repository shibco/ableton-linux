+    BOOL fastpath = apc_fastpath_enabled();
     union apc_result result;
     sigset_t old_set;
     int signaled;
@@ -735,6 +755,33 @@ unsigned int server_select( const union select_op *select_op, data_size_t size,
 
     memset( &result, 0, sizeof(result) );
 
+    if (fastpath)
+    {
+        /* While blocked in the server protocol a client-queue poke cannot
+           reach this thread, so same-process queuers fall back to the server
+           path for the duration. */
+        apc_fastpath_enter_unarmed_wait();
+        if ((flags & SELECT_ALERTABLE) && !context && user_apc)
+        {
+            /* deliver same-process user APCs queued while this thread was
+               busy, before a long server wait would delay them */
+            if (apc_fastpath_fetch_client_apc( user_apc ))
+            {
+                apc_fastpath_leave_unarmed_wait();
+                return STATUS_USER_APC;
+            }
+            /* Alertable zero-handle polls (NtTestAlert, NtContinueEx's
+               TEST_ALERT, alert drains) can skip the round trip entirely when
+               the server-side user APC queue is empty; the manual-reset alert
+               event is signaled iff it is not. */
+            if (!select_op && !abs_timeout && !apc_fastpath_server_apc_pending())
+            {
+                apc_fastpath_leave_unarmed_wait();
+                return STATUS_TIMEOUT;
+            }
+        }
+    }
+
     do
     {
         pthread_sigmask( SIG_BLOCK, &server_block_set, &old_set );
@@ -778,6 +825,8 @@ unsigned int server_select( const union select_op *select_op, data_size_t size,
     }
     while (ret == STATUS_USER_APC || ret == STATUS_KERNEL_APC);
 
+    if (fastpath) apc_fastpath_leave_unarmed_wait();
+
     if (ret == STATUS_USER_APC) *user_apc = reply_data.call.user;
     if (reply_size > sizeof(reply_data.call))
     {
@@ -1706,6 +1755,8 @@ size_t server_init_process(void)
 
     if (ret) server_protocol_error( "init_first_thread failed with status %x\n", ret );
 
+    apc_fastpath_register_thread( data );
+
     if (!supported_machines_count)
         fatal_error( "'%s' is a 64-bit installation, it cannot be used with a 32-bit wineserver.\n",
                      config_dir );
@@ -1806,6 +1857,9 @@ void server_init_thread( struct thread_data *data )
 
     if (data->teb)
     {
+        /* user threads only: the server rejects APCs queued to system
+           threads, and unregistered targets keep the server path */
+        apc_fastpath_register_thread( data );
         init_teb_data( data );
         signal_start_thread( data->start, data->param, data->teb );
     }
@@ -1888,3 +1942,4 @@
         fd = remove_fd_from_cache( source );
         close_inproc_sync( source );
+        apc_fastpath_forget_handle( source );
     }
@@ -1955,1 +2010,6 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
+    /* a closed handle's slot can be reallocated right away (server/handle.c
