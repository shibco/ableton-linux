+/******************************************************************************
+ * Same-process user APC fast path (WINE_APC_FASTPATH)
+ *
+ * A user APC queued through wineserver costs at least two round trips (one
+ * to queue, one to drain on the waiting side); idle Live 12 generates enough
+ * of this traffic to keep ~3,650 wineserver context switches/sec going on an
+ * empty set. Same-process plain user APCs need none of it: the payload is
+ * appended to the target thread's client queue, and the target is woken
+ * through a client-owned ntsync event that its alertable in-kernel waits
+ * carry as a wait object.
+ *
+ * The poke event mirrors the client queue state, mirroring the server's own
+ * alert_sync protocol: queuers set it when appending to an empty queue, the
+ * owning thread resets it when the queue drains empty, both under apc_mutex,
+ * and waiters always poll the client queue before sleeping. A poke therefore
+ * can never be lost between the queue-empty poll and the in-kernel wait that
+ * follows it, and the event is never left signaled behind an empty queue.
+ * The server's alert event stays server-owned; it keeps tracking the
+ * server-side queue (cross-process and special APCs) only.
+ */
+
+struct client_apc
+{
+    struct list entry;
+    client_ptr_t func;
+    apc_param_t args[3];
+};
+
+struct apc_target
+{
+    struct list  entry;
+    DWORD        tid;
+    unsigned int generation;         /* bumped per registration: a recycled tid never validates a stale handle cache entry */
+    int          alert_fd;           /* the thread's server-side alert event */
+    int          client_event_fd;    /* the thread's client poke event */
+    LONG         unarmed_wait_depth; /* >0 while blocked where a poke can't reach it (server_select, WaitAll, ...) */
+    struct list  client_apcs;        /* queued same-process user APCs */
+};
+
+struct apc_handle_entry
+{
+    struct list  entry;
+    HANDLE       handle;
+    DWORD        tid;
+    unsigned int generation;         /* 0: cross-process verdict, always queue via the server */
+};
+
+#define MAX_APC_HANDLE_CACHE_ENTRIES 256
+
+static struct list apc_targets = LIST_INIT( apc_targets );
+static struct list apc_handle_cache = LIST_INIT( apc_handle_cache );
+static unsigned int apc_handle_cache_count;
+static unsigned int apc_generation;
+/* All apc_mutex sections run under server_enter_uninterrupted_section:
+   SIGUSR1 (suspend, system APC wakeup) must never re-enter this mutex from
+   a signal frame while the thread already holds it. */
+static pthread_mutex_t apc_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* apc_mutex must be held */
+static struct apc_target *find_apc_target( DWORD tid )
+{
+    struct apc_target *target;
+
+    LIST_FOR_EACH_ENTRY( target, &apc_targets, struct apc_target, entry )
+        if (target->tid == tid) return target;
+    return NULL;
+}
+
+/* apc_mutex must be held */
+static struct apc_handle_entry *find_apc_handle_entry( HANDLE handle )
+{
+    struct apc_handle_entry *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, &apc_handle_cache, struct apc_handle_entry, entry )
+        if (entry->handle == handle) return entry;
+    return NULL;
+}
+
+/***********************************************************************
+ *           apc_fastpath_register_thread
+ *
+ * Register a thread in the same-process APC registry. The alert fd is
+ * created eagerly (one server round trip per thread) so that peers can
+ * wake the thread right away and the alertable fast paths never need lazy
+ * setup; the poke event is a plain client-side ntsync object.
+ */
+void apc_fastpath_register_thread( struct thread_data *data )
+{
+    struct apc_target *target;
+    sigset_t sigset;
+
+    if (!apc_fastpath_enabled()) return;
+
+    if ((data->client_event_fd = apc_fastpath_create_event()) < 0) return;
+    if (get_inproc_alert_fd() < 0 || !(target = malloc( sizeof(*target) )))
+    {
+        close( data->client_event_fd );
+        data->client_event_fd = -1;
+        return;
+    }
+
+    target->tid                = data->tid;
+    target->alert_fd           = data->alert_fd;
+    target->client_event_fd    = data->client_event_fd;
+    target->unarmed_wait_depth = 0;
+    list_init( &target->client_apcs );
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    target->generation = ++apc_generation;
+    list_add_tail( &apc_targets, &target->entry );
+    data->apc_target = target;
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+}
+
+/***********************************************************************
+ *           apc_fastpath_deregister_thread
+ *
+ * Remove a thread from the registry on exit. Undelivered client APCs are
+ * discarded, matching Windows dropping APCs queued to a terminated thread,
+ * and handle cache entries referring to this tid are poisoned: wineserver
+ * recycles ptids promptly (alloc_ptid reuses freed slots), and a stale
+ * entry must never validate against a future thread reusing this one.
+ */
+void apc_fastpath_deregister_thread( struct thread_data *data )
+{
+    struct apc_handle_entry *hentry, *hnext;
+    struct apc_target *target = data->apc_target;
+    struct client_apc *apc, *anext;
+    sigset_t sigset;
+
+    if (!target) return;
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    data->apc_target = NULL;
+    list_remove( &target->entry );
+    LIST_FOR_EACH_ENTRY_SAFE( apc, anext, &target->client_apcs, struct client_apc, entry )
+    {
+        list_remove( &apc->entry );
+        free( apc );
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( hentry, hnext, &apc_handle_cache, struct apc_handle_entry, entry )
+    {
+        if (hentry->tid != target->tid) continue;
+        list_remove( &hentry->entry );
+        free( hentry );
+        apc_handle_cache_count--;
+    }
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+    free( target );
+}
+
+/***********************************************************************
+ *           apc_fastpath_client_event
+ *
+ * The calling thread's poke event, carried as a wait object by its
+ * alertable in-kernel waits; -1 when the fast path is unavailable.
+ */
+int apc_fastpath_client_event(void)
+{
+    return get_thread_data()->client_event_fd;
+}
+
+/***********************************************************************
+ *           apc_fastpath_enter_unarmed_wait / apc_fastpath_leave_unarmed_wait
+ *
+ * Mark the calling thread as blocked somewhere a client-event poke cannot
+ * reach (server_select, WaitAll and full 64-handle waits, signal-and-wait);
+ * same-process queuers fall back to the server path for the duration.
+ */
+void apc_fastpath_enter_unarmed_wait(void)
+{
+    struct apc_target *target = get_thread_data()->apc_target;
+    sigset_t sigset;
+
+    if (!target) return;
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    target->unarmed_wait_depth++;
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+}
+
+void apc_fastpath_leave_unarmed_wait(void)
+{
+    struct apc_target *target = get_thread_data()->apc_target;
+    sigset_t sigset;
+
+    if (!target) return;
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if (target->unarmed_wait_depth > 0) target->unarmed_wait_depth--;
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+}
+
+/***********************************************************************
+ *           apc_fastpath_fetch_client_apc
+ *
+ * Pop one APC from the calling thread's client queue. The poke event is
+ * reset when the queue drains empty; together with queuers setting it on
+ * the empty-to-non-empty transition, both under apc_mutex, the event state
+ * always reflects the queue state at lock release.
+ */
+BOOL apc_fastpath_fetch_client_apc( struct user_apc *apc )
+{
+    struct apc_target *target = get_thread_data()->apc_target;
+    struct client_apc *head;
+    sigset_t sigset;
+
+    if (!target) return FALSE;
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if (list_empty( &target->client_apcs ))
+    {
+        server_leave_uninterrupted_section( &apc_mutex, &sigset );
+        return FALSE;
+    }
+    head = LIST_ENTRY( list_head( &target->client_apcs ), struct client_apc, entry );
+    list_remove( &head->entry );
+    if (list_empty( &target->client_apcs ))
+        apc_fastpath_reset_event( target->client_event_fd );
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+
+    apc->type    = APC_USER;
+    apc->flags   = 0;
+    apc->func    = head->func;
+    apc->args[0] = head->args[0];
+    apc->args[1] = head->args[1];
+    apc->args[2] = head->args[2];
+    free( head );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           resolve_client_apc_tid
+ *
+ * Resolve a thread handle to the tid of a registered same-process thread,
+ * through a generation-validated handle cache. On a miss, one
+ * NtQueryInformationThread call learns the target's pid/tid; cross-process
+ * handles are permanently marked server-routed. Returns
+ * STATUS_NOT_IMPLEMENTED when the handle must stay on the server path, or
+ * the query error (the same error the server queue_apc request returns).
+ */
+static unsigned int resolve_client_apc_tid( HANDLE handle, DWORD *tid_ret )
+{
+    struct apc_handle_entry *hentry;
+    struct apc_target *target;
+    THREAD_BASIC_INFORMATION tbi;
+    unsigned int ret;
+    DWORD tid;
+    sigset_t sigset;
+
+    if (handle == GetCurrentThread())  /* pseudo-handle: self */
+    {
+        *tid_ret = GetCurrentThreadId();
+        return STATUS_SUCCESS;
+    }
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if ((hentry = find_apc_handle_entry( handle )))
+    {
+        if (!hentry->generation)  /* cross-process verdict */
+        {
+            server_leave_uninterrupted_section( &apc_mutex, &sigset );
+            return STATUS_NOT_IMPLEMENTED;
+        }
+        if ((target = find_apc_target( hentry->tid )) && target->generation == hentry->generation)
+        {
+            *tid_ret = hentry->tid;
+            server_leave_uninterrupted_section( &apc_mutex, &sigset );
+            return STATUS_SUCCESS;
+        }
+        /* stale entry (the tid was recycled): drop it and refresh below */
+        list_remove( &hentry->entry );
+        free( hentry );
+        apc_handle_cache_count--;
+    }
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+
+    if ((ret = NtQueryInformationThread( handle, ThreadBasicInformation,
+                                         &tbi, sizeof(tbi), NULL )))
+        return ret;
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if (apc_handle_cache_count < MAX_APC_HANDLE_CACHE_ENTRIES &&
+        !find_apc_handle_entry( handle ) && (hentry = malloc( sizeof(*hentry) )))
+    {
+        hentry->handle = handle;
+        hentry->tid = 0;
+        hentry->generation = 0;  /* cross-process verdict unless proven same-process below */
+        list_add_tail( &apc_handle_cache, &hentry->entry );
+        apc_handle_cache_count++;
+    }
+    else hentry = NULL;
+
+    if (HandleToULong( tbi.ClientId.UniqueProcess ) != pid)
+    {
+        server_leave_uninterrupted_section( &apc_mutex, &sigset );
+        return STATUS_NOT_IMPLEMENTED;  /* cross-process APCs belong to the server */
+    }
+    tid = HandleToULong( tbi.ClientId.UniqueThread );
+    if ((target = find_apc_target( tid )) && hentry)
+    {
+        hentry->tid = tid;
+        hentry->generation = target->generation;
+    }
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+
+    if (!target)
+    {
+        /* not a registered thread (exited, or a system thread): the server
+           path provides the matching error and semantics */
+        if (hentry)
+        {
+            server_enter_uninterrupted_section( &apc_mutex, &sigset );
+            list_remove( &hentry->entry );
+            free( hentry );
+            apc_handle_cache_count--;
+            server_leave_uninterrupted_section( &apc_mutex, &sigset );
+        }
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    *tid_ret = tid;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           apc_fastpath_forget_handle
+ *
+ * Drop a handle cache entry when its handle is closed. wineserver hands a
+ * freed handle slot straight back (server/handle.c: alloc_entry starts at
+ * table->free and close_handle lowers it), so a handle -> tid mapping must
+ * not outlive the handle it was learned from: a recycled handle would
+ * otherwise validate against the old thread and deliver its APCs there.
+ */
+void apc_fastpath_forget_handle( HANDLE handle )
+{
+    struct apc_handle_entry *hentry;
+    sigset_t sigset;
+
+    if (!apc_handle_cache_count) return;
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if ((hentry = find_apc_handle_entry( handle )))
+    {
+        list_remove( &hentry->entry );
+        free( hentry );
+        apc_handle_cache_count--;
+    }
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+}
+
+/***********************************************************************
+ *           queue_client_apc
+ *
+ * Queue a same-process user APC without a wineserver round trip. Returns
+ * STATUS_NOT_IMPLEMENTED when the server path must be used for this APC.
+ */
+static unsigned int queue_client_apc( HANDLE handle, PNTAPCFUNC func,
+                                      ULONG_PTR arg1, ULONG_PTR arg2, ULONG_PTR arg3 )
+{
+    struct apc_target *target;
+    struct client_apc *apc;
+    unsigned int ret;
+    DWORD tid;
+    sigset_t sigset;
+
+    if ((ret = resolve_client_apc_tid( handle, &tid ))) return ret;
+
+    if (!(apc = malloc( sizeof(*apc) ))) return STATUS_NO_MEMORY;
+    apc->func    = wine_server_client_ptr( func );
+    apc->args[0] = arg1;
+    apc->args[1] = arg2;
+    apc->args[2] = arg3;
+
+    server_enter_uninterrupted_section( &apc_mutex, &sigset );
+    if (!(target = find_apc_target( tid )) || target->unarmed_wait_depth ||
+        target->client_event_fd < 0)
+    {
+        /* The target left the registry (exited) or is blocked somewhere a
+           poke cannot reach: queue this APC through the server instead. */
+        server_leave_uninterrupted_section( &apc_mutex, &sigset );
+        free( apc );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    /* append first, then poke: waiters always poll the client queue before
+       sleeping, so the poke only has to reach threads already blocked in an
+       armed in-kernel wait */
+    if (list_empty( &target->client_apcs ))
+    {
+        list_add_tail( &target->client_apcs, &apc->entry );
+        /* self-queued APCs need no poke: the owner polls its queue before
+           every sleep and can never be blocked while running this code */
+        if (tid != GetCurrentThreadId())
+            apc_fastpath_set_event( target->client_event_fd );
+    }
+    else list_add_tail( &target->client_apcs, &apc->entry );
+    server_leave_uninterrupted_section( &apc_mutex, &sigset );
+    return STATUS_SUCCESS;
+}
