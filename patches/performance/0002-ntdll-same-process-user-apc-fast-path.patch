+/***********************************************************************
+ *              apc_fastpath_deliver_client_apc
+ *
+ * Fetch and dispatch one same-process user APC queued through the client
+ * fast path (WINE_APC_FASTPATH), through the same KiUserApcDispatcher path
+ * as server-delivered APCs. Returns TRUE if one was dispatched; further
+ * queued APCs are delivered through the dispatcher's TEST_ALERT continue,
+ * exactly like the server-side queue.
+ */
+BOOL apc_fastpath_deliver_client_apc( CONTEXT *context )
+{
+    struct user_apc apc;
+
+    if (!apc_fastpath_fetch_client_apc( &apc )) return FALSE;
+    invoke_user_apc( context, &apc, STATUS_USER_APC );
+    return TRUE;
+}
+
+
