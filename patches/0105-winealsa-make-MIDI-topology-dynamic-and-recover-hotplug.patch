+struct pending_notify
+{
+    struct notify_context context;
+    struct midi_src *src;
+    unsigned int open_generation;
+    BOOL owned_header;
+    struct required_notify_entry *required;
+    struct pending_notify *next;
+};
+
+static void fill_out_caps(struct observed_port *port, snd_seq_client_info_t *cinfo,
+                          snd_seq_port_info_t *pinfo)
+{
+    char name[MAXPNAMELEN];
+    unsigned int len = port_display_name(cinfo, pinfo, port->usb_device, TRUE, name);
+
+    memset(&port->out_caps, 0, sizeof(port->out_caps));
+    port->out_caps.wMid = 0x00ff;
+    port->out_caps.wPid = 0x0001;
+    port->out_caps.vDriverVersion = 0x001;
+    port->out_caps.wChannelMask = 0xffff;
+    port->out_caps.wTechnology = alsa_to_win_device_type(port->type);
+    ntdll_umbstowcs(name, len + 1, port->out_caps.szPname, ARRAY_SIZE(port->out_caps.szPname));
+    if (port->out_caps.wTechnology != MOD_MIDIPORT)
+    {
+        port->out_caps.dwSupport = MIDICAPS_VOLUME | MIDICAPS_LRVOLUME;
+        port->out_caps.wVoices = 16;
+        port->out_caps.wNotes = 16;
+    }
+}
+
+static void fill_in_caps(struct observed_port *port, snd_seq_client_info_t *cinfo,
+                         snd_seq_port_info_t *pinfo)
+{
+    char name[MAXPNAMELEN];
+    unsigned int len = port_display_name(cinfo, pinfo, port->usb_device, FALSE, name);
+
+    memset(&port->in_caps, 0, sizeof(port->in_caps));
+    port->in_caps.wMid = 0x00ff;
+    port->in_caps.wPid = 0x0001;
+    port->in_caps.vDriverVersion = 0x001;
+    ntdll_umbstowcs(name, len + 1, port->in_caps.szPname, ARRAY_SIZE(port->in_caps.szPname));
+}
+
+static BOOL enumerate_ports(snd_seq_t *seq, struct observed_port **ports_ret, unsigned int *count_ret)
+{
+    snd_seq_client_info_t *cinfo;
+    snd_seq_port_info_t *pinfo;
+    struct observed_port *ports = NULL;
+    unsigned int count = 0, pass;
+    int data_client = -1, monitor_client = snd_seq_client_id(seq);
+    BOOL data_client_ref = FALSE;
+
+    cinfo = calloc(1, snd_seq_client_info_sizeof());
+    pinfo = calloc(1, snd_seq_port_info_sizeof());
+    if (!cinfo || !pinfo) goto failed;
+
+    seq_lock();
+    if (midi_seq)
+    {
+        data_client = snd_seq_client_id(midi_seq);
+        ++seq_refs;
+        data_client_ref = TRUE;
+    }
+    seq_unlock();
+
+    /* Keep Wine's historical device-ID order: internal ports, then external
+     * ports.  Live persists these IDs in a few older code paths. */
+    for (pass = 0; pass < 2; ++pass)
+    {
+        snd_seq_client_info_set_client(cinfo, -1);
+        while (snd_seq_query_next_client(seq, cinfo) >= 0)
+        {
+            int client = snd_seq_client_info_get_client(cinfo);
+
+            if (client == SND_SEQ_CLIENT_SYSTEM || client == monitor_client || client == data_client)
+                continue;
+
+            snd_seq_port_info_set_client(pinfo, client);
+            snd_seq_port_info_set_port(pinfo, -1);
+            while (snd_seq_query_next_port(seq, pinfo) >= 0)
+            {
+                struct observed_port *new_ports, *port;
+                unsigned int cap = snd_seq_port_info_get_capability(pinfo);
+                unsigned int type = snd_seq_port_info_get_type(pinfo);
+
+                if (!type || (cap & SND_SEQ_PORT_CAP_NO_EXPORT) ||
+                    !(cap & (SND_SEQ_PORT_CAP_READ | SND_SEQ_PORT_CAP_WRITE)) ||
+                    (!!(type & SND_SEQ_PORT_TYPE_PORT) != !!pass))
+                    continue;
+
+                if (!(new_ports = realloc(ports, (count + 1) * sizeof(*ports)))) goto failed;
+                ports = new_ports;
+                port = &ports[count++];
+                memset(port, 0, sizeof(*port));
+                port->addr = *snd_seq_port_info_get_addr(pinfo);
+                port->cap = cap;
+                port->type = type;
+                port->client_type = snd_seq_client_info_get_type(cinfo);
+                port->port_id = snd_seq_port_info_get_port(pinfo);
+                snprintf(port->client_name, sizeof(port->client_name), "%s",
+                         snd_seq_client_info_get_name(cinfo));
+                snprintf(port->port_name, sizeof(port->port_name), "%s",
+                         snd_seq_port_info_get_name(pinfo));
+                port->usb_device = set_usb_identity(cinfo, pinfo, &port->strong_identity,
+                                                    port->identity, port->interface_name);
+                if (cap & SND_SEQ_PORT_CAP_WRITE) fill_out_caps(port, cinfo, pinfo);
+                if (cap & SND_SEQ_PORT_CAP_READ) fill_in_caps(port, cinfo, pinfo);
+            }
+        }
+    }
+
+    if (data_client_ref) seq_close();
+    free(cinfo);
+    free(pinfo);
+    *ports_ret = ports;
+    *count_ret = count;
+    return TRUE;
+
+failed:
+    if (data_client_ref) seq_close();
+    free(cinfo);
+    free(pinfo);
+    free(ports);
+    return FALSE;
+}
