+static BOOL dest_key_equal(const struct midi_dest *dest, const struct observed_port *port)
+{
+    if (dest->strong_identity || port->strong_identity)
+        return dest->strong_identity && port->strong_identity && !strcmp(dest->identity, port->identity);
+    return dest->client_type == port->client_type && dest->port_id == port->port_id &&
+           !strcmp(dest->client_name, port->client_name) && !strcmp(dest->port_name, port->port_name);
+}
+
+static BOOL src_key_equal(const struct midi_src *src, const struct observed_port *port)
+{
+    if (src->strong_identity || port->strong_identity)
+        return src->strong_identity && port->strong_identity && !strcmp(src->identity, port->identity);
+    return src->client_type == port->client_type && src->port_id == port->port_id &&
+           !strcmp(src->client_name, port->client_name) && !strcmp(src->port_name, port->port_name);
+}
+
+static BOOL observed_key_equal(const struct observed_port *left, const struct observed_port *right)
+{
+    if (left->strong_identity || right->strong_identity)
+        return left->strong_identity && right->strong_identity && !strcmp(left->identity, right->identity);
+    return left->client_type == right->client_type && left->port_id == right->port_id &&
+           !strcmp(left->client_name, right->client_name) && !strcmp(left->port_name, right->port_name);
+}
+
+static void update_dest_identity(struct midi_dest *dest, const struct observed_port *port)
+{
+    dest->addr = port->addr;
+    dest->client_type = port->client_type;
+    dest->port_id = port->port_id;
+    dest->strong_identity = port->strong_identity;
+    snprintf(dest->client_name, sizeof(dest->client_name), "%s", port->client_name);
+    snprintf(dest->port_name, sizeof(dest->port_name), "%s", port->port_name);
+    snprintf(dest->identity, sizeof(dest->identity), "%s", port->identity);
+    memcpy(dest->interface_name, port->interface_name, sizeof(dest->interface_name));
+    dest->caps = port->out_caps;
+}
+
+static void update_src_identity(struct midi_src *src, const struct observed_port *port)
+{
+    src->addr = port->addr;
+    src->client_type = port->client_type;
+    src->port_id = port->port_id;
+    src->strong_identity = port->strong_identity;
+    snprintf(src->client_name, sizeof(src->client_name), "%s", port->client_name);
+    snprintf(src->port_name, sizeof(src->port_name), "%s", port->port_name);
+    snprintf(src->identity, sizeof(src->identity), "%s", port->identity);
+    memcpy(src->interface_name, port->interface_name, sizeof(src->interface_name));
+    src->caps = port->in_caps;
+}
+
+static struct midi_dest *new_dest(const struct observed_port *port)
+{
+    struct midi_dest *dest = calloc(1, sizeof(*dest));
+
+    if (!dest) return NULL;
+    dest->token = next_dest_token++;
+    dest->bEnabled = TRUE;
+    dest->online = TRUE;
+    dest->seen = TRUE;
+    dest->port_out = -1;
+    update_dest_identity(dest, port);
+    *last_dest = dest;
+    last_dest = &dest->next;
+    return dest;
+}
+
+static struct midi_src *new_src(const struct observed_port *port)
+{
+    struct midi_src *src = calloc(1, sizeof(*src));
+
+    if (!src) return NULL;
+    src->token = next_src_token++;
+    src->online = TRUE;
+    src->seen = TRUE;
+    update_src_identity(src, port);
+    *last_src = src;
+    last_src = &src->next;
+    return src;
+}
+
+static void reset_dest_after_reconnect(struct midi_dest *dest)
+{
+    unsigned int channel, controller;
+
+    if (!dest->seq || dest->port_out < 0) return;
+    for (channel = 0; channel < 16; ++channel)
+    {
+        static const unsigned char controllers[] = {MIDI_CTL_SUSTAIN, MIDI_CTL_ALL_NOTES_OFF,
+                                                     MIDI_CTL_RESET_CONTROLLERS};
+        for (controller = 0; controller < ARRAY_SIZE(controllers); ++controller)
+        {
+            snd_seq_event_t event;
+            snd_seq_ev_clear(&event);
+            snd_seq_ev_set_direct(&event);
+            snd_seq_ev_set_source(&event, dest->port_out);
+            snd_seq_ev_set_subs(&event);
+            snd_seq_ev_set_controller(&event, channel, controllers[controller], 0);
+            snd_seq_event_output_direct(dest->seq, &event);
+        }
+    }
+    dest->runningStatus = 0;
+}
+
+static void reconnect_dest(struct midi_dest *dest, snd_seq_addr_t old_addr)
+{
+    BOOL same_addr;
+    int ret;
+
+    if (!dest->midiDesc.hMidi || !dest->seq || dest->port_out < 0) return;
+    if (topology_retrying && dest->connected) return;
+    same_addr = old_addr.client == dest->addr.client && old_addr.port == dest->addr.port;
+    seq_lock();
+    if (dest->connected && !same_addr)
+        snd_seq_disconnect_to(dest->seq, dest->port_out, old_addr.client, old_addr.port);
+    ret = snd_seq_connect_to(dest->seq, dest->port_out, dest->addr.client, dest->addr.port);
+    dest->connected = ret >= 0 || ret == -EBUSY || ret == -EEXIST;
+    if (dest->connected)
+    {
+        dest->reconnect_attempts = 0;
+        if (ret >= 0) reset_dest_after_reconnect(dest);
+    }
+    else
+    {
+        if (!dest->reconnect_attempts) dest->reconnect_attempts = 8;
+        if (topology_retrying && !--dest->reconnect_attempts)
+            ERR("MidiOut '%s - %s' reconnect retries exhausted\n",
+                dest->client_name, dest->port_name);
+    }
+    seq_unlock();
+    if (ret < 0 && ret != -EBUSY && ret != -EEXIST)
+        WARN("Could not re-subscribe MidiOut '%s - %s' to %d:%d: %s\n", dest->client_name,
+             dest->port_name, dest->addr.client, dest->addr.port, snd_strerror(ret));
+}
+
+static void reconnect_src(struct midi_src *src, snd_seq_addr_t old_addr)
+{
+    BOOL same_addr;
+    int ret;
+
+    if (!src->midiDesc.hMidi || !src->seq || src->port_in < 0) return;
+    if (topology_retrying && src->connected) return;
+    same_addr = old_addr.client == src->addr.client && old_addr.port == src->addr.port;
+    seq_lock();
+    if (src->connected && !same_addr)
+        snd_seq_disconnect_from(src->seq, src->port_in, old_addr.client, old_addr.port);
+    ret = snd_seq_connect_from(src->seq, src->port_in, src->addr.client, src->addr.port);
+    src->connected = ret >= 0 || ret == -EBUSY || ret == -EEXIST;
+    if (src->connected) src->reconnect_attempts = 0;
+    else
+    {
+        if (!src->reconnect_attempts) src->reconnect_attempts = 8;
+        if (topology_retrying && !--src->reconnect_attempts)
+            ERR("MidiIn '%s - %s' reconnect retries exhausted\n",
+                src->client_name, src->port_name);
+    }
+    seq_unlock();
+    if (ret < 0 && ret != -EBUSY && ret != -EEXIST)
+        WARN("Could not re-subscribe MidiIn '%s - %s' to %d:%d: %s\n", src->client_name,
+             src->port_name, src->addr.client, src->addr.port, snd_strerror(ret));
+}
+
+static char wow64_midi_hdr_cookie;
+
+static struct required_notify_entry *register_required_notify(struct midi_src *src,
+                                                               BOOL synchronous)
+{
+    struct required_notify_entry *required = malloc(sizeof(*required));
+
+    if (!required) return NULL;
+    required->src = src;
+    required->open_generation = src->open_generation;
+    required->owner = pthread_self();
+    required->owner_valid = synchronous;
+    required->synchronous = synchronous;
+    pthread_mutex_lock(&notify_mutex);
+    required->next = required_notifies;
+    required_notifies = required;
+    pthread_mutex_unlock(&notify_mutex);
+    return required;
+}
+
+static void remove_required_notify_locked(struct required_notify_entry *required)
+{
+    struct required_notify_entry **cursor;
+
+    for (cursor = &required_notifies; *cursor; cursor = &(*cursor)->next)
+    {
+        if (*cursor != required) continue;
+        *cursor = required->next;
+        free(required);
+        pthread_cond_broadcast(&notify_done_cond);
+        return;
+    }
+}
+
+static BOOL append_pending_notify(struct pending_notify **head, struct pending_notify ***tail,
+                                  struct midi_src *src, const struct notify_context *context)
+{
+    struct pending_notify *pending = malloc(sizeof(*pending));
+    BOOL required = context->msg == MIM_LONGDATA || context->msg == MIM_LONGERROR;
+
+    if (!pending) return FALSE;
+    pending->required = required ? register_required_notify(src, FALSE) : NULL;
+    if (required && !pending->required)
+    {
+        free(pending);
+        return FALSE;
+    }
+    pending->context = *context;
+    pending->src = src;
+    pending->open_generation = src->open_generation;
+    pending->owned_header = (context->msg == MIM_LONGDATA || context->msg == MIM_LONGERROR) &&
+                            ((MIDIHDR *)context->param_1)->dwReserved[6] ==
+                            (DWORD_PTR)&wow64_midi_hdr_cookie;
+    pending->next = NULL;
+    **tail = pending;
+    *tail = &pending->next;
+    return TRUE;
+}
+
+static BOOL notify_post_current(struct midi_src *src, unsigned int generation,
+                                const struct notify_context *context, BOOL owned_header,
+                                struct required_notify_entry *required)
+{
+    for (;;)
+    {
+        BOOL valid, quit, posted = FALSE;
+
+        /* Validate and enqueue as one operation with respect to close.  Never
+         * wait for ring space while holding the topology lock. */
+        pthread_rwlock_rdlock(&topology_lock);
+        valid = (!src->closing || required) && src->midiDesc.hMidi &&
+                src->open_generation == generation;
+        pthread_mutex_lock(&notify_mutex);
+        quit = notify_quit;
+        if (valid && !quit && !notify_buffer_full())
+        {
+            notify_buffer_add(context, src, generation, owned_header, required);
+            pthread_cond_signal(&notify_read_cond);
+            posted = TRUE;
+        }
+        /* Keep notify_mutex across the topology unlock so close cannot signal
+         * between our full check and the atomic condition wait below. */
+        pthread_rwlock_unlock(&topology_lock);
+        if (valid && !quit && !posted && notify_buffer_full())
+            pthread_cond_wait(&notify_write_cond, &notify_mutex);
+        pthread_mutex_unlock(&notify_mutex);
+        if (!valid || quit || posted) return posted;
+    }
+}
+
+static BOOL required_notify_pending_other(struct midi_src *src, unsigned int generation,
+                                          pthread_t self)
+{
+    struct required_notify_entry *entry;
+
+    for (entry = required_notifies; entry; entry = entry->next)
+        if (entry->src == src && entry->open_generation == generation &&
+            (!entry->owner_valid || !pthread_equal(entry->owner, self)))
+            return TRUE;
+    return FALSE;
+}
+
+static void notify_cancel_source(struct midi_src *src, unsigned int generation)
+{
+    struct notify_entry kept[NOTIFY_BUFFER_SIZE], entry;
+    unsigned int count = 0, i;
+    pthread_t self = pthread_self();
+
+    pthread_mutex_lock(&notify_mutex);
+    while (notify_buffer_remove(&entry))
+    {
+        if (entry.src == src && entry.open_generation == generation && !entry.required)
+        {
+            if (entry.owned_header) free((void *)entry.context.param_1);
+        }
+        else kept[count++] = entry;
+    }
+    for (i = 0; i < count; ++i)
+        notify_buffer_add(&kept[i].context, kept[i].src, kept[i].open_generation,
+                          kept[i].owned_header, kept[i].required);
+    pthread_cond_broadcast(&notify_write_cond);
+
+    /* notify_wait marks a callback in flight until the notification thread
+     * calls it again.  A close from that callback is already ordered after
+     * the callback, so only another thread must wait for the acknowledgement. */
+    while ((notify_inflight && notify_inflight_src == src &&
+           notify_inflight_generation == generation &&
+            (!notify_thread_known || !pthread_equal(self, notify_thread_id))) ||
+           required_notify_pending_other(src, generation, self))
+        pthread_cond_wait(&notify_done_cond, &notify_mutex);
+    pthread_mutex_unlock(&notify_mutex);
+}
+
+static void post_pending_notifies(struct pending_notify *pending)
+{
+    struct pending_notify *next;
+
+    while (pending)
+    {
+        BOOL posted;
+
+        next = pending->next;
+        posted = notify_post_current(pending->src, pending->open_generation, &pending->context,
+                                     pending->owned_header, pending->required);
+        if (!posted && pending->required)
+        {
+            pthread_mutex_lock(&notify_mutex);
+            remove_required_notify_locked(pending->required);
+            pthread_mutex_unlock(&notify_mutex);
+        }
+        if (!posted && pending->owned_header) free((void *)pending->context.param_1);
+        free(pending);
+        pending = next;
+    }
+}
+
+static void cleanup_disconnected_src(struct midi_src *src, struct pending_notify **head,
+                                     struct pending_notify ***tail)
+{
+    struct notify_context notify;
+    unsigned int channel, note;
+    UINT current_time = get_time_msec() - src->startTime;
+    MIDIHDR *hdr;
+
+    if (!src->midiDesc.hMidi) return;
+    for (channel = 0; channel < 16; ++channel)
+    {
+        if (src->sustain[channel])
+        {
+            set_in_notify(&notify, src, src->open_dev_id, MIM_DATA,
+                          (MIDI_CTL_SUSTAIN << 8) | MIDI_CMD_CONTROL | channel, current_time);
+            append_pending_notify(head, tail, src, &notify);
+        }
+        for (note = 0; note < 128; ++note)
+        {
+            if (!(src->active_notes[channel][note / 64] & ((uint64_t)1 << (note % 64)))) continue;
+            set_in_notify(&notify, src, src->open_dev_id, MIM_DATA,
+                          (note << 8) | MIDI_CMD_NOTE_OFF | channel, current_time);
+            append_pending_notify(head, tail, src, &notify);
+        }
+    }
+    memset(src->active_notes, 0, sizeof(src->active_notes));
+    memset(src->sustain, 0, sizeof(src->sustain));
+
+    in_buffer_lock();
+    hdr = src->lpQueueHdr;
+    if (hdr && hdr->dwBytesRecorded)
+    {
+        set_in_notify(&notify, src, src->open_dev_id, MIM_LONGERROR, (DWORD_PTR)hdr, current_time);
+        if (append_pending_notify(head, tail, src, &notify))
+        {
+            src->lpQueueHdr = hdr->lpNext;
+            hdr->dwFlags &= ~MHDR_INQUEUE;
+            hdr->dwFlags |= MHDR_DONE;
+        }
+    }
+    in_buffer_unlock();
+}
+
+static BOOL publish_snapshots(void)
+{
+    struct midi_dest *dest;
+    struct midi_src *src;
+    struct midi_dest **new_dests = NULL;
+    struct midi_src **new_srcs = NULL;
+    unsigned int dest_count = 0, src_count = 0, i;
+
+    for (dest = all_dests; dest; dest = dest->next) if (dest->online) ++dest_count;
+    for (src = all_srcs; src; src = src->next) if (src->online) ++src_count;
+    if (dest_count && !(new_dests = malloc(dest_count * sizeof(*new_dests)))) return FALSE;
+    if (src_count && !(new_srcs = malloc(src_count * sizeof(*new_srcs))))
+    {
+        free(new_dests);
+        return FALSE;
+    }
+    for (dest = all_dests, i = 0; dest; dest = dest->next) if (dest->online) new_dests[i++] = dest;
+    for (src = all_srcs, i = 0; src; src = src->next) if (src->online) new_srcs[i++] = src;
+    free(dests);
+    free(srcs);
+    dests = new_dests;
+    srcs = new_srcs;
+    num_dests = dest_count;
+    num_srcs = src_count;
+    return TRUE;
+}
+
+/* Preserve the disconnect edge even when ALSA reuses the same address before
+ * the debounce window closes.  Otherwise held notes and a partial SysEx could
+ * leak into the next physical session. */
+static void mark_port_offline(snd_seq_addr_t addr)
+{
+    struct pending_notify *pending = NULL, **pending_tail = &pending;
+    struct midi_dest *dest;
+    struct midi_src *src;
+    BOOL changed = FALSE, published = FALSE;
+
+    pthread_rwlock_wrlock(&topology_lock);
+    for (dest = all_dests; dest; dest = dest->next)
+        if (dest->online && dest->addr.client == addr.client && dest->addr.port == addr.port)
+        {
+            dest->online = dest->connected = FALSE;
+            dest->reconnect_attempts = 0;
+            dest->runningStatus = 0;
+            changed = TRUE;
+        }
+    for (src = all_srcs; src; src = src->next)
+        if (src->online && src->addr.client == addr.client && src->addr.port == addr.port)
+        {
+            src->online = src->connected = FALSE;
+            src->reconnect_attempts = 0;
+            cleanup_disconnected_src(src, &pending, &pending_tail);
+            changed = TRUE;
+        }
+    if (changed)
+    {
+        snapshot_dirty = TRUE;
+        if (!(published = publish_snapshots())) ERR("Out of memory publishing MIDI disconnect\n");
+    }
+    pthread_rwlock_unlock(&topology_lock);
+
+    if (published)
+    {
+        struct notify_context notify;
+        set_device_change_notify(&notify);
+        notify_post(&notify);
+    }
+    post_pending_notifies(pending);
+}
+
+static BOOL reconcile_ports(struct observed_port *ports, unsigned int count)
+{
+    struct pending_notify *pending = NULL, **pending_tail = &pending;
+    struct midi_dest *dest;
+    struct midi_src *src;
+    BOOL changed = FALSE;
+    unsigned int i, j;
+
+    pthread_rwlock_wrlock(&topology_lock);
+    for (dest = all_dests; dest; dest = dest->next) dest->seen = FALSE;
+    for (src = all_srcs; src; src = src->next) src->seen = FALSE;
+
+    /* An ALSA address is only an optimization, never an identity.  It may be
+     * reused for unrelated clients.  Reuse it only when the hardware/weak key
+     * also agrees; this keeps duplicate controllers stable at a fixed address. */
+    for (i = 0; i < count; ++i)
+    {
+        if (ports[i].cap & SND_SEQ_PORT_CAP_WRITE)
+            for (dest = all_dests; dest; dest = dest->next)
+                if (!dest->seen && dest->addr.client == ports[i].addr.client &&
+                    dest->addr.port == ports[i].addr.port && dest_key_equal(dest, &ports[i]))
