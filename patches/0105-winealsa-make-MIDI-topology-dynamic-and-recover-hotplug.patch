+
+static BOOL sysfs_read_hex(const char *dir, const char *file, unsigned int *value)
+{
+    char path[PATH_MAX];
+    FILE *stream;
+    int ret;
+
+    if (snprintf(path, sizeof(path), "%s/%s", dir, file) >= sizeof(path)) return FALSE;
+    if (!(stream = fopen(path, "r"))) return FALSE;
+    ret = fscanf(stream, "%x", value);
+    fclose(stream);
+    return ret == 1;
+}
+
+static BOOL sysfs_read_text(const char *dir, const char *file, char *value, size_t size)
+{
+    char path[PATH_MAX], *newline;
+    FILE *stream;
+
+    if (snprintf(path, sizeof(path), "%s/%s", dir, file) >= sizeof(path)) return FALSE;
+    if (!(stream = fopen(path, "r"))) return FALSE;
+    if (!fgets(value, size, stream)) value[0] = 0;
+    fclose(stream);
+    if ((newline = strpbrk(value, "\r\n"))) *newline = 0;
+    return !!value[0];
+}
+
+static int usb_midi_interface(const char *device_dir)
+{
+    struct dirent *entry;
+    DIR *dir;
+    int number = -1, count = 0;
+
+    if (!(dir = opendir(device_dir))) return -1;
+    while ((entry = readdir(dir)))
+    {
+        unsigned int iface_class, iface_subclass, iface_number;
+        char path[PATH_MAX];
+
+        if (!strchr(entry->d_name, ':')) continue;
+        if (snprintf(path, sizeof(path), "%s/%s", device_dir, entry->d_name) >= sizeof(path)) continue;
+        if (!sysfs_read_hex(path, "bInterfaceClass", &iface_class) || iface_class != 0x01) continue;
+        if (!sysfs_read_hex(path, "bInterfaceSubClass", &iface_subclass) || iface_subclass != 0x03) continue;
+        if (!sysfs_read_hex(path, "bInterfaceNumber", &iface_number)) continue;
+        number = iface_number;
+        if (++count > 1)
+        {
+            number = -1;
+            break;
+        }
+    }
+    closedir(dir);
+    return number;
+}
+
+static BOOL get_usb_card_info(int card, struct usb_card_info *info)
+{
+    char link[64], resolved[PATH_MAX];
+
+    memset(info, 0, sizeof(*info));
+    info->midi_iface = -1;
+    if (card < 0) return FALSE;
+    snprintf(link, sizeof(link), "/sys/class/sound/card%d/device", card);
+    if (!realpath(link, resolved)) return FALSE;
+
+    for (;;)
+    {
+        char *slash;
+        unsigned int iface_class, iface_subclass, iface_number;
+
+        /* cardN/device normally resolves below the exact USB interface.  Keep
+         * that interface while walking up to the parent USB device. */
+        if (info->midi_iface < 0 &&
+            sysfs_read_hex(resolved, "bInterfaceClass", &iface_class) && iface_class == 0x01 &&
+            sysfs_read_hex(resolved, "bInterfaceSubClass", &iface_subclass) && iface_subclass == 0x03 &&
+            sysfs_read_hex(resolved, "bInterfaceNumber", &iface_number))
+            info->midi_iface = iface_number;
+
+        if (sysfs_read_hex(resolved, "idVendor", &info->vid) &&
+            sysfs_read_hex(resolved, "idProduct", &info->pid))
+        {
+            snprintf(info->path, sizeof(info->path), "%s", resolved);
+            sysfs_read_text(resolved, "serial", info->serial, sizeof(info->serial));
+            if (info->midi_iface < 0) info->midi_iface = usb_midi_interface(resolved);
+            return TRUE;
+        }
+        if (!(slash = strrchr(resolved, '/')) || slash == resolved) break;
+        *slash = 0;
+    }
+    return FALSE;
+}
+
+static void sanitize_interface_component(const char *src, char *dst, size_t size)
+{
+    char *out = dst, *end = dst + size - 1;
+
+    while (*src && out < end)
+    {
+        unsigned char ch = *src++;
+        *out++ = isalnum(ch) ? tolower(ch) : '_';
+    }
+    *out = 0;
+}
+
+static BOOL set_usb_identity(snd_seq_client_info_t *cinfo, snd_seq_port_info_t *pinfo,
+                             BOOL *strong_identity,
+                             char identity[MIDI_IDENTITY_LEN],
+                             WCHAR interface_name[MIDI_INTERFACE_LEN])
+{
+    struct usb_card_info info;
+    char interface_path[MIDI_INTERFACE_LEN], instance[128];
+    const char *path_component;
+    int len, port = snd_seq_port_info_get_port(pinfo);
+
+    identity[0] = 0;
+    interface_name[0] = 0;
+    *strong_identity = FALSE;
+    if (!get_usb_card_info(snd_seq_client_info_get_card(cinfo), &info)) return FALSE;
+
+    if (info.serial[0])
+        len = snprintf(identity, MIDI_IDENTITY_LEN, "usb:%04x:%04x:serial:%s:interface:%02x:port:%d",
+                       info.vid, info.pid, info.serial, info.midi_iface, port);
+    else
+        len = snprintf(identity, MIDI_IDENTITY_LEN, "usb:%04x:%04x:path:%s:interface:%02x:port:%d",
+                       info.vid, info.pid, info.path, info.midi_iface, port);
+    if (len < 0 || len >= MIDI_IDENTITY_LEN)
+    {
+        identity[0] = 0;
+        return FALSE;
+    }
+
+    path_component = info.serial[0] ? info.serial : strrchr(info.path, '/');
+    if (!info.serial[0] && path_component) ++path_component;
+    if (!path_component) path_component = info.path;
+    sanitize_interface_component(path_component, instance, sizeof(instance));
+    if (info.midi_iface >= 0)
+        len = snprintf(interface_path, sizeof(interface_path),
+                       "\\\\?\\usb#vid_%04x&pid_%04x&mi_%02x#%s&port%d#%s",
+                       info.vid, info.pid, info.midi_iface, instance, port, midi_ks_category);
+    else
+        len = snprintf(interface_path, sizeof(interface_path),
+                       "\\\\?\\usb#vid_%04x&pid_%04x#%s&port%d#%s",
+                       info.vid, info.pid, instance, port, midi_ks_category);
+    if (len >= 0 && len < sizeof(interface_path))
+        ntdll_umbstowcs(interface_path, len + 1, interface_name, MIDI_INTERFACE_LEN);
+    *strong_identity = info.midi_iface >= 0;
+    return TRUE;
+}
