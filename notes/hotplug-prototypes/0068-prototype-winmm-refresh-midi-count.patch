Subject: [PROTOTYPE ONLY] winmm: re-ask the drivers for the MIDI device count

MMDRV_InitPerType() takes the device count once, at first use, and
stores it in llTypes[type].wMaxId. Nothing raises it afterwards, so a
MIDI device that appears later could never be reported by
midiInGetNumDevs() and MMDRV_Message() would reject its id even if the
driver knew about it.

Re-query the loaded drivers from MMDRV_GetNum() for the two MIDI types.
Only growth at the end of the id space is adopted: renumbering an
existing id would invalidate the WINE_MLD that MMDRV_GetByID() already
handed out for an open device, and a device going away is left in place
for the same reason. The translation table is allocated with room to
grow for the same reason the driver tables are, so the refresh never
moves it, and only slots above the previous count are initialised.
---
 dlls/winmm/lolvldrv.c | 110 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 102 insertions(+), 8 deletions(-)

diff --git a/dlls/winmm/lolvldrv.c b/dlls/winmm/lolvldrv.c
index b0283e7db8..2bbbf86378 100644
--- a/dlls/winmm/lolvldrv.c
+++ b/dlls/winmm/lolvldrv.c
@@ -42,25 +42,32 @@ typedef struct tagWINE_LLTYPE {
     LPCSTR		typestr;	/* name (for debugging) */
     /* those attributes reflect the loaded/current situation for the type */
     UINT		wMaxId;		/* number of loaded devices (sum across all loaded drivers) */
+    UINT		wCapacity;	/* slots allocated in lpMlds, >= wMaxId */
     LPWINE_MLD		lpMlds;		/* "static" mlds to access the part though device IDs */
     int			nMapper;	/* index to mapper */
 } WINE_LLTYPE;

 static WINE_LLTYPE llTypes[MMDRV_MAX] = {
-    { "Aux", 0, 0, -1 },
-    { "Mixer", 0, 0, -1 },
-    { "MidiIn", 0, 0, -1 },
-    { "MidiOut", 0, 0, -1 },
-    { "WaveIn", 0, 0, -1 },
-    { "WaveOut", 0, 0, -1 }
+    { "Aux", 0, 0, 0, -1 },
+    { "Mixer", 0, 0, 0, -1 },
+    { "MidiIn", 0, 0, 0, -1 },
+    { "MidiOut", 0, 0, 0, -1 },
+    { "WaveIn", 0, 0, 0, -1 },
+    { "WaveOut", 0, 0, 0, -1 }
 };

+/* Slots kept past the startup count so a MIDI device that appears later can be
+ * addressed without reallocating lpMlds: MMDRV_Get() hands out pointers into
+ * that array and holds them for the lifetime of an open device. */
+#define MMDRV_RUNTIME_SLOTS 32
+
 static BOOL drivers_loaded;
 static int MMDrvsHi;
 static WINE_MM_DRIVER	MMDrvs[8];
 static LPWINE_MLD	MM_MLDrvs[40];

 static void MMDRV_Init(void);
+static void MMDRV_RefreshType(UINT type);

 static void MMDRV_InitSingleType(UINT type) {
     if (!drivers_loaded) {
@@ -77,6 +84,11 @@ UINT	MMDRV_GetNum(UINT type)
     TRACE("(%04x)\n", type);
     assert(type < MMDRV_MAX);
     MMDRV_InitSingleType(type);
+    /* MIDI devices can arrive after this process started, so the count taken
+     * at init is not final.  Asking here costs one driver round trip on a path
+     * only walked when an application enumerates. */
+    if (type == MMDRV_MIDIIN || type == MMDRV_MIDIOUT)
+        MMDRV_RefreshType(type);
     return llTypes[type].wMaxId;
 }

@@ -366,10 +378,11 @@ static  BOOL	MMDRV_InitPerType(LPWINE_MM_DRIVER lpDrv, UINT type, UINT wMsg)
     TRACE("Setting min=%d max=%d (ttop=%d) for (%s:%s)\n",
 	  part->nIDMin, part->nIDMax, llTypes[type].wMaxId,
 	  lpDrv->drvname, llTypes[type].typestr);
-    /* realloc translation table */
+    /* realloc translation table, with room for later arrivals */
     mem = llTypes[type].lpMlds ? llTypes[type].lpMlds - 1 : NULL;
-    mem = realloc(mem, sizeof(WINE_MLD) * (llTypes[type].wMaxId + 1));
+    mem = realloc(mem, sizeof(WINE_MLD) * (llTypes[type].wMaxId + 1 + MMDRV_RUNTIME_SLOTS));
     llTypes[type].lpMlds = mem + 1;
+    llTypes[type].wCapacity = llTypes[type].wMaxId + MMDRV_RUNTIME_SLOTS;

     /* re-build the translation table */
     if (lpDrv->bIsMapper) {
@@ -392,6 +405,87 @@ static  BOOL	MMDRV_InitPerType(LPWINE_MM_DRIVER lpDrv, UINT type, UINT wMsg)
     return TRUE;
 }

+/**************************************************************************
+ * 				MMDRV_RefreshType		[internal]
+ *
+ * Re-ask the loaded drivers how many devices of this type they have now.
+ * MMDRV_InitPerType() fixes the count at first use, so without this a device
+ * that appears later can never be reported and MMDRV_Message() would reject
+ * its id.
+ *
+ * Only growth at the end of the id space is adopted.  Renumbering an existing
+ * id would invalidate the WINE_MLD that MMDRV_GetByID() already handed out for
+ * an open device, and a device going away is left in place for the same
+ * reason, so ids stay stable for as long as anything might hold one.
+ */
+static void MMDRV_RefreshType(UINT type)
+{
+    UINT wMsg = (type == MMDRV_MIDIIN) ? MIDM_GETNUMDEVS : MODM_GETNUMDEVS;
+    UINT counts[ARRAY_SIZE(MMDrvs)];
+    UINT total = 0, k;
+    int i;
+
+    for (i = 0; i < MMDrvsHi; i++) {
+	WINE_MM_DRIVER_PART *part = &MMDrvs[i].parts[type];
+	UINT count;
+
+	counts[i] = 0;
+	if (MMDrvs[i].bIsMapper || !part->fnMessage32) continue;
+
+	count = part->fnMessage32(0, wMsg, 0L, 0L, 0L);
+	/* a failed query or a shrunk list keeps what we already published */
+	if (HIWORD(count) || count < (UINT)(part->nIDMax - part->nIDMin))
+	    count = part->nIDMax - part->nIDMin;
+	counts[i] = count;
+    }
+
+    /* Verify nothing already published would move before committing. */
+    for (i = 0; i < MMDrvsHi; i++) {
+	WINE_MM_DRIVER_PART *part = &MMDrvs[i].parts[type];
+
+	if (MMDrvs[i].bIsMapper || !part->fnMessage32) continue;
+	if ((UINT)part->nIDMin != total) {
+	    WARN("%s: %s would renumber existing ids, not refreshing\n",
+		 llTypes[type].typestr, MMDrvs[i].drvname);
+	    return;
+	}
+	total += counts[i];
+    }
+
+    if (total <= llTypes[type].wMaxId) return;
+
+    if (total > llTypes[type].wCapacity) {
+	WARN("%s: %u devices exceeds the %u slots reserved at init, capping\n",
+	     llTypes[type].typestr, total, llTypes[type].wCapacity);
+	total = llTypes[type].wCapacity;
+    }
+
+    for (i = 0; i < MMDrvsHi; i++) {
+	WINE_MM_DRIVER_PART *part = &MMDrvs[i].parts[type];
+
+	if (MMDrvs[i].bIsMapper || !part->fnMessage32) continue;
+	part->nIDMax = part->nIDMin + counts[i];
+    }
+
+    /* Fill only the new slots: the ones below wMaxId carry dwDriverInstance
+     * for devices that are open right now. */
+    for (k = llTypes[type].wMaxId; k < total; k++) {
+	for (i = 0; i < MMDrvsHi; i++) {
+	    if ((UINT)MMDrvs[i].parts[type].nIDMin <= k && k < (UINT)MMDrvs[i].parts[type].nIDMax) {
+		TRACE("%s:Trans[%d] -> %s\n", llTypes[type].typestr, k, MMDrvs[i].drvname);
+		llTypes[type].lpMlds[k].uDeviceID = k;
+		llTypes[type].lpMlds[k].type = type;
+		llTypes[type].lpMlds[k].mmdIndex = i;
+		llTypes[type].lpMlds[k].dwDriverInstance = 0;
+		break;
+	    }
+	}
+    }
+
+    TRACE("%s: %d -> %u devices\n", llTypes[type].typestr, llTypes[type].wMaxId, total);
+    llTypes[type].wMaxId = total;
+}
+
 /**************************************************************************
  * 				MMDRV_Install			[internal]
  */
