+                     snd_seq_client_info_get_client(cinfo), snd_seq_port_info_get_port(pinfo));
+                return;
+            }
+            dests = realloc( dests, (num_dests + 1) * sizeof(*dests) );
+            cap_dests = num_dests + 1;
+        }
         dest = dests + num_dests;
         memset( dest, 0, sizeof(*dest) );
         dest->addr = *snd_seq_port_info_get_addr(pinfo);
@@ -379,7 +446,9 @@ static void port_add(snd_seq_client_info_t* cinfo, snd_seq_port_info_t* pinfo, u
