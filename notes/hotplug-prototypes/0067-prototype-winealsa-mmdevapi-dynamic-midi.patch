+/* Slots held in reserve past the startup enumeration so a device that appears
+ * later can be added without reallocating the tables.  Callers all over this
+ * file hold a struct midi_dest/midi_src pointer across the sequencer lock, so
+ * a realloc that moved the block would leave them dangling.  Once
+ * table_frozen is set the tables never move again and a runtime add either
+ * fits in the reserve or is refused. */
+#define MIDI_RUNTIME_SLOTS 32
+static unsigned int cap_dests, cap_srcs;
+static BOOL table_frozen;
 static snd_seq_t *midi_seq;
