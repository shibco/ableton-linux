                     notify->instance, notify->param_1, notify->param_2 );
 }

+/* The MIDI device list changed under us. Ask every top-level window in the
+ * session to re-enumerate, the way the PnP manager does on Windows when the
+ * device tree changes. DBT_DEVNODES_CHANGED is the only device-change
+ * notification that can be broadcast as-is: it needs no registration and its
+ * lparam is 0, where an interface arrival would carry a pointer that has to
+ * be valid in the receiving process. */
+static void notify_device_change(void)
+{
+    DWORD recipients = BSM_APPLICATIONS;
+
+    TRACE( "broadcasting DBT_DEVNODES_CHANGED\n" );
+    BroadcastSystemMessageW( BSF_POSTMESSAGE, &recipients, WM_DEVICECHANGE,
+                             DBT_DEVNODES_CHANGED, 0 );
+}
+
 static DWORD WINAPI notify_thread( void *p )
 {
     struct midi_notify_wait_params params;
@@ -365,7 +382,9 @@ static DWORD WINAPI notify_thread( void *p )
     {
         MIDI_CALL( midi_notify_wait, &params );
         if (quit) break;
-        if (notify.send_notify) notify_client(&notify);
+        if (!notify.send_notify) continue;
+        if (notify.device_change) notify_device_change();
+        else notify_client(&notify);
     }
     return 0;
 }
