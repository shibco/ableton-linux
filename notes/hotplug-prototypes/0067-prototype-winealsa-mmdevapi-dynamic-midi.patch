+/* Tell the PE side the device list moved.  It rides the existing notify
+ * thread rather than a new one, and carries no callback: mmdevapi turns it
+ * into a WM_DEVICECHANGE broadcast instead of a DriverCallback. */
+static void notify_device_change(void)
+{
+    struct notify_context notify;
+
+    memset(&notify, 0, sizeof(notify));
+    notify.send_notify = TRUE;
+    notify.device_change = TRUE;
+    notify_post(&notify);
+}
