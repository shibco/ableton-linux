+ * still the only thread touching them. */
+static void midi_tables_freeze(void)
+{
+    struct midi_dest *new_dests = realloc( dests, (num_dests + MIDI_RUNTIME_SLOTS) * sizeof(*dests) );
+    struct midi_src *new_srcs = realloc( srcs, (num_srcs + MIDI_RUNTIME_SLOTS) * sizeof(*srcs) );
+
+    if (new_dests)
+    {
+        dests = new_dests;
+        cap_dests = num_dests + MIDI_RUNTIME_SLOTS;
+        memset( dests + num_dests, 0, MIDI_RUNTIME_SLOTS * sizeof(*dests) );
+    }
+    else cap_dests = num_dests;
+
+    if (new_srcs)
+    {
+        srcs = new_srcs;
+        cap_srcs = num_srcs + MIDI_RUNTIME_SLOTS;
+        memset( srcs + num_srcs, 0, MIDI_RUNTIME_SLOTS * sizeof(*srcs) );
+    }
+    else cap_srcs = num_srcs;
+
+    table_frozen = TRUE;
+    TRACE("tables frozen: %u/%u MidiOut, %u/%u MidiIn\n",
+          num_dests, cap_dests, num_srcs, cap_srcs);
+}
+
+/* want restricts which directions may be added, so a hotplug re-attach that
