               snd_seq_client_info_get_name(cinfo),
@@ -325,7 +382,17 @@ static void port_add(snd_seq_client_info_t* cinfo, snd_seq_port_info_t* pinfo, u
         if (!type)
             return;

-        dests = realloc( dests, (num_dests + 1) * sizeof(*dests) );
+        if (num_dests >= cap_dests)
