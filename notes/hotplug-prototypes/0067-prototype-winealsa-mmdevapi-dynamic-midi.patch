+/* A port went away.  The entry stays in the table so its device id stays
+ * stable and handle_port_start() can re-match it by name when it comes back,
+ * which is what patch 0028 relies on; only the address is invalidated so
+ * nothing is sent to a dead port in the meantime. */
+static void handle_port_exit(snd_seq_addr_t addr)
+{
+    struct midi_dest *dest;
+    struct midi_src *src;
+
+    for (src = srcs; src < srcs + num_srcs; src++)
+    {
+        if (src->addr.client != addr.client || src->addr.port != addr.port) continue;
+        TRACE("MidiIn %u went away from %d:%d\n",
+              (unsigned int)(src - srcs), addr.client, addr.port);
+        src->addr.client = SND_SEQ_ADDRESS_UNKNOWN;
+    }
+    for (dest = dests; dest < dests + num_dests; dest++)
+    {
+        if (dest->addr.client != addr.client || dest->addr.port != addr.port) continue;
+        TRACE("MidiOut %u went away from %d:%d\n",
+              (unsigned int)(dest - dests), addr.client, addr.port);
+        dest->addr.client = SND_SEQ_ADDRESS_UNKNOWN;
+    }
+}
+
